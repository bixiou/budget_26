d');}\n\t\t});\n\t});\n});","DataExportTag":"group_defended_world","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Imaginez qu'il y ait des \u00e9lections mondiales. Quel groupe d\u00e9fendriez-vous lors de ces \u00e9lections ?","Choices":{"1":{"Display":"Les \u00eatres sentients (humains et animaux)"},"2":{"Display":"Les humains"},"3":{"Display":"Les Fran\u00e7ais"},"4":{"Display":"Les personnes de ma communaut\u00e9 (par exemple ma r\u00e9gion, ma religion, mon genre...)"},"8":{"Display":"Ma famille et moi-m\u00eame"}},"ChoiceOrder":["1","2","3","4","8"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":{"FR":{"QuestionText":"Imaginez qu'il y ait des \u00e9lections mondiales.\u00a0Quel groupe d\u00e9fendriez-vous lors de ces \u00e9lections ?","Choices":{"1":{"Display":"Les \u00eatres sentients (humains et animaux)"},"2":{"Display":"Les humains"},"3":{"Display":"Les <span class=\"nationality\">Fran\u00e7ais<\/span>"},"4":{"Display":"Les personnes de ma communaut\u00e9 (par exemple ma r\u00e9gion, ma religion, mon genre...)"},"8":{"Display":"Ma famille et moi-m\u00eame"}}}},"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID168"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID169","SecondaryAttribute":"Qui devrait h\u00e9riter d'une soci\u00e9t\u00e9 qui vaut 10 milliards d'euros lors du d\u00e9c\u00e8s de son actionnair","TertiaryAttribute":null,"Payload":{"QuestionText":"Qui devrait h\u00e9riter d'une soci\u00e9t\u00e9 qui vaut 10 milliards d'euros lors du d\u00e9c\u00e8s de son actionnaire unique&nbsp;?&nbsp;<br>Veuillez renseigner votre r\u00e9partition pr\u00e9f\u00e9r\u00e9e entre les diff\u00e9rentes options ci-dessous : <b>le total doit faire 100&nbsp;%<\/b>.<br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\tQualtrics.SurveyEngine.