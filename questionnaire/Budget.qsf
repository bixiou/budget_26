:\/\/Field\/F-1-1-2}<\/td>\n<td style=\"text-align: center;\">${e:\/\/Field\/F-1-2-2}<\/td>\n<td style=\"text-align: center;\"><strong>${e:\/\/Field\/F-1-2}<\/strong><\/td>\n<\/tr><tr>\n<td style=\"text-align: center;\">${e:\/\/Field\/F-1-1-3}<\/td>\n<td style=\"text-align: center;\">${e:\/\/Field\/F-1-2-3}<\/td>\n<td style=\"text-align: center;\"><strong>${e:\/\/Field\/F-1-3}<\/strong><\/td>\n<\/tr><tr>\n<td style=\"text-align: center;\">${e:\/\/Field\/F-1-1-4}<\/td>\n<td style=\"text-align: center;\">${e:\/\/Field\/F-1-2-4}<\/td>\n<td style=\"text-align: center;\"><strong>${e:\/\/Field\/F-1-4}<\/strong><\/td>\n<\/tr><tr>\n<td style=\"text-align: center;\">${e:\/\/Field\/F-1-1-5}<\/td>\n<td style=\"text-align: center;\">${e:\/\/Field\/F-1-2-5}<\/td>\n<td style=\"text-align: center;\"><strong>${e:\/\/Field\/F-1-5}<\/strong><\/td>\n<\/tr><\/tbody>\n<\/table>\n<\/div>","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">country<\/span> <span class=\"OpDesc\">Is Not Equal to<\/span> <span class=\"RightOpDesc\"> SA <\/span>","LeftOperand":"country","LogicType":"EmbeddedField","Operator":"NotEqualTo","RightOperand":"SA","Type":"Expression"},"1":{"Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"LeftOpDesc\">country<\/span> <span class=\"OpDesc\">Is Not Equal to<\/span> <span class=\"RightOpDesc\"> RU <\/span>","LeftOperand":"country","LogicType":"EmbeddedField","Operator":"NotEqualTo","RightOperand":"RU","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID84","SecondaryAttribute":"Imagine that a Left or Center-left coalition wins the next elections. Here are two possible platf...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2"],"Choices":{"1":{"Display":"Candidate A"},"2":{"Display":"Candidate B"}},"Configuration":{"LabelPosition":"BELOW","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q48","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":{"DE":{"Choices":{"1":{"Display":"Programm A"},"2":{"Display":"Programm B"}},"QuestionText":"<span>Stellen Sie sich vor, eine rot-gr\u00fcne oder rot-rot-gr\u00fcne Koalition gewinnt die n\u00e4chsten Bundestagswahlen im Jahr 2025. Hier sind zwei m\u00f6gliche Wahlprogramme, mit denen die Parteien dieser Koalition in den Wahlkampf ziehen k\u00f6nnte (die Politikma\u00dfnahmen in jedem Programm werden nach dem Zufallsprinzip aus einer Menge von denkbaren Politiken der linken Parteien ausgew\u00e4hlt).<br \/>\n<br \/>\nSelbst wenn Sie die linken Parteien nicht unterst\u00fctzen, welche dieser <\/span>Programme <span>bevorzugen Sie?<\/span>\n<div>\u00a0\n<table class=\"UserTable\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\u00a0<\/td>\n\t\t\t<td style=\"text-align: center;\"><strong>Programm A<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\"><strong>Programm B<\/strong><\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>${e:\/\/Field\/D-1-1}<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-1-1}<\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-2-1}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>${e:\/\/Field\/D-1-2}<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-1-2}<\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-2-2}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>${e:\/\/Field\/D-1-3}<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-1-3}<\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-2-3}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>${e:\/\/Field\/D-1-4}<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-1-4}<\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-2-4}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>Au\u00dfenpolitik<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">Globales Klimaprogramm<\/td>\n\t\t\t<td style=\"text-align: center;\">-<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n"},"EN-GB":{"Choices":{"1":{"Display":"Platform A"},"2":{"Display":"Platform B"}},"QuestionText":"<span>Imagine that the Labour Party wins the next general elections. Here are two possible platforms on which it may campaign (the policies in each platform are randomly drawn from a pool of credible Labour policies).<br \/>\n<br \/>\nEven if you do not support the Labour Party, which of these platforms do you prefer?<\/span>\n<div>\u00a0\n<table class=\"UserTable\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\u00a0<\/td>\n\t\t\t<td style=\"text-align: center;\"><strong>Platform A<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\"><strong>Platform B<\/strong><\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>${e:\/\/Field\/D-1-1}<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-1-1}<\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-2-1}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>${e:\/\/Field\/D-1-2}<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-1-2}<\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-2-2}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>${e:\/\/Field\/D-1-3}<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-1-3}<\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-2-3}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>${e:\/\/Field\/D-1-4}<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-1-4}<\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-2-4}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>Foreign policy<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">Global climate scheme<\/td>\n\t\t\t<td style=\"text-align: center;\">-<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n"},"ES-ES":{"Choices":{"1":{"Display":"Programa A"},"2":{"Display":"Programa B"}},"QuestionText":"<span>Imagine que el PSOE gana las pr\u00f3ximas elecciones generales. He aqu\u00ed dos posibles programas sobre los que podr\u00eda hacer campa\u00f1a (las pol\u00edticas de cada programa se extraen aleatoriamente de un conjunto de pol\u00edticas cre\u00edbles del PSOE).<br \/>\n<br \/>\nAunque usted no apoye al PSOE, \u00bf<\/span>cu\u00e1l de estos programas preferir\u00eda<span>?<\/span>\n<div>\n<table class=\"UserTable\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\u00a0<\/td>\n\t\t\t<td style=\"text-align: center;\"><strong>Programa A<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\"><strong>Programa B<\/strong><\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>${e:\/\/Field\/D-1-1}<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-1-1}<\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-2-1}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>${e:\/\/Field\/D-1-2}<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-1-2}<\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-2-2}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>${e:\/\/Field\/D-1-3}<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-1-3}<\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/Field\/D-1-2-3}<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>${e:\/\/Field\/D-1-4}<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\">${e:\/\/F