","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\tQualtrics.SurveyEngine.setEmbeddedData(\"time_custom_redistr\", Date.now()\/1000);\n\tconst time_before = Qualtrics.SurveyEngine.getEmbeddedData(\"time_comprehension\");\n\tQualtrics.SurveyEngine.setEmbeddedData(\"duration_custom_redistr\", Date.now()\/1000 - time_before);\n\tconst time_start = Qualtrics.SurveyEngine.getEmbeddedData(\"time_start\");\n\tQualtrics.SurveyEngine.setEmbeddedData(\"duration_main_questions\", Date.now()\/1000 - time_start);\n\t\n\t\/\/ Loads CSV and create variables from the column corresponding to Q_Language\n\t$j(document).ready(function($j){\t\n\t\t$j.ajax({\n\t\t\turl:\"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_yuKEs6pwxsAid44\",\n\t\t\tsuccess: function(csv){\n\t\t\t\t\n\t\t\tconst language = Qualtrics.SurveyEngine.getEmbeddedData(\"Q_Language\"); \n\t\t\t\t\n\t\t\tconst rows = csv.split('\\n').map(row => row.split('|'));\n\t\t\tconst headers = rows[0];\n\t\t\tconst col = headers.indexOf(language);\n\n\t\t\tif (col === -1) {\n\t\t\t\tconsole.error(\"Column 'language' not found in the CSV file.\");\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t\/\/ Iterate through the rows and create variables dynamically\n\t\t\tfor (let i = 1; i < rows.length-1; i++) {\n\t\t\t\tconst name = rows[i][0]; \/\/ Assuming the row name is in the first column\n\t\t\t\tconst value = rows[i][col];\n\t\t\t\twindow[name] = value; \n\t\t\t\t$j(\"#\" + name).html(value);\n\t\t\t\t$j(\".\" + name).html(value);\n\t\t\t\tconsole.log(`Variable ${name} created with value: ${value}`);\n\t\t\t}\n\n\t\t\t\t},\n\t\t\terror: function(){ alert('Data could not be loaded');}\n\t\t});\n\t});\n});"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID55","SecondaryAttribute":"What is your ZIP code?","TertiaryAttribute":null,"Payload":{"Configuration":{"InputHeight":29,"InputWi