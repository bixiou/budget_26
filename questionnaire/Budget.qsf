om\" || country == \"Reino Unido\" || country == \"Royaume-Uni\" || country == \"Vereinigtes K\u00f6nigreich\") {         \n\t\t\t\t\tvar ctry = \"U\";\n\t\t\t\t}\n\t\t\t\tpostcode = postcode.toString();\n\t\t\t\tif (ctry != \"U\" & postcode.length == 4) { postcode = '0' + postcode };\n\t\t\t\tvar zipcode = ctry + postcode.toUpperCase();\n\t\t\t    var i= 0, zip_urba = data.split('\\n'), found = false, category = 0;\n\t\t\t\tvar n = zip_urba.length;\n\t\t\t\twhile(i < n & !found) {\n\t\t\t\t\tvar zip_urba_i = zip_urba[i].split(',');\n\t\t\t\t\tif (zip_urba_i[0]==zipcode) { \n\t\t\t\t\t\tcategory =  zip_urba_i[1];\n\t\t\t\t\t\tfound = true;\n\t\t\t\t\t}\n\t\t\t\t\ti++;\n\t\t\t\t}\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"urban_category\", category);\t\n\t\t\t\t\/\/$j('#cat').html(region);\n            },\n            error: function(){ \n                alert('Fail of data loading');\n            }\n        });\n});","QuestionText":"\u00cates-vous propri\u00e9taire ou locataire ? (R\u00e9ponses multiples possible)","QuestionText_Unsafe":"Are you a homeowner or a tenant? (Multiple answers are possible)","QuestionType":"MC","Selector":"MACOL","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID42","SecondaryAttribute":"What is the estimated value of your household's assets (in \u00a3)? \u00a0 Include here all your possession.","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,"6",2,3,4],"Choices":{"1":{"Display":"Less than $0 (I have a net debt)"},"2":{"Display":"Between $4,000 and $120,000"},"3":{"Display":"Between $120,000 and $380,000"},"4":{"Display":"More than $380,000"},"6":{"Display":"Close to $0"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"wealth_couple","DataVisibility":{"Hidden":false,"Private":false},"Language":{"DE":{"QuestionText":"<div>Was ist der<b> <\/b>gesch\u00e4tzte Verm\u00f6genswert Ihres Haushaltes (in Euro)?<\/div>\n\n<div>\u00a0<\/div>\n\n<div>Geben Sie hier alle Ihre Besitzt\u00fcmer (Haus, Auto, Ersparnisse usw.) ohne Schulden an. Wenn Sie beispielsweise ein Haus im Wert von 300'000\u00a0\u20ac besitzen und 100'000\u00a0\u20ac zur R\u00fcckzahlung Ihrer Hypothek \u00fcbrighaben, betr\u00e4gt Ihr Verm\u00f6gen 200'000\u00a0\u20ac.<\/div>\n\n<div>\u00a0\n<div>Ich sch\u00e4tze unser Verm\u00f6gen ohne Schulden auf:<\/div>\n<\/div>\n","Choices":{"1":{"Display":"Weniger als \u20ac0 (wir haben eine Nettoverschuldung)"},"2":{"Display":"Zwischen \u20ac70'000 und \u20ac260'000"},"3":{"Display":"Zwischen \u20ac260'000 und \u20ac560'000"},"4":{"Display":"Mehr als \u20ac560'000"},"6":{"Display":"Zwischen \u20ac0 und \u20ac70'000"}}},"EN-GB":{"QuestionText":"<div>What is the<b> <\/b>estimated<b> <\/b>value<b> <\/b>of<b> <\/b>your<b> <\/b>household's assets (in \u00a3)?<\/div>\n\n<div>\u00a0<\/div>\n\n<div>Include here all your possessions (home, car, savings, etc.) net of debt. For example, if you own a house worth \u00a3300,000 and you have \u00a3100,000 left to repay on your mortgage, your assets are \u00a3200,000.<\/div>\n\n<div>\u00a0\n<div>I estimate my household's assets net of debt to be:\u00a0<\/div>\n<\/div>\n","Choices":{"1":{"Display":"Less than \u00a36,000 (including having a net debt)"},"2":{"Display":"Between \u00a390,000 and \u00a3230,000"},"3":{"Display":"Between \u00a3230,000 and \u00a3530,000"},"4":{"Display":"More than \u00a3530,000"},"6":{"Display":"Between \u00a36,000 and \u00a390,000"}}},"ES-ES":{"QuestionText":"<div>\u00bfCu\u00e1l es el valor estimado<b> <\/b>de<b> <\/b>sus<b> <\/b>activos del hogar? (en euros)<\/div>\n\n<div>\u00a0<\/div>\n\n<div>Incluya aqu\u00ed todas sus posesiones (casa, autom\u00f3vil, ahorros, etc.) deduciendo las deudas. Por ejemplo, si tiene una casa valorada en 300 000 \u20ac y le quedan 100 000 \u20ac para pagar su hipoteca, sus activos son 200 000 \u20ac.<\/div>\n\n<div>\n<div>Estimo que los activos del hogar netos de deudas son:<\/div>\n<\/div>\n","Choices":{"1":{"Display":"Menos de 0 \u20ac (tengo una deuda neta)"},"2":{"Display":"Entre 100 000 y 200 000 \u20ac"},"3":{"Display":"Entre 200 000 y 400 000 \u20ac"},"4":{"Display":"M\u00e1s de 400 000 \u20ac"},"6":{"Display":"Entre 0 y 100 000 \u20ac"}}},"FR":{"QuestionText":"<p>\u00c0 combien estimez-vous le patrimoine de votre m\u00e9nage (en euros) ?\u00a0<\/p>\n\n<p>\u00a0<\/p>\n\n<p>Sont incluses ici toutes vos possessions (logement, voiture, \u00e9pargne, etc.) nettes de dette. Par exemple, si vous poss\u00e9dez une maison valant 300\u00a0000\u20ac, votre seul bien, et qu'il vous reste 100\u00a0000\u20ac \u00e0 rembourser sur votre cr\u00e9dit immobilier, votre patrimoine s'\u00e9l\u00e8ve \u00e0 200\u00a0000\u20ac.\u00a0<\/p>\n","Choices":{"1":{"Display":"Moins de 10 000\u20ac (y compris dette nette)"},"6":{"Display":"Entre 10 000 et 100 000\u20ac"},"2":{"Display":"Entre 100 000 et 300 000\u20ac"},"3":{"Display":"Entre 300 000 et 600 000\u20ac"},"4":{"Display":"Plus de 600 000\u20ac"}}},"PL":{"QuestionText":"<div>Co to jest<b> <\/b>szacowany<b> <\/b>warto\u015b\u0107<b> <\/b>z<b> <\/b>tw\u00f3j<b> <\/b>maj\u0105tek gospodarstwa domowego (w \u00a3)?<\/div><div><\/div><div> Uwzgl\u0119dnij tutaj ca\u0142y sw\u00f3j maj\u0105tek (dom, samoch\u00f3d, oszcz\u0119dno\u015bci itp.) pomniejszony o zad\u0142u\u017cenie. Na przyk\u0142ad, je\u015bli posiadasz dom o warto\u015bci 300 000 funt\u00f3w i pozosta\u0142o ci 100 000 funt\u00f3w na sp\u0142at\u0119 kredytu hipotecznego, twoje aktywa wynosz\u0105 200 000 funt\u00f3w.<\/div><div><div> Szacuj\u0119, \u017ce maj\u0105tek mojego gospodarstwa domowego pomniejszony o zad\u0142u\u017cenie wynosi:<\/div><\/div>","Choices":{"1":{"Display":"Mniej ni\u017c 0 USD (mam d\u0142ug netto)"},"6":{"Display":"Blisko 0 dolar\u00f3w"},"2":{"Display":"Od 4 000 do 120 000 dolar\u00f3w"},"3":{"Display":"Od 120 000 do 380 000 dolar\u00f3w"},"4":{"Display":"Ponad 380 000 dolar\u00f3w"}}},"RU":{"QuestionText":"<div>\u0427\u0442\u043e \u0442\u0430\u043a\u043e\u0435<b> <\/b>\u043e\u0446\u0435\u043d\u0435\u043d\u043d\u044b\u0439<b> <\/b>\u0446\u0435\u043d\u0438\u0442\u044c<b> <\/b>\u0438\u0437<b> <\/b>\u0442\u0432\u043e\u0439<b> <\/b>\u0430\u043a\u0442\u0438\u0432\u044b \u0434\u043e\u043c\u043e\u0445\u043e\u0437\u044f\u0439\u0441\u0442\u0432\u0430 (\u0432 \u0444\u0443\u043d\u0442\u0430\u0445 \u0441\u0442\u0435\u0440\u043b\u0438\u043d\u0433\u043e\u0432)?<\/div><div><\/div><div> \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0441\u044e\u0434\u0430 \u0432\u0441\u0435 \u0432\u0430\u0448\u0435 \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e (\u0434\u043e\u043c, \u043c\u0430\u0448\u0438\u043d\u0443, \u0441\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u044f \u0438 \u0442. \u0434.) \u0437\u0430 \u0432\u044b\u0447\u0435\u0442\u043e\u043c \u0434\u043e\u043b\u0433\u043e\u0432. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0435\u0441\u043b\u0438 \u0432\u044b \u044f\u0432\u043b\u044f\u0435\u0442\u0435\u0441\u044c \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0435\u043c \u0434\u043e\u043c\u0430 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c\u044e 300 000 \u0444\u0443\u043d\u0442\u043e\u0432 \u0441\u0442\u0435\u0440\u043b\u0438\u043d\u0433\u043e\u0432 \u0438 \u0443 \u0432\u0430\u0441 \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c 100 000 \u0444\u0443\u043d\u0442\u043e\u0432 \u0441\u0442\u0435\u0440\u043b\u0438\u043d\u0433\u043e\u0432 \u0434\u043b\u044f \u043f\u043e\u0433\u0430\u0448\u0435\u043d\u0438\u044f \u0438\u043f\u043e\u0442\u0435\u043a\u0438, \u0432\u0430\u0448\u0438 \u0430\u043a\u0442\u0438\u0432\u044b \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 200 000 \u0444\u0443\u043d\u0442\u043e\u0432 \u0441\u0442\u0435\u0440\u043b\u0438\u043d\u0433\u043e\u0432.<\/div><div><div> \u042f \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u044e \u0430\u043a\u0442\u0438\u0432\u044b \u043c\u043e\u0435\u0439 \u0441\u0435\u043c\u0