share of the <span class=\"amount_lottery\">[amount_lottery: $100 prize]<\/span> would you donate to plant trees?<\/b>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\tQualtrics.SurveyEngine.setEmbeddedData(\"time_global_tax\", Date.now()\/1000);\n\tconst time_before = Qualtrics.SurveyEngine.getEmbeddedData(\"time_conjoint\");\n\tQualtrics.SurveyEngine.setEmbeddedData(\"duration_global_tax\", Date.now()\/1000 - time_before);\n\t\n\t\/\/ Loads CSV and create variables from the column corresponding to Q_Language\n\t\/\/ Loads CSV and create variables from the column corresponding to Q_Language\n\t$j(document).ready(function($j){\t\n\t\t$j.ajax({\n\t\t\turl:\"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_yuKEs6pwxsAid44\",\n\t\t\tsuccess: function(csv){\n\t\t\t\t\n\t\t\tconst language = Qualtrics.SurveyEngine.getEmbeddedData(\"Q_Language\"); \n\t\t\t\t\n\t\t\tconst rows = csv.split('\\n').map(row => row.split('|'));\n\t\t\tconst headers = rows[0];\n\t\t\tconst col = headers.indexOf(language);\n\n\t\t\tif (col === -1) {\n\t\t\t\tconsole.error(\"Column 'language' not found in the CSV file.\");\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t\/\/ Iterate through the rows and create variables dynamically\n\t\t\tfor (let i = 1; i < rows.length-1; i++) {\n\t\t\t\tconst name = rows[i][0]; \/\/ Assuming the row name is in the first column\n\t\t\t\tconst value = rows[i][col];\n\t\t\t\twindow[name] = value; \n\t\t\t\t$j(\".\" + name).html(value);\n\t\t\t\t$j(\"#\" + name).html(value);\n\t\t\t\tconsole.log(`Variable ${name} created with value: ${value}`);\n\t\t\t}\n\n\t\t\t\t},\n\t\t\terror: function(){ alert('Data could not be loaded');}\n\t\t});\n\t});\n});","DefaultChoices":false,"DataExportTag":"donation_long","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"By taking this survey, you will be automatically entered into a lottery to win up to [amount_lott...","Choices":{"1":{"Display":"Share to plant trees"}},"DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">variant_warm_glow<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 2 <\/span>","LeftOperand":"variant_warm_glow","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"2","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":{"AR":{"Labels":[]},"FR":{"QuestionText":"En r\u00e9pondant \u00e0 cette enqu\u00eate, vous \u00eates automatiquement inscrit \u00e0 une loterie pour gagner jusqu'\u00e0 <span class=\"amount_lottery\">100 $<\/span>.<br \/>\nSi vous \u00eates s\u00e9lectionn\u00e9 au tirage au sort, vous pouvez reverser une partie de cette compensation suppl\u00e9mentaire pour planter des arbres. Nous transmettrons ce don \u00e0 l'association caritative Just One Tree, qui plante un arbre pour <span class=\"tree\">[tree: every dollar donated]<\/span>.<br \/>\n<br \/>\n<b>Si vous gagnez la loterie, quelle part des <span class=\"amount_lottery\">100\u00a0$<\/span> donneriez-vous pour planter des arbres\u00a0?<\/b>","Choices":{"1":{"Display":"Part pour planter des arbres"}},"Labels":[]},"IT-CH":{"Labels":[]},"JA":{"Labels":[]},"PL":{"QuestionText":"Wype\u0142niaj\u0105c t\u0119 ankiet\u0119, automatycznie bierze Pan\/Pani udzia\u0142 w loterii, w kt\u00f3rej mo\u017cna wygra\u0107 do <span id=\"amount_lottery\">500 PLN<\/span>.<br \/>\nJe\u015bli zostanie Pan\/Pani wybrany(-a), mo\u017ce Pan\/Pani przekaza\u0107 cz\u0119\u015b\u0107 swojego wynagrodzenia na sadzenie drzew. Przeka\u017cemy t\u0119 darowizn\u0119 na rzecz organizacji charytatywnej Just One Tree, kt\u00f3ra sadzi jedno drzewo za <span id=\"tree\">ka\u017cde otrzymane 4 PLN<\/span>.<br \/>\n<br \/>\n<strong>Gdyby wygra\u0142(a) Pan\/Pani w loterii, jak\u0105 cz\u0119\u015b\u0107 ze swoich <span id=\"amount_lottery\">500 PLN<\/span> przeznaczy\u0142(a)by Pan\/Pani na sadzenie drzew?<\/strong>","Choices":{"1":{"Display":"Odsetek nagrody przeznaczony na sadzenie drzew"}},"Labels":[]},"RU":{"QuestionText":"\u041f\u0440\u0438\u043d\u044f\u0432 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u044d\u0442\u043e\u043c \u043e\u043f\u0440\u043e\u0441\u0435, \u0432\u044b \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435\u0441\u044c \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u043c \u043b\u043e\u0442\u0435\u0440\u0435\u0438, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043c\u043e\u0436\u043d\u043e \u0432\u044b\u0438\u0433\u0440\u0430\u0442\u044c \u0434\u043e <span id=\"amount_lottery\">100 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432<\/span> .<br> \u0415\u0441\u043b\u0438 \u0432\u0430\u0441 \u0432\u044b\u0431\u0435\u0440\u0443\u0442 \u0432 \u043b\u043e\u0442\u0435\u0440\u0435\u0435, \u0432\u044b \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0447\u0430\u0441\u0442\u044c \u044d\u0442\u043e\u0439 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u0438\u0438 \u043d\u0430 \u043f\u043e\u0441\u0430\u0434\u043a\u0443 \u0434\u0435\u0440\u0435\u0432\u044c\u0435\u0432. \u041c\u044b \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u043c \u044d\u0442\u043e \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0431\u043b\u0430\u0433\u043e\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u0443\u044e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044e Just One Tree, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0430\u0436\u0430\u0435\u0442 \u043e\u0434\u043d\u043e \u0434\u0435\u0440\u0435\u0432\u043e \u0437\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0434\u043e\u043b\u043b\u0430\u0440.<br><br> <b>\u0415\u0441\u043b\u0438 \u0431\u044b \u0432\u044b \u0441\u0442\u0430\u043b\u0438 \u043f\u043e\u0431\u0435\u0434\u0438\u0442\u0435\u043b\u0435\u043c \u043b\u043e\u0442\u0435\u0440\u0435\u0438, \u043a\u0430\u043a\u0443\u044e \u0447\u0430\u0441\u0442\u044c <span id=\"amount_lottery\">\u043f\u0440\u0438\u0437\u0430 \u0432 100 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432<\/span> \u0432\u044b \u0431\u044b \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u043d\u0430 \u043f\u043e\u0441\u0430\u0434\u043a\u0443 \u0434\u0435\u0440\u0435\u0432\u044c\u0435\u0432?<\/b>","Choices":{"1":{"Display":"\u041f\u043e\u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u0430\u0434\u0438\u0442\u044c \u0434\u0435\u0440\u0435\u0432\u044c\u044f"}},"Labels":[]}},"NextChoiceId":4,"NextAnswerId":1,"Labels":[],"QuestionID":"QID107"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID108","SecondaryAttribute":"In several international organizations, countries have agreed to demonstrate some degree of solid...","TertiaryAttribute":null,"Payload":{"QuestionText":"In several international organizations, <b>countries have agreed to demonstrate some degree of solidarity in addressing global challenges<\/b>.<br><br>Here are a few examples:<br>\ud83d\udea2&nbsp;<b>The International Maritime Organization plans to reduce carbon emissions<\/b> from shipping <b>and <\/b>may<b> adopt a levy<\/b> on such emissions in 2025, <b>that could partly finance low-income countries<\/b>.<br>\n\ud83c\udf31 In international climate negotiations, <b>developed countries have committed to finance climate action in developing countries<\/b>. In 2009, they committed to provide $100 billion per year by 2020. In 2023, all countries agreed to set up a fund to help vulnerable countries cope with loss and damage from climate change. In 2024, the $100 billion <b>goal was increased<\/b> to $300 billion per year by 2035.","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\tQualtrics.SurveyEngine.setEmbeddedData(\"time_ics\", Date.now()\/1000);\n\tconst time_before = Qualtrics.SurveyEngine.getEmbeddedData(\"time_warm_glow_substitute\");\n\tQualtrics.SurveyEngine.setEmbeddedData(\"duration_ics\", Date.now()\/1000 - time_before);\n\t\n\t\/\/ Loads CSV and create variables from the column corresponding to Q_Language\n\t$j(document).ready(function($j){\t\n\t\t$j.ajax({\n\t\t\turl:\"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_yuKEs6pwxsAid44\",\n\t\t\tsuccess: function(csv){\n\t\t\t\t\n\t\t\tconst language = Qualtrics.SurveyEngine.getEmbeddedData(\"Q_Language\"); \n\t\t\t\t\n\t\t\tconst rows = csv.split('\\n').map(row => row.split('|'));\n\t\t\tconst headers = rows[0];\n\t\t\tconst col = headers.indexOf(language);\n\n\t\t\tif (col === -1) {\n\t\t\t\tconsole.error(\"Column 'language' not found in the CSV file.\");\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t\/\/ Iterate through the rows and create variables dynamically\n\t\t\tfor (let i = 1; i < rows.length-1; i++) {\n\t\t\t\tconst name = rows[i][0]; \/\/ Assuming the row name is in the first column\n\t\t\t\tconst value = rows[i][col];\n\t\t\t\twindow[name] = value; \n\t\t\t\t$j(\"#\" + name).html(value);\n\t\t\t\t$j(\".\" + name).html(value);\n\t\t\t\tconsole.log(`Variable ${name} created with value: ${value}`);\n\t\t\t}\n\n\t\t\t\t},\n\t\t\terror: function(){ alert('Data could not be loaded');}\n\t\t});\n\t});\n});","DefaultChoices":false,"DataExportTag":"info_solidarity_cut","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In several international organizations, countries have agreed to demonstrate some degree of solid...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">variant_realism<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"variant_realism","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"1":{"Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"LeftOpDesc\">long<\/span> <span class=\"OpDesc\">Is Less Than<\/span> <span class=\"RightOpDesc\"> 0.42 <\/span>","LeftOperand":"long","LogicType":"EmbeddedField","Operator":"LessThan","RightOperand":"0.42","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":{"AR":{"QuestionText":"\u0627\u062a\u0641\u0642\u062a \u0627\u0644\u062f\u0648\u0644 \u0641\u064a \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0624\u0633\u0633\u0627\u062a \u0627\u0644\u062f\u0648\u0644\u064a\u0629 <b>\u0639\u0644\u0649 \u0625\u0638\u0647\u0627\u0631 \u0642\u062f\u0631 \u0645\u0639\u064a\u0646 \u0645\u0646 \u0627\u0644\u062a\u0636\u0627\u0645\u0646 \u0641\u064a \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u062d\u062f\u064a\u0627\u062a \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629.\u00a0<\/b><br \/>\n<br \/>\n\u0648\u0641\u064a\u0645\u0627 \u064a\u0644\u064a \u0628\u0639\u0636 \u0627\u0644\u0623\u0645\u062b\u0644\u0629:<br \/>\n\ud83d\udea2 <b>\u062a\u062e\u0637\u0637 \u0627\u0644\u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u0627\u0644\u062f\u0648\u0644\u064a\u0629 \u0644\u062e\u0641\u0636 \u0627\u0646\u0628\u0639\u0627\u062b\u0627\u062a \u0627\u0644\u0643\u0631\u0628\u0648\u0646<\/b> \u0627\u0644\u0646\u0627\u062c\u0645\u0629 \u0639\u0646 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0628\u062d\u0631\u064a <b>\u0648\u0642\u062f<\/b> <b>\u062a\u062a\u0628\u0646\u0649 \u0641\u0631\u0636 \u0636\u0631\u064a\u0628\u0629<\/b> \u0639\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0627\u0646\u0628\u0639\u0627\u062b\u0627\u062a \u0628\u062d\u0644\u0648\u0644 \u0639\u0627\u0645 2025\u060c <b>\u0648\u0647\u0648 \u0645\u0627 \u0642\u062f \u064a\u0633\u0627\u0639\u062f \u062c\u0632\u0626\u064a\u064b\u0627 \u0641\u064a \u062a\u0645\u0648\u064a\u0644 \u0627\u0644\u0628\u0644\u062f\u0627\u0646 \u0645\u0646\u062e\u0641\u0636\u0629 \u0627\u0644\u062f\u062e\u0644<\/b> .<br \/>\n\ud83c\udf31 \u0648\u0641\u064a \u0627\u0644\u0645\u0641\u0627\u0648\u0636\u0627\u062a \u0627\u0644\u062f\u0648\u0644\u064a\u0629 \u0628\u0634\u0623\u0646 \u0627\u0644\u0645\u0646\u0627\u062e\u060c <b>\u0627\u0644\u062a\u0632\u0645\u062a \u0627\u0644\u062f\u0648\u0644 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0628\u062a\u0645\u0648\u064a\u0644 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0645\u0646\u0627\u062e\u064a \u0641\u064a \u0627\u0644\u062f\u0648\u0644 \u0627\u0644\u0646\u0627\u0645\u064a\u0629<\/b>. \u0648\u0641\u064a \u0639\u0627\u0645 2009\u060c \u0627\u0644\u062a\u0632\u0645\u062a \u0627\u0644\u062f\u0648\u0644 \u0628\u062a\u0648\u0641\u064a\u0631 100 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 \u0633\u0646\u0648\u064a\u064b\u0627 \u0641\u064a \u0639\u0627\u0645 2020. \u0648\u0641\u064a \u0639\u0627\u0645 2023\u060c \u0648\u0627\u0641\u0642\u062a \u0643\u0627\u0641\u0629 \u0627\u0644\u062f\u0648\u0644 \u0639\u0644\u0649 \u0625\u0646\u0634\u0627\u0621 \u0635\u0646\u062f\u0648\u0642 \u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u0644\u062f\u0627\u0646 \u0627\u0644\u0646\u0627\u0645\u064a\u0629 \u0639\u0644\u0649 \u0645\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u062e\u0633\u0627\u0626\u0631 \u0648\u0627\u0644\u0623\u0636\u0631\u0627\u0631 \u0627\u0644\u0646\u0627\u062c\u0645\u0629 \u0639\u0646 \u0627\u0644\u062a\u063a\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0646\u0627\u062e\u064a\u0629. \u0628\u064a\u0646\u0645\u0627 \u0641\u064a \u0639\u0627\u0645 2024\u060c <b>\u062a\u0645 \u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u062a\u0645\u0648\u064a\u0644 \u0627\u0644\u0645\u064f\u0633\u062a\u0647\u062f\u0641<\/b>\u00a0\u0645\u0646 100 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 \u0625\u0644\u0649 300 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 \u0633\u0646\u0648\u064a\u064b\u0627 \u0628\u062d\u0644\u0648\u0644 \u0639\u0627\u0645 2035."},"FR":{"QuestionText":"Pour v\u00e9rifier que vous avez lu attentivement la description ci-dessous, nous poserons quelques questions de compr\u00e9hension plus tard dans l'enqu\u00eate : ceux qui r\u00e9pondent correctement peuvent gagner <span class=\"amount_lottery\">$100<\/span>.<br \/>\n<br \/>\nDans plusieurs organisations internationales, les pays ont convenu d\u2019une certaine solidarit\u00e9 pour relever des d\u00e9fis mondiaux.<br \/>\nDes n\u00e9gociations sont en cours pour mettre en \u0153uvre des m\u00e9canismes sp\u00e9cifiques de d\u00e9veloppement durable.<br \/>\n<br \/>\nVoici quelques exemples :<br \/>\n\ud83d\udea2 L'Organisation maritime internationale pr\u00e9voit de r\u00e9duire les \u00e9missions de carbone li\u00e9es au transport maritime et pourrait adopter un pr\u00e9l\u00e8vement sur ces \u00e9missions en 2025, qui pourrait financer en partie les pays \u00e0 bas revenus.<br \/>\n\ud83d\udce6 Depuis 1970, les pays d\u00e9velopp\u00e9s ont accept\u00e9 de contribuer 0,7% de leur PIB \u00e0 l'aide au d\u00e9veloppement.<br \/>\n\ud83c\udf31 Dans les n\u00e9gociations internationales sur le climat, les pays d\u00e9velopp\u00e9s se sont engag\u00e9s \u00e0 financer l'action climatique dans les pays en d\u00e9veloppement. En 2009, ils se sont engag\u00e9s \u00e0 fournir 100 milliards de dollars par an d\u2019ici 2020. En 2023, tous les pays ont convenu de cr\u00e9er un fonds pour aider les pays vuln\u00e9rables \u00e0 faire face aux pertes et aux pr\u00e9judices caus\u00e9s par le changement climatique. En 2024, l\u2019objectif de 100 milliards de dollars a \u00e9t\u00e9 port\u00e9 \u00e0 300 milliards de dollars par an d\u2019ici 2035.<br \/>\n\ud83d\udcc8 En 2021, 136 pays ont adopt\u00e9 un taux minimum de 15 % sur les profits des multinationales.<br \/>\n\ud83d\udc8e En 2024, sous l'impulsion du Br\u00e9sil, le G20 a \u00e9tudi\u00e9 l'instauration d'une taxe mondiale de 2% sur la fortune des milliardaires.<br \/>\n\ud83c\udf10 En 2024, l'Assembl\u00e9e g\u00e9n\u00e9rale de l'ONU a adopt\u00e9 le Pacte pour l'avenir, qui pr\u00e9voit une r\u00e9forme du Conseil de s\u00e9curit\u00e9 de l'ONU pour limiter le pouvoir de ses cinq membres permanents et l'\u00e9largir \u00e0 de nouveaux membres.<br \/>\n\ud83d\udd04 Men\u00e9e par la Premi\u00e8re ministre de la Barbade et soutenue par le Secr\u00e9taire g\u00e9n\u00e9ral de l'ONU, l'initiative Bridgetown vise un nouveau syst\u00e8me financier qui orienterait les ressources financi\u00e8res vers l'action climatique et le d\u00e9veloppement durable."},"IT-CH":[],"JA":[],"PL":{"QuestionText":"Cz\u0119\u015b\u0107 kraj\u00f3w, <strong>wchodz\u0105c w sk\u0142ad r\u00f3\u017cnych organizacji mi\u0119dzynarodowych, ustali\u0142a wsp\u00f3lne stanowisko w zakresie rozwi\u0105zywania globalnych problem\u00f3w<\/strong>.<br \/>\n<br \/>\nOto kilka przyk\u0142ad\u00f3w:<br \/>\n\ud83d\udea2 <strong>Mi\u0119dzynarodowa Organizacja Morska planuje zmniejszenie ilo\u015bci dwutlenku w\u0119gla emitowanego przez \u017ceglug\u0119 i<\/strong> jest sk\u0142onna w 2025 r. <strong>obci\u0105\u017cy\u0107 tak\u0105 emisj\u0119 op\u0142at\u0105, kt\u00f3ra cz\u0119\u015bciowo mog\u0142aby finansowa\u0107 kraje o niskim dochodzie<\/strong>.<br \/>\n\ud83c\udf31 W mi\u0119dzynarodowych negocjacjach klimatycznych <strong>kraje rozwini\u0119te zobowi\u0105za\u0142y si\u0119 do finansowania dzia\u0142a\u0144 w zakresie klimatu w krajach rozwijaj\u0105cych si\u0119<\/strong>. W 2009 r. zapowiedzia\u0142y, \u017ce b\u0119d\u0105 rocznie przeznacza\u0107 na ten cel 100 miliard\u00f3w USD do 2020 roku. W 2023 r. wszystkie kraje zgodzi\u0142y si\u0119 na utworzenie funduszu, kt\u00f3ry ma pom\u00f3c krajom znajduj\u0105cym si\u0119 w trudnej sytuacji w radzeniu sobie ze stratami i szkodami wynikaj\u0105cymi ze zmian klimatycznych. W 2024 r. docelowa kwota zosta\u0142a zwi\u0119kszona do 300 miliard\u00f3w USD przekazywanych rocznie do 2035 r."},"RU":[],"DE":{"QuestionText":"<div>In mehreren internationalen Organisationen haben sich <strong>L\u00e4nder darauf geeinigt, Solidarit\u00e4t f\u00fcr der Bew\u00e4ltigung globaler Herausforderungen zu zeigen.<\/strong><\/div>\n\n<div>\u00a0<\/div>\n\n<div>Hier einige Beispiele:<\/div>\n\n<div>\ud83d\udea2 <strong>Die Internationale Seeschifffahrtsorganisation (IMO) plant, die CO\u2082-Emissionen der Schifffahrt zu reduzieren<\/strong> und erw\u00e4gt 2025 eine <strong>Abgabe<\/strong> auf diese Emissionen einzuf\u00fchren, <strong>die teilweise einkommensschwache L\u00e4nder finanziell unterst\u00fczten k\u00f6nnte.<\/strong><br \/>\n\u00a0<\/div>\n\n<div>\ud83c\udf31 In internationalen Klimaverhandlungen haben <strong>sich entwickelte L\u00e4nder verpflichtet, Klimaschutzma\u00dfnahmen in Entwicklungsl\u00e4ndern mitzufinanzieren<\/strong>. Bereits 2009 wurde das Ziel formuliert, bis 2020 j\u00e4hrlich 100 Milliarden US-Dollar bereitzustellen. 2023 einigten sich alle L\u00e4nder auf die Einrichtung eines Fonds, um gef\u00e4hrdete L\u00e4nder bei der Bew\u00e4ltigung von durch Klimawandel verursachten Verlusten und Sch\u00e4den zu unterst\u00fctzen. 2024 wurde das j\u00e4hrliche Finanzierungsziel von von 100 Milliarden US-Dollar auf 300 Milliarden US-Dollar bis 2035 erh\u00f6ht.<\/div>\n"},"EN":[],"DE-CH":[],"FR-CH":[],"ES-ES":{"QuestionText":"En varias organizaciones internacionales, <b>los pa\u00edses han acordado demostrar cierto grado de solidaridad para abordar los desaf\u00edos globales.<\/b>.<br \/>\n<br \/>\nAqu\u00ed hay algunos ejemplos:<br \/>\n\ud83d\udea2\u00a0<b>La Organizaci\u00f3n Mar\u00edtima Internacional planea reducir las emisiones de carbono<\/b> del transporte mar\u00edtimo <b>y <\/b>puede<b> adoptar un impuesto<\/b> En tales emisiones, en 2025, <b>que podr\u00edan financiar parcialmente a los pa\u00edses de bajos ingresos.<br \/>\n\ud83c\udf31 En las negociaciones internacionales sobre el clima, <b>los pa\u00edses desarrollados se han comprometido a financiar la acci\u00f3n clim\u00e1tica en los pa\u00edses en desarrollo.<\/b> En 2009, se comprometieron a aportar 100.000 millones de d\u00f3lares anuales para 2020. En 2023, todos los pa\u00edses acordaron establecer un fondo para ayudar a los pa\u00edses vulnerables a afrontar las p\u00e9rdidas y los da\u00f1os causados \u200b\u200bpor el cambio clim\u00e1tico. En 2024, <b>la meta de 100.000 millones de d\u00f3lares se increment\u00f3<\/b> a 300.000 millones de d\u00f3lares anuales para 2035.<\/b>"},"ES-US":[],"IT":{"QuestionText":"In diverse organizzazioni internazionali, <b>i Paesi hanno raggiunto un accordo per dimostrare un certo grado di solidariet\u00e0 nell'affrontare sfide globali<\/b>.<br \/>\n<br \/>\nEcco alcuni esempi:<br \/>\n\ud83d\udea2\u00a0<b>L'Organizzazione Marittima Internazionale ha in programma la riduzione delle emissioni di carbonio<\/b> dovute alla navigazione <b>e <\/b>potrebbe<b> introdurre un'imposta<\/b> su tali emissioni nel 2025, <b>che potrebbe finanziare, in parte, i Paesi a basso reddito<\/b>.<br \/>\n\ud83c\udf31 Nei negoziati internazionali sul clima, i <b>paesi sviluppati si sono impegnati a finanziare l'azione per il clima nei paesi in via di sviluppo<\/b>. Nel 2009, si sono impegnati a fornire 100 miliardi di dollari all'anno entro il 2020. Nel 2023, tutti i paesi hanno concordato di istituire un fondo per aiutare i paesi vulnerabili a far fronte alle perdite e ai danni causati dai cambiamenti climatici. Nel 2024, l'<b>obiettivo<\/b> di 100 miliardi di dollari \u00e8 stato aumentato a 300 miliardi di dollari all'anno entro il 2035."},"EN-GB":[]},"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID108"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID109","SecondaryAttribute":"This year, to meet the international climate targets, the International Maritime Organization aim...","TertiaryAttribute":null,"Payload":{"QuestionText":"This year, to meet the international climate targets, the International Maritime Organization aims to introduce a global levy on shipping carbon emissions. Currently, countries are negotiating the design of this levy and how to allocate the revenue of a levy between the three categories below.&nbsp;<br><br><b>According to you, what percentage of the revenue from a maritime fuel levy should be allocated to each category below?<\/b> The total must be 100.<br><br><i>To help you answer, here is some information about carbon emissions from shipping and the impact of a levy:<br>\u2022 Four types of commodities dominate the shipping activity: oil and gas (29% of emissions from shipping); manufactured goods (24%); coal, iron, and other raw material (16%); grain and foodstuff (12%).<br>\u2022 A levy of $100 per ton of CO<sub>2<\/sub> would increase the price of imported oil and food by 0.5% to 2%. Overall inflation would be 0.1%.<\/i><br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\tQualtrics.SurveyEngine.setEmbeddedData(\"time_warm_glow_realism\", Date.now()\/1000);\n\tconst time_before = Qualtrics.SurveyEngine.getEmbeddedData(\"time_ics\");\n\tQualtrics.SurveyEngine.setEmbeddedData(\"duration_warm_glow_realism\", Date.now()\/1000 - time_before);\n\n   jQuery(this.getQuestionContainer()).find(\".ChoiceStructure\").prepend(\"<div style='text-align:right;font-weight:bold;padding-bottom:10px;line-height:1.1'>\"+\n\n             \"<span class='totCheck' style='display:none;color:green'>&#10004; <\/span><span class='sum_name'>Total<\/span>\"+\n\n             \": <span class='totWrap'><span class='total'>0<\/span>%<\/span><\/span>\");\n\n       mfCsSliders(this);\n\n});","DefaultChoices":false,"DataExportTag":"maritime_split_long","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":true,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"This year, to meet the international climate targets, the International Maritime Organization aim...","Choices":{"1":{"Display":"Fostering sustainable transition in the least developed countries and small islands states"},"2":{"Display":"Return revenues to shipping companies to prevent increases in shipping costs"},"3":{"Display":"Finance research, development and deployment for zero-emission fuels and ships"}},"DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">variant_ncqg_maritime<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 0 <\/span>","LeftOperand":"variant_ncqg_maritime","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"0","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":["1","2","3"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID26\/ChoiceNumericEntryValue\/3","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">This year, to meet the international climate targets, the International Maritime Organization aim...<\/span> <span class=\"LeftOpDesc\">finance research, development and deployment for zero-emission fuels<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> $e{100 - q:\/\/QID26\/ChoiceNumericEntryValue\/2 - q:\/\/QID26\/ChoiceNumericEntryValue\/1 } <\/span>","LeftOperand":"q:\/\/QID26\/ChoiceNumericEntryValue\/3","LogicType":"Question","Operator":"EqualTo","QuestionID":"QID26","QuestionIDFromLocator":"QID26","QuestionIsInLoop":"no","RightOperand":"$e{100 - q:\/\/QID26\/ChoiceNumericEntryValue\/2 - q:\/\/QID26\/ChoiceNumericEntryValue\/1 }","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Require total sum of 100","libraryID":null,"messageID":null,"subMessageID":"VE_IMPORTANCE_TOTAL"}}}},"GradingData":[],"Language":{"AR":{"Labels":[]},"FR":{"QuestionText":"Cette ann\u00e9e, pour atteindre les objectifs climatiques internationaux, l\u2019Organisation maritime internationale vise \u00e0 introduire un pr\u00e9l\u00e8vement mondial sur les \u00e9missions de CO<sub>2<\/sub> du transport maritime. Actuellement, les pays n\u00e9gocient la conception de ce pr\u00e9l\u00e8vement et la mani\u00e8re d'en r\u00e9partir les recettes les trois cat\u00e9gories ci-dessous.<br \/>\n<br \/>\n<b>Selon vous, quel pourcentage des recettes d'une taxe sur les carburants maritimes devrait \u00eatre allou\u00e9 \u00e0 chaque cat\u00e9gorie ci-dessous ?<\/b> Le total doit faire 100%.<br \/>\n<br \/>\n<em>Pour vous aider \u00e0 r\u00e9pondre, voici quelques informations sur les \u00e9missions de CO<sub>2<\/sub> li\u00e9es au transport maritime et l\u2019impact d\u2019un pr\u00e9l\u00e8vement\u00a0:<br \/>\n\u2022 Quatre types de produits dominent l'activit\u00e9 du transport maritime : p\u00e9trole et gaz (29 % des \u00e9missions du transport maritime) ; produits manufactur\u00e9s (24 %) ; charbon, fer et autres mati\u00e8res premi\u00e8res (16 %) ; c\u00e9r\u00e9ales et produits alimentaires (12%).<br \/>\n\u2022 Un pr\u00e9l\u00e8vement de 100 dollars par tonne de CO<sub>2<\/sub> augmenterait le prix du p\u00e9trole et des produits alimentaires import\u00e9s de 0,5 \u00e0 2 %. L'inflation g\u00e9n\u00e9rale serait de 0,1%.<\/em>","Choices":{"1":{"Display":"Favoriser la transition \u00e9cologique dans les pays les moins d\u00e9velopp\u00e9s et les petits \u00c9tats insulaires"},"2":{"Display":"Reverser les revenus aux compagnies maritimes pour \u00e9viter l\u2019augmentation des co\u00fbts de transport"},"3":{"Display":"Financer la recherche, le d\u00e9veloppement et le d\u00e9ploiement de carburants et de navires z\u00e9ro \u00e9mission"}},"Labels":[]},"IT-CH":{"Labels":[]},"JA":{"Labels":[]},"PL":{"QuestionText":"Aby spe\u0142ni\u0107 mi\u0119dzynarodowe cele klimatyczne, w tym roku Mi\u0119dzynarodowa Organizacja Morska zamierza wprowadzi\u0107 globalny podatek od emisji dwutlenku w\u0119gla w \u017cegludze. Obecnie kraje negocjuj\u0105 projekt tej op\u0142aty i spos\u00f3b podzia\u0142u dochod\u00f3w z op\u0142aty mi\u0119dzy trzy kategorie opisane poni\u017cej.<br \/>\n<br \/>\n<b>Jaki odsetek dochod\u00f3w z op\u0142aty za paliwo morskie powinien by\u0107 wed\u0142ug Pana\/Pani przydzielony do ka\u017cdej kategorii?<\/b> Suma musi wynosi\u0107 100.<br \/>\n<br \/>\n<i>Aby pom\u00f3c Panu\/Pani w udzieleniu odpowiedzi, oto kilka informacji na temat emisji dwutlenku w\u0119gla przez \u017ceglug\u0119 i konsekwencji wprowadzenia op\u0142aty:<br \/>\n\u2022 W dzia\u0142alno\u015bci \u017ceglugowej dominuj\u0105 cztery rodzaje towar\u00f3w: ropa naftowa i gaz ziemny (29% emisji z \u017ceglugi); towary u\u017cytkowe (24%); w\u0119giel, \u017celazo i inne surowce (16%); zbo\u017ce i artyku\u0142y spo\u017cywcze (12%).<br \/>\n\u2022 Op\u0142ata w wysoko\u015bci 100 USD za ton\u0119 CO<sub>2<\/sub> zwi\u0119kszy\u0142aby cen\u0119 importowanej ropy naftowej i \u017cywno\u015bci o 0,5%-2%. Og\u00f3lna inflacja wynios\u0142aby 0,1%.<\/i>","Choices":{"1":{"Display":"Wspieranie zr\u00f3wnowa\u017conej transformacji w krajach najs\u0142abiej rozwini\u0119tych i ma\u0142ych pa\u0144stwach wyspiarskich"},"2":{"Display":"Zwracanie przychod\u00f3w firmom spedycyjnym w celu zapobie\u017cenia wzrostowi koszt\u00f3w transportu"},"3":{"Display":"Finansowanie bada\u0144, rozwoju i wdra\u017cania paliw i statk\u00f3w o zerowej emisji"}},"Labels":[]},"RU":{"QuestionText":"\u0412 \u044d\u0442\u043e\u043c \u0433\u043e\u0434\u0443 \u0434\u043b\u044f \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0446\u0435\u043b\u0435\u0439 \u041c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u044f \u043c\u043e\u0440\u0441\u043a\u0430\u044f \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u0430 \u0432\u0432\u0435\u0441\u0442\u0438 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u0430\u043b\u043e\u0433 \u043d\u0430 \u0432\u044b\u0431\u0440\u043e\u0441\u044b \u0443\u0433\u043b\u0435\u0440\u043e\u0434\u0430 \u0432 \u0441\u0443\u0434\u043e\u0445\u043e\u0434\u0441\u0442\u0432\u0435. \u0412 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u0441\u0442\u0440\u0430\u043d\u044b \u0432\u0435\u0434\u0443\u0442 \u043f\u0435\u0440\u0435\u0433\u043e\u0432\u043e\u0440\u044b \u043e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435 \u044d\u0442\u043e\u0433\u043e \u0441\u0431\u043e\u0440\u0430 \u0438 \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u0434\u043e\u0445\u043e\u0434\u044b \u043e\u0442 \u0441\u0431\u043e\u0440\u0430 \u043c\u0435\u0436\u0434\u0443 \u0442\u0440\u0435\u043c\u044f \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f\u043c\u0438, \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u044b\u043c\u0438 \u043d\u0438\u0436\u0435.<br><br> <b>\u041f\u043e \u0432\u0430\u0448\u0435\u043c\u0443 \u043c\u043d\u0435\u043d\u0438\u044e, \u043a\u0430\u043a\u043e\u0439 \u043f\u0440\u043e\u0446\u0435\u043d\u0442 \u0434\u043e\u0445\u043e\u0434\u043e\u0432 \u043e\u0442 \u0441\u0431\u043e\u0440\u0430 \u043d\u0430 \u043c\u043e\u0440\u0441\u043a\u043e\u0435 \u0442\u043e\u043f\u043b\u0438\u0432\u043e \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430 \u043a\u0430\u0436\u0434\u0443\u044e \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044e?<\/b> \u041e\u0431\u0449\u0430\u044f \u0441\u0443\u043c\u043c\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c 100.<br><br> \u0427\u0442\u043e\u0431\u044b \u043f\u043e\u043c\u043e\u0447\u044c \u0432\u0430\u043c \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c, \u0432\u043e\u0442 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u0432\u044b\u0431\u0440\u043e\u0441\u0430\u0445 \u0443\u0433\u043b\u0435\u0440\u043e\u0434\u0430 \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u0441\u0443\u0434\u043e\u0445\u043e\u0434\u0441\u0442\u0432\u0430 \u0438 \u0432\u043b\u0438\u044f\u043d\u0438\u0438 \u0441\u0431\u043e\u0440\u0430:<br> \u2022 \u0412 \u0441\u0443\u0434\u043e\u0445\u043e\u0434\u043d\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u043e\u0431\u043b\u0430\u0434\u0430\u044e\u0442 \u0447\u0435\u0442\u044b\u0440\u0435 \u0442\u0438\u043f\u0430 \u0442\u043e\u0432\u0430\u0440\u043e\u0432: \u043d\u0435\u0444\u0442\u044c \u0438 \u0433\u0430\u0437 (29% \u0432\u044b\u0431\u0440\u043e\u0441\u043e\u0432 \u043e\u0442 \u0441\u0443\u0434\u043e\u0445\u043e\u0434\u0441\u0442\u0432\u0430); \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u044b\u0435 \u0442\u043e\u0432\u0430\u0440\u044b (24%); \u0443\u0433\u043e\u043b\u044c, \u0436\u0435\u043b\u0435\u0437\u043e \u0438 \u0434\u0440\u0443\u0433\u043e\u0435 \u0441\u044b\u0440\u044c\u0435 (16%); \u0437\u0435\u0440\u043d\u043e \u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u044b \u043f\u0438\u0442\u0430\u043d\u0438\u044f (12%).<br> \u2022 \u0421\u0431\u043e\u0440 \u0432 \u0440\u0430\u0437\u043c\u0435\u0440\u0435 100 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0437\u0430 \u0442\u043e\u043d\u043d\u0443 CO <sub>2<\/sub> \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442 \u0446\u0435\u043d\u0443 <i>\u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u0443\u0435\u043c\u043e\u0439<\/i> \u043d\u0435\u0444\u0442\u0438 \u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u043f\u0438\u0442\u0430\u043d\u0438\u044f \u043d\u0430 0,5\u20132%. \u041e\u0431\u0449\u0430\u044f \u0438\u043d\u0444\u043b\u044f\u0446\u0438\u044f \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u0442 0,1%.<br>","Choices":{"1":{"Display":"\u0421\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u043c\u0443 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0443 \u0432 \u043d\u0430\u0438\u043c\u0435\u043d\u0435\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u044b\u0445 \u0441\u0442\u0440\u0430\u043d\u0430\u0445 \u0438 \u043c\u0430\u043b\u044b\u0445 \u043e\u0441\u0442\u0440\u043e\u0432\u043d\u044b\u0445 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u0445"},"2":{"Display":"\u0412\u0435\u0440\u043d\u0438\u0442\u0435 \u0434\u043e\u0445\u043e\u0434\u044b \u0441\u0443\u0434\u043e\u0445\u043e\u0434\u043d\u044b\u043c \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f\u043c, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0440\u043e\u0441\u0442 \u0440\u0430\u0441\u0445\u043e\u0434\u043e\u0432 \u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0443"},"3":{"Display":"\u0424\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0439, \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043e\u043a \u0438 \u0432\u043d\u0435\u0434\u0440\u0435\u043d\u0438\u044f \u0432\u0438\u0434\u043e\u0432 \u0442\u043e\u043f\u043b\u0438\u0432\u0430 \u0438 \u0441\u0443\u0434\u043e\u0432 \u0441 \u043d\u0443\u043b\u0435\u0432\u044b\u043c \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u0432\u044b\u0431\u0440\u043e\u0441\u043e\u0432"}},"Labels":[]}},"NextChoiceId":4,"NextAnswerId":1,"Labels":[],"Answers":{"1":{"Display":0},"2":{"Display":10},"3":{"Display":20},"4":{"Display":30},"5":{"Display":40},"6":{"Display":50},"7":{"Display":60},"8":{"Display":70},"9":{"Display":80},"10":{"Display":90},"11":{"Display":100}},"QuestionID":"QID109"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"additional taxes on individual income above \u20ac4,000 per month transferring 5% of high-income count.","TertiaryAttribute":null,"Payload":{"QuestionText":"additional taxes on individual income above \u20ac4,000 per month transferring 5% of high-income countries\u2019 GDP to low-income countries (specify rate + minimal income it would finance)","DefaultChoices":false,"DataExportTag":"Q11","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"additional taxes on individual income above \u20ac4,000 per month transferring 5% of high-income count...","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID11"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID110","SecondaryAttribute":"To ensure that you have attentively read the description below, we will ask some comprehension qu...","TertiaryAttribute":null,"Payload":{"QuestionText":"To ensure that you have attentively read the description below, <b>we will ask some comprehension questions later in the survey: those who get correct answers can win <span id=\"amount_lottery\">[amount_lottery: $100]<\/span><\/b>.<br><br>\"Climate finance\" designates the financing of climate action from developed countries in developing countries. <span id=\"developed_note\">[developed_note: (Note that we consider Saudi Arabia to be a developed country in this question.)]<\/span><br><br><b>There are two kinds of climate finance: grants (that is, donations) and loans. The large majority is currently provided as loans.&nbsp;<\/b><br><br><b>In 2009, developed countries agreed to mobilize $100 billion per year in climate finance. In 2024, they committed to triple this goal by 2035. None of the goals specify which share should be provided as grants.&nbsp;<br><br>At international climate negotiations, developing countries call for larger provision of climate finance, particularly in the form of grants.<\/b><br><br>Through their contributions to institutions such as the World Bank, developed countries are currently on track to meet the new goal for by 2035. However, needs may be four times higher than the agreed goal, according to an independent expert group (which does not specify what share would be needed as grants).&nbsp;<br><br><b>If you could choose the level of climate finance provided by developed countries to developing countries in 2035, what would you choose?<\/b><br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\tQualtrics.SurveyEngine.setEmbeddedData(\"time_warm_glow_realism\", Date.now()\/1000);\n\tconst time_before = Qualtrics.SurveyEngine.getEmbeddedData(\"time_ics\");\n\tQualtrics.SurveyEngine.setEmbeddedData(\"duration_warm_glow_realism\", Date.now()\/1000 - time_before);\n\t\n\t\/\/ Loads CSV and create variables from the column corresponding to Q_Language\n\t$j(document).ready(function($j){\t\n\t\t$j.ajax({\n\t\t\turl:\"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_yuKEs6pwxsAid44\",\n\t\t\tsuccess: function(csv){\n\t\t\t\t\n\t\t\tconst language = Qualtrics.SurveyEngine.getEmbeddedData(\"Q_Language\"); \n\t\t\t\t\n\t\t\tconst rows = csv.split('\\n').map(row => row.split('|'));\n\t\t\tconst headers = rows[0];\n\t\t\tconst col = headers.indexOf(language);\n\n\t\t\tif (col === -1) {\n\t\t\t\tconsole.error(\"Column 'language' not found in the CSV file.\");\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t\/\/ Iterate through the rows and create variables dynamically\n\t\t\tfor (let i = 1; i < rows.length-1; i++) {\n\t\t\t\tconst name = rows[i][0]; \/\/ Assuming the row name is in the first column\n\t\t\t\tconst value = rows[i][col];\n\t\t\t\twindow[name] = value; \n\t\t\t\t$j(\"#\" + name).html(value);\n\t\t\t\tconsole.log(`Variable ${name} created with value: ${value}`);\n\t\t\t}\n\n\t\t\t\t},\n\t\t\terror: function(){ alert('Data could not be loaded');}\n\t\t});\n\t});\n});","DataExportTag":"ncqg_long","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"To ensure that you have attentively read the description below, we will ask some comprehension qu...","Choices":{"1":{"Display":"Stop all provision of climate finance."},"2":{"Display":"Increase loans (to meet the new goal of $300 billion, or 0.4% of GDP) while maintaining grants at their current level."},"3":{"Display":"Increase climate finance to a level between what developed countries have agreed and what developing countries are asking for, with at least half of climate finance in the form of grants ($200 billion in grants, 0.3% of GDP)."},"4":{"Display":"Reduce the provision of climate finance."},"5":{"Display":"Maintain current contributions ($26 billion in grants, that is 0.04% of developed countries' GDP, and $80 billion in loans, or 0.1% of GDP)."},"6":{"Display":"Increase climate finance as much as developing countries are asking for ($600 billion per year in grants, or 0.9% of GDP)."},"7":{"Display":"Increase climate finance to match what NGOs are asking for (at least $1,000 billion in grants, that is 1.4% of GDP, is what Greenpeace, Oxfam, WWF, and the World Council of Churches ask for)."}},"DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">variant_ncqg_maritime<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"variant_ncqg_maritime","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":["1","4","5","2","3","6","7"],"Randomization":{"Advanced":null,"ConsistentScaleReversal":false,"TotalRandSubset":"","Type":"ScaleReversal"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":{"AR":[],"FR":{"QuestionText":"Pour v\u00e9rifier que vous avez lu attentivement la description ci-dessous, <b>nous poserons quelques questions de compr\u00e9hension plus tard dans l'enqu\u00eate : les personnes qui r\u00e9pondent correctement peuvent gagner <span id=\"amount_lottery\">[amount_lottery: $100]<\/span><\/b>.<br \/>\n<br \/>\nLa \u00ab finance climat \u00bb d\u00e9signe le financement de l\u2019action climatique dans les pays en d\u00e9veloppement par les pays d\u00e9velopp\u00e9s. <span id=\"developed_note\">[developed_note\u00a0: (Notez que nous consid\u00e9rons l\u2019Arabie saoudite comme un pays d\u00e9velopp\u00e9 dans cette question.)]<\/span><br \/>\n<br \/>\n<b>Il existe deux types de finance climat : les subventions (c\u2019est-\u00e0-dire les dons) et les pr\u00eats. La grande majorit\u00e9 est actuellement fournie sous forme de pr\u00eats.<\/b><br \/>\n<br \/>\n<b>En 2009, les pays d\u00e9velopp\u00e9s ont convenu de mobiliser 100 milliards de dollars par an en finance climat. En 2024, ils se sont engag\u00e9s \u00e0 tripler cet objectif d\u2019ici 2035. Aucun des objectifs ne pr\u00e9cise quelle part devrait \u00eatre vers\u00e9e sous forme de subventions.<br \/>\n<br \/>\nLors des n\u00e9gociations internationales sur le climat, les pays en d\u00e9veloppement r\u00e9clament davantage de finance climat, notamment sous forme de subventions.<\/b><br \/>\n<br \/>\nGr\u00e2ce \u00e0 leurs contributions \u00e0 des institutions telles que la Banque mondiale, les pays d\u00e9velopp\u00e9s sont actuellement en bonne voie pour atteindre le nouvel objectif d\u2019ici 2035. Toutefois, les besoins pourraient \u00eatre quatre fois sup\u00e9rieurs \u00e0 l\u2019objectif convenu, selon un groupe d\u2019experts ind\u00e9pendants (qui ne pr\u00e9cise pas quelle part serait n\u00e9cessaire sous forme de subventions).<br \/>\n<br \/>\n<b>Si vous pouviez choisir le niveau de finance climat fourni par les pays d\u00e9velopp\u00e9s aux pays en d\u00e9veloppement en 2035, que choisiriez-vous ?<\/b>","Choices":{"1":{"Display":"Arr\u00eater toute contribution \u00e0 la finance climat."},"2":{"Display":"Augmenter les pr\u00eats (pour atteindre le nouvel objectif de 300 milliards de dollars, soit 0,4 % du PIB) tout en maintenant les subventions au niveau actuel."},"3":{"Display":"Augmenter la finance climat \u00e0 un niveau compris entre ce que les pays d\u00e9velopp\u00e9s ont accept\u00e9 et ce que les pays en d\u00e9veloppement demandent, avec au moins la moiti\u00e9 de la finance climat sous forme de subventions (200 milliards de dollars de subventions, soit 0,3 % du PIB)."},"4":{"Display":"R\u00e9duire les contributions \u00e0 la finance climat."},"5":{"Display":"Maintenir les contributions actuelles (26 milliards de dollars de subventions, soit 0,04 % du PIB des pays d\u00e9velopp\u00e9s, et 80 milliards de dollars de pr\u00eats, soit 0,1 % du PIB)."},"6":{"Display":"Augmenter la finance climat \u00e0 hauteur des demandes des pays en d\u00e9veloppement (600 milliards de dollars par an en subventions, soit 0,9 % du PIB)."},"7":{"Display":"Augmenter la finance climat \u00e0 hauteur de ce que demandent les ONG (au moins 1 000 milliards de dollars de subventions, soit 1,4 % du PIB, comme demand\u00e9 par Greenpeace, Oxfam, le WWF et le Conseil \u0153cum\u00e9nique des \u00c9glises)."}}},"IT-CH":[],"JA":[],"PL":{"QuestionText":"Aby upewni\u0107 si\u0119, \u017ce uwa\u017cnie przeczyta\u0142(a) Pan\/Pani poni\u017cszy opis, <b>w dalszej cz\u0119\u015bci ankiety zadamy pytania sprawdzaj\u0105ce jego zrozumienie; osoby, kt\u00f3re udziel\u0105 poprawnych odpowiedzi, mog\u0105 wygra\u0107 <span id=\"amount_lottery\">500 PLN<\/span><\/b>.<br \/>\n<br \/>\n\u201eFinansowanie klimatyczne\u201d oznacza finansowanie dzia\u0142a\u0144 na rzecz klimatu w krajach rozwijaj\u0105cych si\u0119 przez kraje rozwini\u0119te. <span id=\"developed_note\">(Prosz\u0119 wzi\u0105\u0107 pod uwag\u0119, \u017ce Polska jest klasyfikowana jako kraj rozwini\u0119ty)<\/span>.<br \/>\n<br \/>\n<b>Istniej\u0105 dwa rodzaje finansowania klimatycznego: dotacje (czyli darowizny) oraz po\u017cyczki. Obecnie znacz\u0105ca wi\u0119kszo\u015b\u0107 finansowania odbywa si\u0119 w formie po\u017cyczek.<br \/>\n<br \/>\nW 2009 r. kraje rozwini\u0119te zgodzi\u0142y si\u0119 przeznacza\u0107 100 miliard\u00f3w USD rocznie na finansowanie dzia\u0142a\u0144 na rzecz klimatu. W 2024 roku zobowi\u0105za\u0142y si\u0119 do potrojenia docelowej kwoty do roku 2035. \u017baden z cel\u00f3w nie okre\u015bla, jaki udzia\u0142 powinien by\u0107 przyznawany w formie dotacji.<\/b><br \/>\n<br \/>\n<strong>Podczas mi\u0119dzynarodowych negocjacji klimatycznych kraje rozwijaj\u0105ce si\u0119 apeluj\u0105 o zwi\u0119kszenie finansowania dzia\u0142a\u0144 klimatycznych, zw\u0142aszcza w formie dotacji.<\/strong><br \/>\n<br \/>\nPoprzez sw\u00f3j wk\u0142ad w instytucje takie jak Bank \u015awiatowy, kraje rozwini\u0119te s\u0105 obecnie na dobrej drodze do osi\u0105gni\u0119cia nowego celu do roku 2035. Jednak potrzeby mog\u0105 by\u0107 nawet czterokrotnie wy\u017csze ni\u017c uzgodniony cel, zgodnie z szacunkami niezale\u017cnej grupy ekspert\u00f3w (bez wyszczeg\u00f3lnienia, jaka kwota musia\u0142aby mie\u0107 form\u0119 dotacji).<br \/>\n<br \/>\n<br \/>\n<b>Gdyby od Pana\/Pani zale\u017ca\u0142 wyb\u00f3r poziomu finansowania klimatycznego zapewnianego krajom rozwijaj\u0105cym si\u0119 w 2035 r. przez kraje rozwini\u0119te, co by Pan\/Pani wybra\u0142(a)?<\/b>","Choices":{"1":{"Display":"Ca\u0142kowite wstrzymanie finansowania klimatycznego."},"2":{"Display":"Zwi\u0119kszenie kwoty po\u017cyczek (aby osi\u0105gn\u0105\u0107 nowy cel 300 mld USD, czyli 0,4% PKB), przy zachowaniu dotacji na obecnym poziomie."},"3":{"Display":"Zwi\u0119kszenie kwoty finansowania klimatycznego do poziomu pomi\u0119dzy tym, co uzgodni\u0142y kraje rozwini\u0119te, a tym, czego domagaj\u0105 si\u0119 kraje rozwijaj\u0105ce si\u0119, z przynajmniej po\u0142ow\u0105 finansowania w formie dotacji (200 mld USD w dotacjach, tj. 0,3% PKB)."},"4":{"Display":"Zmniejszenie kwoty finansowania klimatycznego."},"5":{"Display":"Utrzymanie obecnego poziomu finansowania (26 mld USD w postaci dotacji, tj. 0,04% PKB kraj\u00f3w rozwini\u0119tych, oraz 80 mld USD w postaci po\u017cyczek, tj. 0,1% PKB)."},"6":{"Display":"Zwi\u0119kszenie kwoty finansowania klimatycznego do poziomu, o kt\u00f3ry prosz\u0105 kraje rozwijaj\u0105ce si\u0119 (600 mld USD rocznie w dotacjach, tj. 0,9% PKB)."},"7":{"Display":"Zwi\u0119kszenie finansowania klimatycznego do poziomu, o kt\u00f3ry prosz\u0105 organizacje pozarz\u0105dowe (przynajmniej 1000 mld USD w dotacjach, tj. 1,4% PKB, jak \u017c\u0105daj\u0105 Greenpeace, Oxfam, WWF i \u015awiatowa Rada Ko\u015bcio\u0142\u00f3w)."}}},"RU":{"QuestionText":"\u0427\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c, \u0432\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043b\u0438 \u0432\u044b \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b\u0438 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u043d\u0438\u0436\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435, <b>\u0434\u0430\u043b\u0435\u0435 \u0432 \u043e\u043f\u0440\u043e\u0441\u0435 \u043c\u044b \u0437\u0430\u0434\u0430\u0434\u0438\u043c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u043d\u0430 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435: \u0442\u0435, \u043a\u0442\u043e \u0434\u0430\u0441\u0442 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0435 \u043e\u0442\u0432\u0435\u0442\u044b, \u0441\u043c\u043e\u0433\u0443\u0442 \u0432\u044b\u0438\u0433\u0440\u0430\u0442\u044c <span id=\"amount_lottery\">100 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432<\/span><\/b> .<br><br> \u041d\u0430 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u043f\u0435\u0440\u0435\u0433\u043e\u0432\u043e\u0440\u0430\u0445 \u043f\u043e \u043a\u043b\u0438\u043c\u0430\u0442\u0443 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0441\u0442\u0440\u0430\u043d\u044b \u043f\u0440\u0438\u0437\u044b\u0432\u0430\u044e\u0442 \u043a \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u044e \u00ab\u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\u00bb: \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043c\u0435\u0440 \u043f\u043e \u0431\u043e\u0440\u044c\u0431\u0435 \u0441 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c \u043a\u043b\u0438\u043c\u0430\u0442\u0430 \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0440\u0430\u0437\u0432\u0438\u0442\u044b\u0445 \u0441\u0442\u0440\u0430\u043d. <span id=\"developed_note\">(\u041e\u0431\u0440\u0430\u0442\u0438\u0442\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435, \u0447\u0442\u043e \u0432 \u044d\u0442\u043e\u043c \u0432\u043e\u043f\u0440\u043e\u0441\u0435 \u043c\u044b \u0441\u0447\u0438\u0442\u0430\u0435\u043c \u0421\u0430\u0443\u0434\u043e\u0432\u0441\u043a\u0443\u044e \u0410\u0440\u0430\u0432\u0438\u044e \u0440\u0430\u0437\u0432\u0438\u0442\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u043e\u0439.)<\/span><br><br> <b>\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0434\u0432\u0430 \u0442\u0438\u043f\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f: \u0433\u0440\u0430\u043d\u0442\u044b (\u0442\u043e \u0435\u0441\u0442\u044c \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f) \u0438 \u0437\u0430\u0439\u043c\u044b. \u0412 2022 \u0433\u043e\u0434\u0443 26 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0431\u044b\u043b\u043e \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0432 \u0432\u0438\u0434\u0435 \u0433\u0440\u0430\u043d\u0442\u043e\u0432, \u0430 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u2014 \u0432 \u0432\u0438\u0434\u0435 \u043a\u0440\u0435\u0434\u0438\u0442\u043e\u0432, \u0447\u0442\u043e \u0432 \u043e\u0431\u0449\u0435\u0439 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u043e 116 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432.<\/b><br><br> <b>\u0412 2009 \u0433\u043e\u0434\u0443 \u0440\u0430\u0437\u0432\u0438\u0442\u044b\u0435 \u0441\u0442\u0440\u0430\u043d\u044b \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438\u0441\u044c \u043c\u043e\u0431\u0438\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c 100 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0432 \u0433\u043e\u0434 \u043d\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a 2020 \u0433\u043e\u0434\u0443. \u0412 2024 \u0433\u043e\u0434\u0443 \u043e\u043d\u0438 \u043e\u0431\u044f\u0437\u0430\u043b\u0438\u0441\u044c \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u044c \u044d\u0442\u0443 \u0446\u0435\u043b\u044c \u0434\u043e 300 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u043a 2035 \u0433\u043e\u0434\u0443. \u041d\u0438 \u0432 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0446\u0435\u043b\u0435\u0439 \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e, \u043a\u0430\u043a\u0430\u044f \u0434\u043e\u043b\u044f \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u200b\u200b\u0432 \u0432\u0438\u0434\u0435 \u0433\u0440\u0430\u043d\u0442\u043e\u0432.<\/b><br><br> \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0441\u0432\u043e\u0438\u043c \u0432\u0437\u043d\u043e\u0441\u0430\u043c \u0432 \u0442\u0430\u043a\u0438\u0435 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u044b, \u043a\u0430\u043a \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u044b\u0439 \u0431\u0430\u043d\u043a, \u0440\u0430\u0437\u0432\u0438\u0442\u044b\u0435 \u0441\u0442\u0440\u0430\u043d\u044b \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u043d\u0430 \u043f\u0443\u0442\u0438 \u043a \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044e \u0446\u0435\u043b\u0438 \u0432 300 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 \u043d\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a 2035 \u0433\u043e\u0434\u0443. \u041e\u0434\u043d\u0430\u043a\u043e \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u0438 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0432 \u0447\u0435\u0442\u044b\u0440\u0435 \u0440\u0430\u0437\u0430 \u0432\u044b\u0448\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0446\u0435\u043b\u0438: \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u043e\u0432 \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u0442, \u0447\u0442\u043e 1300 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 \u043c\u043b\u0440\u0434 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 \u043d\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0432 2035 \u0433\u043e\u0434\u0443 (\u0431\u0435\u0437 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u044f \u0442\u043e\u0433\u043e, \u043a\u0430\u043a\u043e\u0439 \u043e\u0431\u044a\u0435\u043c \u0433\u0440\u0430\u043d\u0442\u043e\u0432 \u0442\u043e\u0433\u0434\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f).<br><br> \u041d\u0438\u0436\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u044b \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435 \u043f\u043e\u0437\u0438\u0446\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0431\u044a\u0435\u043c\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0432 2035 \u0433\u043e\u0434\u0443, \u0432\u0441\u0435 \u043e\u043d\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u044b \u0432 \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0435 \u0433\u0440\u0430\u043d\u0442\u043e\u0432 (\u0442.\u0435. \u0431\u0435\u0437 \u0443\u0447\u0435\u0442\u0430 \u043a\u0440\u0435\u0434\u0438\u0442\u043e\u0432):<br> - 0 \u0434\u043e\u043b\u043b. \u0421\u0428\u0410: \u0420\u0430\u0437\u0432\u0438\u0442\u044b\u0435 \u0441\u0442\u0440\u0430\u043d\u044b \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u0432\u043d\u043e\u0441\u0438\u0442\u044c \u0432\u043a\u043b\u0430\u0434 \u0432 \u0431\u043e\u0440\u044c\u0431\u0443 \u0441 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c \u043a\u043b\u0438\u043c\u0430\u0442\u0430 \u0432 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0441\u0442\u0440\u0430\u043d\u0430\u0445.<br> - 26 \u043c\u043b\u0440\u0434 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 (0,04% \u0412\u0412\u041f \u0440\u0430\u0437\u0432\u0438\u0442\u044b\u0445 \u0441\u0442\u0440\u0430\u043d): \u0442\u0435\u043a\u0443\u0449\u0430\u044f \u0441\u0443\u043c\u043c\u0430, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0430\u044f \u0441\u0442\u0430\u0440\u043e\u0439 \u0446\u0435\u043b\u0438.<br> - 100 \u043c\u043b\u0440\u0434 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 (0,14% \u0412\u0412\u041f): \u0441\u0442\u0430\u0440\u0430\u044f \u0446\u0435\u043b\u044c, \u0435\u0441\u043b\u0438 \u0431\u044b \u0432\u0441\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u043e\u0441\u044c \u0432 \u0432\u0438\u0434\u0435 \u0433\u0440\u0430\u043d\u0442\u043e\u0432.<br> - 300 \u043c\u043b\u0440\u0434 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 (0,43% \u0412\u0412\u041f): \u043d\u043e\u0432\u0430\u044f \u0446\u0435\u043b\u044c, \u0435\u0441\u043b\u0438 \u0432\u0441\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0432 \u0432\u0438\u0434\u0435 \u0433\u0440\u0430\u043d\u0442\u043e\u0432.<br> - 600 \u043c\u043b\u0440\u0434 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 (0,86% \u0412\u0412\u041f): \u0446\u0435\u043b\u044c, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u0440\u0438\u0437\u044b\u0432\u0430\u0435\u0442 \u0418\u043d\u0434\u0438\u044f, \u0438 \u043f\u043e\u0437\u0438\u0446\u0438\u044f \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0441\u0442\u0440\u0430\u043d.<br> - 1000 \u043c\u043b\u0440\u0434 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 (1,43% \u0412\u0412\u041f): \u0446\u0435\u043b\u044c, \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f Climate Action Network (\u0441\u0435\u0442\u044c\u044e \u041d\u041f\u041e, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0435\u0439 Greenpeace, Oxfam \u0438 WWF).<br> - 5000 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 (7,14% \u0412\u0412\u041f): \u0446\u0435\u043b\u044c, \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0435\u0439 Demand Climate Justice (\u0441\u0435\u0442\u044c \u041d\u041f\u041e, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0430\u044f 350.org \u0438 \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u044b\u0439 \u0441\u043e\u0432\u0435\u0442 \u0446\u0435\u0440\u043a\u0432\u0435\u0439)<br><br> <b>\u0415\u0441\u043b\u0438 \u0431\u044b \u0432\u044b \u043c\u043e\u0433\u043b\u0438 \u0432\u044b\u0431\u0440\u0430\u0442\u044c \u043e\u0431\u044a\u0435\u043c \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u044b\u043c\u0438 \u0441\u0442\u0440\u0430\u043d\u0430\u043c\u0438 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u0441\u0442\u0440\u0430\u043d\u0430\u043c \u0432 2035 \u0433\u043e\u0434\u0443, \u043a\u0430\u043a\u0443\u044e \u0441\u0443\u043c\u043c\u0443 \u0432\u044b \u0431\u044b \u0432\u044b\u0431\u0440\u0430\u043b\u0438 (\u0432 \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0435 \u0433\u0440\u0430\u043d\u0442\u0430)?<\/b><br>","Choices":{"1":{"Display":"$0"},"2":{"Display":"300 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"},"3":{"Display":"600 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"},"4":{"Display":"26 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"},"5":{"Display":"100 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"},"6":{"Display":"1000 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"},"7":{"Display":"5000 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"}}}},"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID110"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID111","SecondaryAttribute":"To ensure that you have attentively read the description below, we will ask some comprehension qu...","TertiaryAttribute":null,"Payload":{"QuestionText":"To ensure that you have attentively read the description below, <b>we will ask some comprehension questions later in the survey: those who get correct answers can win <span id=\"amount_lottery\">[amount_lottery: $100]<\/span><\/b>.<br><br>At international climate negotiations, developing countries call for larger provision of \"climate finance\": the financing of climate action from developed countries in developing countries. <span id=\"developed_note\">[developed_note: (Note that we consider Saudi Arabia to be a developed country in this question.)]<\/span><br><br><b>There are two kinds of climate finance: grants (that is, donations) and loans. In 2022, $26 billion was provided as grants and the rest as loans, for a total of $116 billion.&nbsp;<\/b><br><br><b>In 2009, developed countries agreed to mobilize $100 billion per year in climate finance by 2020. In 2024, they committed to raise this goal to $300 billion by 2035. None of the goals specify which share should be provided as grants.<\/b><br><br>Through their contributions to institutions such as the World Bank, developed countries are currently on track to meet the goal of $300 billion in climate finance by 2035. However, needs may be four times higher than the agreed goal: an independent expert group estimates that $1,300 billion of climate finance would be needed in 2035 (without specifying how much grants would then be needed).&nbsp;<br><br>Below are different positions on the amount of climate finance that should be provided in 2035, all expressed in grant-equivalent terms (that is, not counting loans):<br>-&nbsp; &nbsp; &nbsp; &nbsp; $0: There should be no contributions from developed countries to climate action in developing countries.<br>-&nbsp; &nbsp; &nbsp; $26 billion (0.04% of developed countries' GDP): The current amount, consistent with the old goal.<br>-&nbsp; &nbsp; $100 billion (0.14% of GDP): The old goal, if all climate finance were provided as grants.<br>-&nbsp; &nbsp; $300 billion (0.43% of GDP): The new goal, if all climate finance were provided as grants.<br>-&nbsp; &nbsp; $600 billion (0.86% of GDP):&nbsp;The goal called for by India, a position shared by most developing countries.<br>- $1,000 billion (1.43% of GDP): The goal called for by Climate Action Network (a network of NGOs including Greenpeace, Oxfam, and WWF).<br>- $5,000 billion (7.14% of GDP): The goal called for by Demand Climate Justice (a network of NGOs including 350.org and&nbsp;the World Council of Churches)<br><br><b>If you could choose the amount of climate finance provided by developed countries to developing countries in 2035, what amount would you choose (in grant-equivalent terms)?<\/b><br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\tQualtrics.SurveyEngine.setEmbeddedData(\"time_warm_glow_realism\", Date.now()\/1000);\n\tconst time_before = Qualtrics.SurveyEngine.getEmbeddedData(\"time_ics\");\n\tQualtrics.SurveyEngine.setEmbeddedData(\"duration_warm_glow_realism\", Date.now()\/1000 - time_before);\n\t\n\t\/\/ Loads CSV and create variables from the column corresponding to Q_Language\n\t$j(document).ready(function($j){\t\n\t\t$j.ajax({\n\t\t\turl:\"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_yuKEs6pwxsAid44\",\n\t\t\tsuccess: function(csv){\n\t\t\t\t\n\t\t\tconst language = Qualtrics.SurveyEngine.getEmbeddedData(\"Q_Language\"); \n\t\t\t\t\n\t\t\tconst rows = csv.split('\\n').map(row => row.split('|'));\n\t\t\tconst headers = rows[0];\n\t\t\tconst col = headers.indexOf(language);\n\n\t\t\tif (col === -1) {\n\t\t\t\tconsole.error(\"Column 'language' not found in the CSV file.\");\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t\/\/ Iterate through the rows and create variables dynamically\n\t\t\tfor (let i = 1; i < rows.length-1; i++) {\n\t\t\t\tconst name = rows[i][0]; \/\/ Assuming the row name is in the first column\n\t\t\t\tconst value = rows[i][col];\n\t\t\t\twindow[name] = value; \n\t\t\t\t$j(\"#\" + name).html(value);\n\t\t\t\tconsole.log(`Variable ${name} created with value: ${value}`);\n\t\t\t}\n\n\t\t\t\t},\n\t\t\terror: function(){ alert('Data could not be loaded');}\n\t\t});\n\t});\n});","DataExportTag":"ncqg_full_long","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"To ensure that you have attentively read the description below, we will ask some comprehension qu...","Choices":{"1":{"Display":"$0"},"2":{"Display":"$300 billion"},"3":{"Display":"$600 billion"},"4":{"Display":"$26 billion"},"5":{"Display":"$100 billion"},"6":{"Display":"$1,000 billion"},"7":{"Display":"$5,000 billion"}},"DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">variant_ncqg_maritime<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 2 <\/span>","LeftOperand":"variant_ncqg_maritime","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"2","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":["1","4","5","2","3","6","7"],"Randomization":{"Advanced":null,"ConsistentScaleReversal":false,"TotalRandSubset":"","Type":"None"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":{"AR":[],"FR":{"QuestionText":"Pour v\u00e9rifier que vous avez lu attentivement la description ci-dessous, <b>nous poserons quelques questions de compr\u00e9hension plus tard dans l'enqu\u00eate : les personnes qui r\u00e9pondent correctement peuvent gagner <span id=\"amount_lottery\">[amount_lottery: $100]<\/span><\/b>.<br \/>\n<br \/>\nLors des n\u00e9gociations internationales sur le climat, les pays en d\u00e9veloppement r\u00e9clament davantage de \u00ab finance climat \u00bb : le financement de l\u2019action climatique par les pays d\u00e9velopp\u00e9s dans les pays en d\u00e9veloppement. <span id=\"developed_note\">[developed_note\u00a0: (Notez que nous consid\u00e9rons l\u2019Arabie saoudite comme un pays d\u00e9velopp\u00e9 dans cette question.)]<\/span><br \/>\n<br \/>\n<b>Il existe deux types de finance climat : les subventions (c\u2019est-\u00e0-dire les dons) et les pr\u00eats. En 2022, 26 milliards de dollars ont \u00e9t\u00e9 accord\u00e9s sous forme de subventions et le reste sous forme de pr\u00eats, pour un total de 116 milliards de dollars.<\/b><br \/>\n<br \/>\n<b>En 2009, les pays d\u00e9velopp\u00e9s ont convenu de mobiliser 100 milliards de dollars par an en finance climat d\u2019ici 2020. En 2024, ils se sont engag\u00e9s \u00e0 porter cet objectif \u00e0 300 milliards de dollars d\u2019ici 2035. Aucun de ces objectifs ne pr\u00e9cise quelle part devrait \u00eatre vers\u00e9e sous forme de subventions.<\/b><br \/>\n<br \/>\nGr\u00e2ce \u00e0 leurs contributions \u00e0 des institutions comme la Banque mondiale, les pays d\u00e9velopp\u00e9s sont actuellement en bonne voie pour atteindre l\u2019objectif de 300 milliards de dollars de finance climat d\u2019ici 2035. Cependant, les besoins pourraient \u00eatre quatre fois sup\u00e9rieurs \u00e0 l\u2019objectif convenu : un groupe d\u2019experts ind\u00e9pendants estime que 1 300 milliards de dollars de financement climatique seraient n\u00e9cessaires en 2035 (sans pr\u00e9ciser le montant des subventions qui seraient alors n\u00e9cessaires).<br \/>\n<br \/>\nVous trouverez ci-dessous diff\u00e9rentes positions sur le montant de finance climat qui devrait \u00eatre fourni en 2035, toutes exprim\u00e9es en termes d'\u00e9quivalent-subvention (c'est-\u00e0-dire sans compter les pr\u00eats) :<br \/>\n- 0\u00a0: Les pays d\u00e9velopp\u00e9s ne devraient pas contribuer \u00e0 l\u2019action climatique dans les pays en d\u00e9veloppement.<br \/>\n- 26 milliards de dollars (0,04 % du PIB des pays d\u00e9velopp\u00e9s) : le montant actuel, coh\u00e9rent avec l\u2019ancien objectif.<br \/>\n- 100 milliards de dollars (0,14 % du PIB) : l\u2019ancien objectif, si tous les financements climatiques \u00e9taient fournis sous forme de subventions.<br \/>\n- 300 milliards de dollars (0,43 % du PIB) : le nouvel objectif, si tous les financements climatiques \u00e9taient fournis sous forme de subventions.<br \/>\n- 600 milliards de dollars (0,86 % du PIB) : l\u2019objectif r\u00e9clam\u00e9 par l\u2019Inde, une position partag\u00e9e par la plupart des pays en d\u00e9veloppement.<br \/>\n- 1 000 milliards de dollars (1,43 % du PIB) : l\u2019objectif r\u00e9clam\u00e9 par le Climate Action Network (un r\u00e9seau d\u2019ONG comprenant Greenpeace, Oxfam et WWF).<br \/>\n- 5 000 milliards de dollars (7,14 % du PIB) : l'objectif r\u00e9clam\u00e9 par Demand Climate Justice (un r\u00e9seau d'ONG comprenant 350.org et le Conseil \u0153cum\u00e9nique des \u00c9glises)<br \/>\n<br \/>\n<b>Si vous pouviez choisir le montant du financement climatique fourni par les pays d\u00e9velopp\u00e9s aux pays en d\u00e9veloppement en 2035, quel montant choisiriez-vous (en termes d\u2019\u00e9quivalent-subvention) ?<\/b>","Choices":{"1":{"Display":"0\u00a0$"},"2":{"Display":"300 milliards de dollars"},"3":{"Display":"600 milliards de dollars"},"4":{"Display":"26 milliards de dollars"},"5":{"Display":"100 milliards de dollars"},"6":{"Display":"1 000 milliards de dollars"},"7":{"Display":"5 000 milliards de dollars"}}},"IT-CH":[],"JA":[],"PL":{"QuestionText":"Aby upewni\u0107 si\u0119, \u017ce uwa\u017cnie przeczyta\u0142(a) Pan\/Pani poni\u017cszy opis, <b>w dalszej cz\u0119\u015bci ankiety zadamy pytania sprawdzaj\u0105ce jego zrozumienie; osoby, kt\u00f3re udziel\u0105 poprawnych odpowiedzi, mog\u0105 wygra\u0107 <span id=\"amount_lottery\">500 PLN<\/span><\/b>.<br \/>\n<br \/>\nPodczas mi\u0119dzynarodowych negocjacji klimatycznych kraje rozwijaj\u0105ce si\u0119 domagaj\u0105 si\u0119 zapewnienia wi\u0119kszego \u201efinansowania klimatycznego\u201d: finansowania dzia\u0142a\u0144 na rzecz klimatu ze strony kraj\u00f3w rozwini\u0119tych. <span id=\"developed_note\">(Prosz\u0119 wzi\u0105\u0107 pod uwag\u0119, \u017ce Polska jest klasyfikowana jako kraj rozwini\u0119ty)<\/span>.<br \/>\n<br \/>\n<b>Istniej\u0105 dwa rodzaje finansowania klimatycznego: dotacje (czyli darowizny) i po\u017cyczki. W 2022 r. przekazano \u0142\u0105cznie 116 miliard\u00f3w USD, z czego 26 miliard\u00f3w stanowi\u0142y dotacje, a reszt\u0119 - po\u017cyczki.<\/b><br \/>\n<br \/>\n<b>W 2009 r. kraje rozwini\u0119te zgodzi\u0142y si\u0119 na uruchomienie do 2020 roku 100 miliard\u00f3w USD rocznie na finansowanie dzia\u0142a\u0144 na rzecz klimatu. W 2024 roku zobowi\u0105za\u0142y si\u0119 do podniesienia tego celu do 300 miliard\u00f3w USD do roku 2035. \u017baden z cel\u00f3w nie okre\u015bla, jaki udzia\u0142 powinien by\u0107 przyznawany w formie dotacji.<\/b><br \/>\n<br \/>\nPoprzez sw\u00f3j wk\u0142ad w instytucje takie jak Bank \u015awiatowy, kraje rozwini\u0119te s\u0105 obecnie na dobrej drodze do osi\u0105gni\u0119cia celu w wysoko\u015bci 300 miliard\u00f3w USD na finansowanie klimatu do roku 2035. Jednak potrzeby mog\u0105 by\u0107 nawet czterokrotnie wy\u017csze ni\u017c uzgodniony cel; niezale\u017cna grupa ekspert\u00f3w oszacowa\u0142a, \u017ce w 2035 r. niezb\u0119dne b\u0119dzie finansowanie klimatyczne na kwot\u0119 1300 miliard\u00f3w USD (bez wyszczeg\u00f3lnienia, ile dotacji by\u0142oby w\u00f3wczas potrzebnych).<br \/>\n<br \/>\nPoni\u017cej przedstawiono r\u00f3\u017cne stanowiska dotycz\u0105ce kwoty finansowania klimatycznego, kt\u00f3ra powinna zosta\u0107 przekazana w 2035 r., wszystkie wyra\u017cone w ekwiwalentach dotacji (tzn. nie licz\u0105c po\u017cyczek):<br \/>\n- 0 USD: kraje rozwini\u0119te nie powinny wnosi\u0107 \u017cadnego wk\u0142adu w dzia\u0142ania na rzecz klimatu w krajach rozwijaj\u0105cych si\u0119.<br \/>\n- 26 miliard\u00f3w USD (0,04% PKB kraj\u00f3w rozwini\u0119tych): aktualna kwota, zgodna ze starym celem.<br \/>\n- 100 miliard\u00f3w USD (0,14% PKB): stary cel, je\u015bli ca\u0142e finansowanie klimatyczne by\u0142oby zapewniane w formie dotacji.<br \/>\n- 300 miliard\u00f3w USD (0,43% PKB): nowy cel, je\u015bli ca\u0142e finansowanie klimatyczne by\u0142oby zapewniane w formie dotacji.<br \/>\n- 600 miliard\u00f3w USD (0,86% PKB): cel, kt\u00f3rego domagaj\u0105 si\u0119 Indie; stanowisko podzielane przez wi\u0119kszo\u015b\u0107 kraj\u00f3w rozwijaj\u0105cych si\u0119.<br \/>\n- 1000 miliard\u00f3w USD (1,43% PKB): cel, kt\u00f3rego domaga si\u0119 Climate Action Network (sie\u0107 organizacji pozarz\u0105dowych, zrzeszaj\u0105ca m.in. Greenpeace, Oxfam i WWF).<br \/>\n- 5000 miliard\u00f3w USD (7,14% PKB): cel, kt\u00f3rego domaga si\u0119 Demand Climate Justice (sie\u0107 organizacji pozarz\u0105dowych, zrzeszaj\u0105ca m.in. 350.org i \u015awiatow\u0105 Rad\u0119 Ko\u015bcio\u0142\u00f3w)<br \/>\n<br \/>\n<b>Gdyby od Pana\/Pani zale\u017ca\u0142 wyb\u00f3r kwoty finansowania klimatycznego zapewnianego krajom rozwijaj\u0105cym si\u0119 w 2035 r. przez kraje rozwini\u0119te, jak\u0105 kwot\u0119 by Pan\/Pani wybra\u0142(a) (w przeliczeniu na ekwiwalent dotacji)?<\/b>","Choices":{"1":{"Display":"0 USD"},"2":{"Display":"300 mld USD"},"3":{"Display":"600 mld USD"},"4":{"Display":"26 mld USD"},"5":{"Display":"100 mld USD"},"6":{"Display":"1000 mld USD"},"7":{"Display":"5000 mld USD"}}},"RU":{"QuestionText":"\u0427\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c, \u0432\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043b\u0438 \u0432\u044b \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u043b\u0438 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u043d\u0438\u0436\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435, <b>\u0434\u0430\u043b\u0435\u0435 \u0432 \u043e\u043f\u0440\u043e\u0441\u0435 \u043c\u044b \u0437\u0430\u0434\u0430\u0434\u0438\u043c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u043d\u0430 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435: \u0442\u0435, \u043a\u0442\u043e \u0434\u0430\u0441\u0442 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0435 \u043e\u0442\u0432\u0435\u0442\u044b, \u0441\u043c\u043e\u0433\u0443\u0442 \u0432\u044b\u0438\u0433\u0440\u0430\u0442\u044c <span id=\"amount_lottery\">100 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432<\/span><\/b> .<br><br> \u041d\u0430 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u043f\u0435\u0440\u0435\u0433\u043e\u0432\u043e\u0440\u0430\u0445 \u043f\u043e \u043a\u043b\u0438\u043c\u0430\u0442\u0443 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0441\u0442\u0440\u0430\u043d\u044b \u043f\u0440\u0438\u0437\u044b\u0432\u0430\u044e\u0442 \u043a \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u0438\u044e \u00ab\u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f\u00bb: \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043c\u0435\u0440 \u043f\u043e \u0431\u043e\u0440\u044c\u0431\u0435 \u0441 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c \u043a\u043b\u0438\u043c\u0430\u0442\u0430 \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0440\u0430\u0437\u0432\u0438\u0442\u044b\u0445 \u0441\u0442\u0440\u0430\u043d. <span id=\"developed_note\">(\u041e\u0431\u0440\u0430\u0442\u0438\u0442\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435, \u0447\u0442\u043e \u0432 \u044d\u0442\u043e\u043c \u0432\u043e\u043f\u0440\u043e\u0441\u0435 \u043c\u044b \u0441\u0447\u0438\u0442\u0430\u0435\u043c \u0421\u0430\u0443\u0434\u043e\u0432\u0441\u043a\u0443\u044e \u0410\u0440\u0430\u0432\u0438\u044e \u0440\u0430\u0437\u0432\u0438\u0442\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u043e\u0439.)<\/span><br><br> <b>\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u0434\u0432\u0430 \u0442\u0438\u043f\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f: \u0433\u0440\u0430\u043d\u0442\u044b (\u0442\u043e \u0435\u0441\u0442\u044c \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f) \u0438 \u0437\u0430\u0439\u043c\u044b. \u0412 2022 \u0433\u043e\u0434\u0443 26 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0431\u044b\u043b\u043e \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0432 \u0432\u0438\u0434\u0435 \u0433\u0440\u0430\u043d\u0442\u043e\u0432, \u0430 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u2014 \u0432 \u0432\u0438\u0434\u0435 \u043a\u0440\u0435\u0434\u0438\u0442\u043e\u0432, \u0447\u0442\u043e \u0432 \u043e\u0431\u0449\u0435\u0439 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u043e 116 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432.<\/b><br><br> <b>\u0412 2009 \u0433\u043e\u0434\u0443 \u0440\u0430\u0437\u0432\u0438\u0442\u044b\u0435 \u0441\u0442\u0440\u0430\u043d\u044b \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0438\u0441\u044c \u043c\u043e\u0431\u0438\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c 100 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0432 \u0433\u043e\u0434 \u043d\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a 2020 \u0433\u043e\u0434\u0443. \u0412 2024 \u0433\u043e\u0434\u0443 \u043e\u043d\u0438 \u043e\u0431\u044f\u0437\u0430\u043b\u0438\u0441\u044c \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442\u044c \u044d\u0442\u0443 \u0446\u0435\u043b\u044c \u0434\u043e 300 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u043a 2035 \u0433\u043e\u0434\u0443. \u041d\u0438 \u0432 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u0446\u0435\u043b\u0435\u0439 \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e, \u043a\u0430\u043a\u0430\u044f \u0434\u043e\u043b\u044f \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u200b\u200b\u0432 \u0432\u0438\u0434\u0435 \u0433\u0440\u0430\u043d\u0442\u043e\u0432.<\/b><br><br> \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0441\u0432\u043e\u0438\u043c \u0432\u0437\u043d\u043e\u0441\u0430\u043c \u0432 \u0442\u0430\u043a\u0438\u0435 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442\u044b, \u043a\u0430\u043a \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u044b\u0439 \u0431\u0430\u043d\u043a, \u0440\u0430\u0437\u0432\u0438\u0442\u044b\u0435 \u0441\u0442\u0440\u0430\u043d\u044b \u0432 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0435\u0435 \u0432\u0440\u0435\u043c\u044f \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f \u043d\u0430 \u043f\u0443\u0442\u0438 \u043a \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044e \u0446\u0435\u043b\u0438 \u0432 300 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 \u043d\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043a 2035 \u0433\u043e\u0434\u0443. \u041e\u0434\u043d\u0430\u043a\u043e \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u0438 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0432 \u0447\u0435\u0442\u044b\u0440\u0435 \u0440\u0430\u0437\u0430 \u0432\u044b\u0448\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0446\u0435\u043b\u0438: \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u0430\u044f \u0433\u0440\u0443\u043f\u043f\u0430 \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u043e\u0432 \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u0442, \u0447\u0442\u043e 1300 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 \u043c\u043b\u0440\u0434 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 \u043d\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0432 2035 \u0433\u043e\u0434\u0443 (\u0431\u0435\u0437 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u044f \u0442\u043e\u0433\u043e, \u043a\u0430\u043a\u043e\u0439 \u043e\u0431\u044a\u0435\u043c \u0433\u0440\u0430\u043d\u0442\u043e\u0432 \u0442\u043e\u0433\u0434\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f).<br><br> \u041d\u0438\u0436\u0435 \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u044b \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435 \u043f\u043e\u0437\u0438\u0446\u0438\u0438 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0431\u044a\u0435\u043c\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0432 2035 \u0433\u043e\u0434\u0443, \u0432\u0441\u0435 \u043e\u043d\u0438 \u0432\u044b\u0440\u0430\u0436\u0435\u043d\u044b \u0432 \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0435 \u0433\u0440\u0430\u043d\u0442\u043e\u0432 (\u0442.\u0435. \u0431\u0435\u0437 \u0443\u0447\u0435\u0442\u0430 \u043a\u0440\u0435\u0434\u0438\u0442\u043e\u0432):<br> - 0 \u0434\u043e\u043b\u043b. \u0421\u0428\u0410: \u0420\u0430\u0437\u0432\u0438\u0442\u044b\u0435 \u0441\u0442\u0440\u0430\u043d\u044b \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u0432\u043d\u043e\u0441\u0438\u0442\u044c \u0432\u043a\u043b\u0430\u0434 \u0432 \u0431\u043e\u0440\u044c\u0431\u0443 \u0441 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435\u043c \u043a\u043b\u0438\u043c\u0430\u0442\u0430 \u0432 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0441\u0442\u0440\u0430\u043d\u0430\u0445.<br> - 26 \u043c\u043b\u0440\u0434 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 (0,04% \u0412\u0412\u041f \u0440\u0430\u0437\u0432\u0438\u0442\u044b\u0445 \u0441\u0442\u0440\u0430\u043d): \u0442\u0435\u043a\u0443\u0449\u0430\u044f \u0441\u0443\u043c\u043c\u0430, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0430\u044f \u0441\u0442\u0430\u0440\u043e\u0439 \u0446\u0435\u043b\u0438.<br> - 100 \u043c\u043b\u0440\u0434 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 (0,14% \u0412\u0412\u041f): \u0441\u0442\u0430\u0440\u0430\u044f \u0446\u0435\u043b\u044c, \u0435\u0441\u043b\u0438 \u0431\u044b \u0432\u0441\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u043e\u0441\u044c \u0432 \u0432\u0438\u0434\u0435 \u0433\u0440\u0430\u043d\u0442\u043e\u0432.<br> - 300 \u043c\u043b\u0440\u0434 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 (0,43% \u0412\u0412\u041f): \u043d\u043e\u0432\u0430\u044f \u0446\u0435\u043b\u044c, \u0435\u0441\u043b\u0438 \u0432\u0441\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u0432 \u0432\u0438\u0434\u0435 \u0433\u0440\u0430\u043d\u0442\u043e\u0432.<br> - 600 \u043c\u043b\u0440\u0434 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 (0,86% \u0412\u0412\u041f): \u0446\u0435\u043b\u044c, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u0440\u0438\u0437\u044b\u0432\u0430\u0435\u0442 \u0418\u043d\u0434\u0438\u044f, \u0438 \u043f\u043e\u0437\u0438\u0446\u0438\u044f \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0438\u0445\u0441\u044f \u0441\u0442\u0440\u0430\u043d.<br> - 1000 \u043c\u043b\u0440\u0434 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410 (1,43% \u0412\u0412\u041f): \u0446\u0435\u043b\u044c, \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f Climate Action Network (\u0441\u0435\u0442\u044c\u044e \u041d\u041f\u041e, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0435\u0439 Greenpeace, Oxfam \u0438 WWF).<br> - 5000 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 (7,14% \u0412\u0412\u041f): \u0446\u0435\u043b\u044c, \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0435\u0439 Demand Climate Justice (\u0441\u0435\u0442\u044c \u041d\u041f\u041e, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0449\u0430\u044f 350.org \u0438 \u0412\u0441\u0435\u043c\u0438\u0440\u043d\u044b\u0439 \u0441\u043e\u0432\u0435\u0442 \u0446\u0435\u0440\u043a\u0432\u0435\u0439)<br><br> <b>\u0415\u0441\u043b\u0438 \u0431\u044b \u0432\u044b \u043c\u043e\u0433\u043b\u0438 \u0432\u044b\u0431\u0440\u0430\u0442\u044c \u043e\u0431\u044a\u0435\u043c \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u043c\u043e\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u044b\u043c\u0438 \u0441\u0442\u0440\u0430\u043d\u0430\u043c\u0438 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u0441\u0442\u0440\u0430\u043d\u0430\u043c \u0432 2035 \u0433\u043e\u0434\u0443, \u043a\u0430\u043a\u0443\u044e \u0441\u0443\u043c\u043c\u0443 \u0432\u044b \u0431\u044b \u0432\u044b\u0431\u0440\u0430\u043b\u0438 (\u0432 \u044d\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0435 \u0433\u0440\u0430\u043d\u0442\u0430)?<\/b><br>","Choices":{"1":{"Display":"$0"},"2":{"Display":"300 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"},"3":{"Display":"600 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"},"4":{"Display":"26 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"},"5":{"Display":"100 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"},"6":{"Display":"1000 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"},"7":{"Display":"5000 \u043c\u0438\u043b\u043b\u0438\u0430\u0440\u0434\u043e\u0432 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"}}}},"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID111"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID112","SecondaryAttribute":"Consider two possible scenarios for the world for the next 20 years.\u00a0 Scenario A: Most countries...","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Consider two possible scenarios for the world for the next 20 years.&nbsp;<br><br>Scenario A<\/b>: <br>Most countries implement coordinated policies to limit global warming to +2\u00b0C and reduce inequality. The world greatly reduces greenhouse gas emissions and is on track to meet its climate target. Taxes on millionaires fund the installation of heat pumps, the thermal insulation of buildings, and improved public transportation. Yachts and private jets are phased out worldwide. Cars are all electric by 2045, and they are about the same price as internal combustion cars nowadays. By 2045, environmental regulations progressively double the price of beef, heating fuel or gas, and air travel. As a result, people fly half as much, eat half as much meat, and use more public transportation in 2045 than they did in 2025. Despite higher prices for polluting goods, the overall purchasing power is preserved, thanks to a decrease in sales tax that reduces the prices of non-polluting goods.<br><br><b>Scenario B<\/b>:<br>Since 2025, no additional policies are implemented to address climate change or inequality. People maintain the same lifestyles as in 2025. For example, most people continue to drive cars with internal combustion engines. Greenhouse gas emissions are stable. Global warming is expected to reach +3\u00b0C by 2100 and higher levels beyond that date. A warmer climate is causing more frequent and more severe droughts, heatwaves, wildfires, and coastal floodings.<br><br>Apart from the elements described, the two scenarios are the same (for example, in terms of unemployment or crime). <br><br><b>Which scenario do you prefer for the future?<\/b>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\tQualtrics.SurveyEngine.setEmbeddedData(\"time_preferred_transfer_mean\", Date.now()\/1000);\n\tconst time_before = Qualtrics.SurveyEngine.getEmbeddedData(\"time_wealth_tax\");\n\tQualtrics.SurveyEngine.setEmbeddedData(\"duration_preferred_transfer_mean\", Date.now()\/1000 - time_before);\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DataExportTag":"sustainable_future_s","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Consider two possible scenarios for the world for the next 20 years.\u00a0 Scenario A: Most countries...","Choices":{"1":{"Display":"Scenario A"},"2":{"Display":"Scenario B"}},"DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">variant_radical_redistr<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 0 <\/span>","LeftOperand":"variant_radical_redistr","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"0","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":{"AR":[],"FR":{"QuestionText":"<b>Consid\u00e9rez deux sc\u00e9narios possibles pour le monde dans les 20 prochaines ann\u00e9es.<br \/>\n<br \/>\nSc\u00e9nario A<\/b> :<br \/>\nLa plupart des pays mettent en \u0153uvre des politiques coordonn\u00e9es pour limiter le r\u00e9chauffement climatique \u00e0 +2\u00b0C et r\u00e9duire les in\u00e9galit\u00e9s. Le monde r\u00e9duit consid\u00e9rablement les \u00e9missions de gaz \u00e0 effet de serre et est en bonne voie pour atteindre l'objectif climatique. Des imp\u00f4ts sur les millionnaires financent l\u2019installation de pompes \u00e0 chaleur, l\u2019isolation thermique des b\u00e2timents et l\u2019am\u00e9lioration des transports publics. Les yachts et les jets priv\u00e9s sont progressivement supprim\u00e9s dans le monde entier. Les voitures sont enti\u00e8rement \u00e9lectriques d\u2019ici 2045 et co\u00fbtent \u00e0 peu pr\u00e8s le m\u00eame prix que les voitures thermiques d\u2019aujourd\u2019hui. D\u2019ici 2045, les r\u00e9glementations environnementales multiplient progressivement par deux le prix du b\u0153uf, du fioul ou du gaz de chauffage, et du transport a\u00e9rien. En cons\u00e9quence, les gens prennent l\u2019avion deux fois moins souvent, mangent deux fois moins de viande et utilisent davantage les transports en commun en 2045 qu\u2019en 2025. Malgr\u00e9 des prix plus \u00e9lev\u00e9s pour les biens polluants, le pouvoir d\u2019achat g\u00e9n\u00e9ral est pr\u00e9serv\u00e9, gr\u00e2ce \u00e0 une baisse de la TVA qui r\u00e9duit les prix des biens non polluants.<br \/>\n<br \/>\n<b>Sc\u00e9nario B<\/b> :<br \/>\nDepuis 2025, aucune mesure suppl\u00e9mentaire n\u2019est mise en \u0153uvre pour lutter contre le changement climatique ou les in\u00e9galit\u00e9s. Les gens maintiennent le m\u00eame mode de vie qu\u2019en 2025. Par exemple, la plupart des gens continuent de conduire des voitures thermiques. Les \u00e9missions de gaz \u00e0 effet de serre sont stables. Le r\u00e9chauffement climatique devrait atteindre +3\u00b0C d\u2019ici 2100 et des niveaux plus \u00e9lev\u00e9s au-del\u00e0 de cette date. Le changement climatique entra\u00eene des s\u00e9cheresses, des vagues de chaleur, des incendies de for\u00eat et des inondations c\u00f4ti\u00e8res plus fr\u00e9quents et plus graves.<br \/>\n<br \/>\nHormis les \u00e9l\u00e9ments d\u00e9crits, les deux sc\u00e9narios sont identiques (par exemple, en termes de ch\u00f4mage ou de criminalit\u00e9).<br \/>\n<br \/>\n<b>Quel sc\u00e9nario pr\u00e9f\u00e9rez-vous pour l\u2019avenir ?<\/b>","Choices":{"1":{"Display":"Sc\u00e9nario\u00a0A"},"2":{"Display":"Sc\u00e9nario B"}}},"IT-CH":[],"JA":[],"PL":{"QuestionText":"<strong>Rozwa\u017cmy teraz dwa mo\u017cliwe scenariusze dla sytuacji na \u015bwiecie w najbli\u017cszych 20 latach.<\/strong><br \/>\n<br \/>\n<strong>Scenariusz A:<\/strong><br \/>\nWi\u0119kszo\u015b\u0107 kraj\u00f3w wdra\u017ca skoordynowan\u0105 polityk\u0119 w celu ograniczenia globalnego ocieplenia do +2\u00b0C i zmniejszenia nier\u00f3wno\u015bci. \u015awiat znacznie zmniejsza emisj\u0119 gaz\u00f3w cieplarnianych i jest na dobrej drodze do osi\u0105gni\u0119cia celu klimatycznego. Podatki od milioner\u00f3w finansuj\u0105 instalacj\u0119 pomp ciep\u0142a, izolacj\u0119 ciepln\u0105 budynk\u00f3w i popraw\u0119 transportu publicznego. Jachty i prywatne odrzutowce s\u0105 stopniowo wycofywane na ca\u0142ym \u015bwiecie. Samochody s\u0105 ca\u0142kowicie elektryczne do 2045 roku i kosztuj\u0105 tyle samo co samochody spalinowe. Do roku 2045 przepisy ochrony \u015brodowiska stopniowo powoduj\u0105, \u017ce ceny wo\u0142owiny, paliwa grzewczego lub gazu, a tak\u017ce cena podr\u00f3\u017cy lotniczych, wzrastaj\u0105 dwukrotnie. W rezultacie w 2045 r. ludzie lataj\u0105 o po\u0142ow\u0119 mniej, jedz\u0105 o po\u0142ow\u0119 mniej mi\u0119sa i cz\u0119\u015bciej korzystaj\u0105 z transportu publicznego ni\u017c w 2025. Pomimo wy\u017cszych cen za towary generuj\u0105ce zanieczyszczenia, og\u00f3lna si\u0142a nabywcza jest zachowana dzi\u0119ki zmniejszeniu podatku od sprzeda\u017cy, kt\u00f3ry obni\u017ca ceny towar\u00f3w niezanieczyszczaj\u0105cych \u015brodowiska.<br \/>\n<br \/>\n<strong>Scenariusz B:<\/strong><br \/>\nOd 2025 r. nie wdro\u017cono \u017cadnych dodatkowych inicjatyw w celu przeciwdzia\u0142ania zmianom klimatycznym ani nier\u00f3wno\u015bciom. Ludzie zachowuj\u0105 ten sam styl \u017cycia, co w 2025 roku. Na przyk\u0142ad, wi\u0119kszo\u015b\u0107 ludzi nadal prowadzi samochody z silnikami spalinowymi. Emisja gaz\u00f3w cieplarnianych jest stabilna. Oczekuje si\u0119, \u017ce globalne ocieplenie osi\u0105gnie +3\u00b0C do 2100 r. i wy\u017csze poziomy po tej dacie. Cieplejszy klimat powoduje cz\u0119stsze i powa\u017cniejsze susze, fale upa\u0142\u00f3w, po\u017cary i powodzie w strefach przybrze\u017cnych.<br \/>\n<br \/>\nPoza opisanymi elementami oba scenariusze s\u0105 takie same (na przyk\u0142ad pod wzgl\u0119dem bezrobocia lub przest\u0119pczo\u015bci).<br \/>\n<br \/>\n<strong>Kt\u00f3ry scenariusz bardziej Panu\/Pani odpowiada?<\/strong>","Choices":{"1":{"Display":"Scenariusz A"},"2":{"Display":"Scenariusz B"}}},"RU":{"QuestionText":"<b>\u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c \u0434\u0432\u0430 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u044f \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0441\u043e\u0431\u044b\u0442\u0438\u0439 \u0432 \u043c\u0438\u0440\u0435 \u043d\u0430 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u0435 20 \u043b\u0435\u0442.<br><br> \u0421\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u0410<\/b> :<br> \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0441\u0442\u0440\u0430\u043d \u0440\u0435\u0430\u043b\u0438\u0437\u0443\u044e\u0442 \u0441\u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0443 \u043f\u043e \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044e \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u0442\u0435\u043f\u043b\u0435\u043d\u0438\u044f +2\u00b0C \u0438 \u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u044e \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430. \u041c\u0438\u0440 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0441\u043e\u043a\u0440\u0430\u0449\u0430\u0435\u0442 \u0432\u044b\u0431\u0440\u043e\u0441\u044b \u043f\u0430\u0440\u043d\u0438\u043a\u043e\u0432\u044b\u0445 \u0433\u0430\u0437\u043e\u0432 \u0438 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043d\u0430 \u043f\u0443\u0442\u0438 \u043a \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044e \u0441\u0432\u043e\u0438\u0445 \u043a\u043b\u0438\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0446\u0435\u043b\u0435\u0439. \u041d\u0430\u043b\u043e\u0433\u0438 \u0441 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u0435\u0440\u043e\u0432 \u0438\u0434\u0443\u0442 \u043d\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0442\u0435\u043f\u043b\u043e\u0432\u044b\u0445 \u043d\u0430\u0441\u043e\u0441\u043e\u0432, \u0442\u0435\u043f\u043b\u043e\u0438\u0437\u043e\u043b\u044f\u0446\u0438\u0438 \u0437\u0434\u0430\u043d\u0438\u0439 \u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0430. \u0412\u043e \u0432\u0441\u0435\u043c \u043c\u0438\u0440\u0435 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e \u0432\u044b\u0432\u043e\u0434\u044f\u0442\u0441\u044f \u0438\u0437 \u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0430\u0446\u0438\u0438 \u044f\u0445\u0442\u044b \u0438 \u0447\u0430\u0441\u0442\u043d\u044b\u0435 \u0441\u0430\u043c\u043e\u043b\u0435\u0442\u044b. \u041a 2045 \u0433\u043e\u0434\u0443 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0438 \u0431\u0443\u0434\u0443\u0442 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u043c\u0438, \u0438 \u0438\u0445 \u0446\u0435\u043d\u0430 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u0442\u0430\u043a\u043e\u0439 \u0436\u0435, \u043a\u0430\u043a \u0443 \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0435\u0439 \u0441 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0435\u043c \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u0441\u0433\u043e\u0440\u0430\u043d\u0438\u044f. \u041a 2045 \u0433\u043e\u0434\u0443 \u044d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043d\u043e\u0440\u043c\u044b \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0430\u0442 \u0446\u0435\u043d\u044b \u043d\u0430 \u0433\u043e\u0432\u044f\u0434\u0438\u043d\u0443 \u043d\u0430 75%, \u043d\u0430 \u0442\u043e\u043f\u043b\u0438\u0432\u043e \u0434\u043b\u044f \u043e\u0442\u043e\u043f\u043b\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0433\u0430\u0437 \u2014 \u043d\u0430 40%, \u0430 \u043d\u0430 \u0430\u0432\u0438\u0430\u043f\u0435\u0440\u0435\u043b\u0435\u0442\u044b \u2014 \u043d\u0430 30%. \u0412 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0435 \u0432 2045 \u0433\u043e\u0434\u0443 \u043b\u044e\u0434\u0438 \u0431\u0443\u0434\u0443\u0442 \u043b\u0435\u0442\u0430\u0442\u044c \u0432\u0434\u0432\u043e\u0435 \u043c\u0435\u043d\u044c\u0448\u0435, \u0435\u0441\u0442\u044c \u0432\u0434\u0432\u043e\u0435 \u043c\u0435\u043d\u044c\u0448\u0435 \u043c\u044f\u0441\u0430 \u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u043e\u043c \u0431\u043e\u043b\u044c\u0448\u0435, \u0447\u0435\u043c \u0432 2025 \u0433\u043e\u0434\u0443. \u041d\u0435\u0441\u043c\u043e\u0442\u0440\u044f \u043d\u0430 \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u0438\u0435 \u0446\u0435\u043d\u044b \u043d\u0430 \u0437\u0430\u0433\u0440\u044f\u0437\u043d\u044f\u044e\u0449\u0438\u0435 \u0442\u043e\u0432\u0430\u0440\u044b, \u043e\u0431\u0449\u0430\u044f \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0441\u044f \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0441\u043d\u0438\u0436\u0435\u043d\u0438\u044e \u043d\u0430\u043b\u043e\u0433\u0430 \u0441 \u043f\u0440\u043e\u0434\u0430\u0436. . \u0447\u0442\u043e \u0441\u043d\u0438\u0436\u0430\u0435\u0442 \u0446\u0435\u043d\u044b \u043d\u0430 \u044d\u043a\u043e\u043b\u043e\u0433\u0438\u0447\u0435\u0441\u043a\u0438 \u0447\u0438\u0441\u0442\u044b\u0435 \u0442\u043e\u0432\u0430\u0440\u044b.<br><br> <b>\u0421\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u0411<\/b> :<br> \u0421 2025 \u0433\u043e\u0434\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043e \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0435\u0440 \u043f\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044e \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u043a\u043b\u0438\u043c\u0430\u0442\u0430 \u0438\u043b\u0438 \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430. \u041b\u044e\u0434\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442 \u0442\u043e\u0442 \u0436\u0435 \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438, \u0447\u0442\u043e \u0438 \u0432 2025 \u0433\u043e\u0434\u0443. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043b\u044e\u0434\u0435\u0439 \u043f\u043e-\u043f\u0440\u0435\u0436\u043d\u0435\u043c\u0443 \u0431\u0443\u0434\u0443\u0442 \u0435\u0437\u0434\u0438\u0442\u044c \u043d\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f\u0445 \u0441 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f\u043c\u0438 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0435\u0433\u043e \u0441\u0433\u043e\u0440\u0430\u043d\u0438\u044f. \u0412\u044b\u0431\u0440\u043e\u0441\u044b \u043f\u0430\u0440\u043d\u0438\u043a\u043e\u0432\u044b\u0445 \u0433\u0430\u0437\u043e\u0432 \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u044b. \u041e\u0436\u0438\u0434\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e\u0435 \u043f\u043e\u0442\u0435\u043f\u043b\u0435\u043d\u0438\u0435 \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0435\u0442 +3\u00b0C \u043a 2100 \u0433\u043e\u0434\u0443 \u0438 \u043f\u0440\u0435\u0432\u044b\u0441\u0438\u0442 \u044d\u0442\u043e\u0442 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u043f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0439 \u0434\u0430\u0442\u044b. \u0411\u043e\u043b\u0435\u0435 \u0442\u0435\u043f\u043b\u044b\u0439 \u043a\u043b\u0438\u043c\u0430\u0442 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u043f\u0440\u0438\u0447\u0438\u043d\u043e\u0439 \u0431\u043e\u043b\u0435\u0435 \u0447\u0430\u0441\u0442\u044b\u0445 \u0438 \u0441\u0438\u043b\u044c\u043d\u044b\u0445 \u0437\u0430\u0441\u0443\u0445, \u0432\u043e\u043b\u043d \u0442\u0435\u043f\u043b\u0430, \u043b\u0435\u0441\u043d\u044b\u0445 \u043f\u043e\u0436\u0430\u0440\u043e\u0432 \u0438 \u043f\u0440\u0438\u0431\u0440\u0435\u0436\u043d\u044b\u0445 \u043d\u0430\u0432\u043e\u0434\u043d\u0435\u043d\u0438\u0439.<br><br> \u0417\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0445 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432, \u043e\u0431\u0430 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u044f \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0441 \u0442\u043e\u0447\u043a\u0438 \u0437\u0440\u0435\u043d\u0438\u044f \u0431\u0435\u0437\u0440\u0430\u0431\u043e\u0442\u0438\u0446\u044b \u0438\u043b\u0438 \u043f\u0440\u0435\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u0438).<br><br> <b>\u041a\u0430\u043a\u043e\u0439 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043e \u0432\u044b \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u0435\u0442\u0435?<\/b>","Choices":{"1":{"Display":"\u0421\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u0410"},"2":{"Display":"\u0421\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u0411"}}}},"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID112"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID113","SecondaryAttribute":"Which scenario do you prefer for the next 20 years? Scenario A: - No additional policies to addre...","TertiaryAttribute":null,"Payload":{"QuestionText":"Which scenario do you prefer for the next 20 years?<br><br><b>Scenario A<\/b>:<br>- No additional policies to address climate change or inequality.&nbsp;<br>- Stable carbon emissions. Global warming expected to reach +3\u00b0C by 2100 and higher levels beyond 2100, which will cause more severe natural disasters.<br>- People maintain the same lifestyles as in 2025, such as driving gasoline cars.<br><br><b>Scenario B<\/b>: <br>- Worldwide policies to limit global warming to +2\u00b0C and reduce inequality. <br>- Reduced global carbon emissions, in line with climate target. <br>- Taxes on millionaires funding heat pumps, building insulation, and public transport. <br>- All cars electric by 2045, priced like today's gasoline cars.\n\n<br>- Heating fuel, air travel, and beef prices gradually double. As a result, 50% less flying and meat consumption, and more public transport use. <br>- Lower sales tax on non-polluting goods preserves overall purchasing power.<br><br>Apart from the elements described, the two scenarios are the same (for example, in terms of unemployment or crime). <br><br><b>Which scenario do you prefer?<\/b>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\tQualtrics.SurveyEngine.setEmbeddedData(\"time_preferred_transfer_mean\", Date.now()\/1000);\n\tconst time_before = Qualtrics.SurveyEngine.getEmbeddedData(\"time_wealth_tax\");\n\tQualtrics.SurveyEngine.setEmbeddedData(\"duration_preferred_transfer_mean\", Date.now()\/1000 - time_before);\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DataExportTag":"sustainable_future_s","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Which scenario do you prefer for the next 20 years? Scenario A: - No additional policies to addre...","Choices":{"1":{"Display":"Scenario A"},"2":{"Display":"Scenario B"}},"DisplayLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"variant_radical_redistr","Operator":"EqualTo","RightOperand":"2","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">variant_radical_redistr<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 2 <\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":{"AR":{"QuestionText":"\u0623\u064a \u0633\u064a\u0646\u0627\u0631\u064a\u0648 \u062a\u0641\u0636\u0644 \u0644\u0644\u0639\u0634\u0631\u064a\u0646 \u0639\u0627\u0645\u064b\u0627 \u0627\u0644\u0642\u0627\u062f\u0645\u0629\u061f<br \/>\n<br \/>\n<b>\u0633\u064a\u0646\u0627\u0631\u064a\u0648 \u0623<\/b>:<br \/>\n- \u0639\u062f\u0645 \u062a\u0628\u0646\u064a \u0623\u064a \u0633\u064a\u0627\u0633\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629 \u0644\u0645\u0648\u0627\u062c\u0647\u0629 \u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u062a\u063a\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0646\u0627\u062e\u064a\u0629 \u0623\u0648 \u0627\u0644\u062d\u062f \u0645\u0646 \u0639\u062f\u0645 \u0627\u0644\u0645\u0633\u0627\u0648\u0627\u0629. \u00a0<br \/>\n- \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0627\u0646\u0628\u0639\u0627\u062b\u0627\u062a \u0627\u0644\u0643\u0631\u0628\u0648\u0646 \u0628\u0646\u0641\u0633 \u0627\u0644\u0648\u062a\u064a\u0631\u0629. \u0645\u0639 \u062a\u0648\u0642\u0639 \u0623\u0646 \u064a\u0635\u0644 \u0627\u0631\u062a\u0641\u0627\u0639 \u062f\u0631\u062c\u0627\u062a \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0646\u0627\u062c\u0645 \u0639\u0646 \u0627\u0644\u0627\u062d\u062a\u0628\u0627\u0633 \u0627\u0644\u062d\u0631\u0627\u0631\u064a \u0644\u0623\u0643\u062b\u0631 \u0645\u0646 3 \u062f\u0631\u062c\u0627\u062a \u0645\u0626\u0648\u064a\u0629 \u0628\u062d\u0644\u0648\u0644 \u0639\u0627\u0645 2100 \u0648\u062a\u062c\u0627\u0648\u0632 \u062a\u0644\u0643 \u0627\u0644\u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0628\u0639\u062f \u0630\u0644\u0643\u060c \u0645\u0645\u0627 \u0642\u062f \u064a\u0624\u062f\u064a \u0625\u0644\u0649 \u0627\u0631\u062a\u0641\u0627\u0639 \u0645\u0639\u062f\u0644 \u0627\u0644\u0643\u0648\u0627\u0631\u062b \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629 \u0627\u0644\u0645\u062f\u0645\u0631\u0629.<br \/>\n- \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0627\u0644\u0628\u0634\u0631 \u0641\u064a \u0627\u062a\u0628\u0627\u0639 \u0646\u0641\u0633 \u0646\u0645\u0637 \u0627\u0644\u062d\u064a\u0627\u0629 \u0641\u064a \u0639\u0627\u0645 2025\u060c \u0643\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0633\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0639\u0645\u0644 \u0628\u0627\u0644\u0648\u0642\u0648\u062f \u0627\u0644\u0623\u062d\u0641\u0648\u0631\u064a.<br \/>\n<br \/>\n<b>\u0633\u064a\u0646\u0627\u0631\u064a\u0648 \u0628<\/b>:<br \/>\n- \u0627\u062a\u0628\u0627\u0639 \u0633\u064a\u0627\u0633\u0627\u062a \u062f\u0648\u0644\u064a\u0629 \u0644\u0644\u062d\u062f \u0645\u0646 \u0645\u0638\u0627\u0647\u0631 \u0627\u0644\u0627\u062d\u062a\u0628\u0627\u0633 \u0627\u0644\u062d\u0631\u0627\u0631\u064a \u0648\u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u0627\u0631\u062a\u0641\u0627\u0639 \u0641\u064a \u062f\u0631\u062c\u0627\u062a \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0641\u064a \u062d\u062f\u0648\u062f +2 \u062f\u0631\u062c\u0629 \u0645\u0626\u0648\u064a\u0629 \u0648\u0645\u0639\u0627\u0644\u062c\u0629 \u0642\u0636\u0627\u064a\u0627 \u0639\u062f\u0645 \u0627\u0644\u0645\u0633\u0627\u0648\u0627\u0629.<br \/>\n- \u062e\u0641\u0636 \u0627\u0646\u0628\u0639\u0627\u062b\u0627\u062a \u0627\u0644\u0643\u0631\u0628\u0648\u0646 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629\u060c \u0628\u0645\u0627 \u064a\u062a\u0645\u0627\u0634\u064a \u0645\u0639 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641 \u0627\u0644\u0645\u0646\u0627\u062e\u064a \u0627\u0644\u0639\u0627\u0644\u0645\u064a.<br \/>\n- \u0645\u0633\u0627\u0647\u0645\u0629 \u0627\u0644\u0636\u0631\u0627\u0626\u0628 \u0627\u0644\u0645\u0641\u0631\u0648\u0636\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u062b\u0631\u064a\u0627\u0621 \u0645\u0646 \u0623\u0635\u062d\u0627\u0628 \u0627\u0644\u0645\u0644\u0627\u064a\u064a\u0646 \u0639\u0644\u0649 \u062a\u0645\u0648\u064a\u0644 \u0627\u0644\u0645\u0636\u062d\u0627\u062a \u0627\u0644\u062d\u0631\u0627\u0631\u064a\u0629 \u0648\u0639\u0632\u0644 \u0627\u0644\u0645\u0628\u0627\u0646\u064a \u0648\u062a\u0639\u0632\u064a\u0632 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u0646\u0642\u0644 \u0627\u0644\u0639\u0627\u0645.<br \/>\n- \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0633\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0628\u062d\u0644\u0648\u0644 \u0639\u0627\u0645 2045\u060c \u0648\u0645\u0646\u0627\u0641\u0633\u0629 \u0623\u0633\u0639\u0627\u0631\u0647\u0627 \u0644\u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0633\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0639\u0645\u0644 \u0628\u0627\u0644\u0648\u0642\u0648\u062f \u0627\u0644\u0623\u062d\u0641\u0648\u0631\u064a \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u062d\u0627\u0644\u064a.<br \/>\n- \u062a\u0636\u0627\u0639\u0641 \u0623\u0633\u0639\u0627\u0631 \u0648\u0642\u0648\u062f \u0627\u0644\u062a\u062f\u0641\u0626\u0629 \u0648\u0627\u0644\u0633\u0641\u0631 \u0627\u0644\u062c\u0648\u064a \u0648\u0627\u0644\u0644\u062d\u0648\u0645 \u0627\u0644\u0628\u0642\u0631\u064a\u0629 \u062a\u062f\u0631\u064a\u062c\u064a\u064b\u0627. \u0645\u0645\u0627 \u0633\u064a\u0624\u062f\u064a \u0625\u0644\u0649 \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u062c\u0648\u064a\u0629 \u0648\u062a\u0642\u0644\u064a\u0644 \u0627\u0633\u062a\u0647\u0644\u0627\u0643 \u0627\u0644\u0644\u062d\u0648\u0645 \u0628\u0646\u0633\u0628\u0629 50%\u060c \u0645\u0645\u0627 \u0633\u064a\u0634\u062c\u0639 \u0627\u0644\u0646\u0627\u0633 \u0639\u0644\u0649 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0628\u0634\u0643\u0644 \u0623\u0643\u0628\u0631 \u0639\u0644\u0649 \u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u0646\u0642\u0644 \u0627\u0644\u0639\u0627\u0645\u0629.<br \/>\n- \u062a\u062e\u0641\u064a\u0636 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0633\u0644\u0639 \u063a\u064a\u0631 \u0627\u0644\u0645\u064f\u0644\u0648\u064e\u062b\u0629 \u0645\u0645\u0627 \u064a\u0633\u0627\u0639\u062f \u0639\u0644\u0649 \u062d\u0641\u0638 \u0627\u0644\u0642\u0648\u0629 \u0627\u0644\u0634\u0631\u0627\u0626\u064a\u0629 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0629.<br \/>\n<br \/>\n\u0628\u062e\u0644\u0627\u0641 \u0627\u0644\u0639\u0648\u0627\u0645\u0644 \u0627\u0644\u0633\u0627\u0628\u0642 \u0630\u0643\u0631\u0647\u0627 \u0623\u0639\u0644\u0627\u0647\u060c \u0641\u0625\u0646 \u0627\u0644\u0633\u064a\u0646\u0627\u0631\u064a\u0648\u0647\u064a\u0646 \u0645\u062a\u0645\u0627\u062b\u0644\u0627\u0646 (\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644\u060c \u0641\u064a\u0645\u0627 \u064a\u062a\u0639\u0644\u0642 \u0628\u0646\u0633\u0628 \u0627\u0644\u0628\u0637\u0627\u0644\u0629 \u0623\u0648 \u0645\u0639\u062f\u0644\u0627\u062a \u0627\u0644\u062c\u0631\u064a\u0645\u0629).<br \/>\n<br \/>\n<b>\u0623\u064a \u0633\u064a\u0646\u0627\u0631\u064a\u0648 \u0633\u062a\u0641\u0636\u0644\u061f<\/b>","Choices":{"1":{"Display":"\u0627\u0644\u0633\u064a\u0646\u0627\u0631\u064a\u0648 \u0623"},"2":{"Display":"\u0627\u0644\u0633\u064a\u0646\u0627\u0631\u064a\u0648 \u0628"}}},"DE":{"QuestionText":"Welches Szenario bevorzugen Sie f\u00fcr die n\u00e4chsten 20 Jahre?<br \/>\n<br \/>\n<b>Szenario A<\/b>:\n<ul>\n\t<li>Keine zus\u00e4tzlichen Ma\u00dfnahmen gegen den Klimawandel oder soziale Ungleichheit.<\/li>\n\t<li>Stabile CO\u2082-Emissionen. Die Erderw\u00e4rmung erreicht bis 2100 +3\u00b0C und steigt danach weiter an, was zu h\u00e4ufigeren und schwereren Naturkatastrophen f\u00fchrt.<\/li>\n\t<li>Der Lebensstil von\u00a02025 bleibt unver\u00e4ndert, Autos mit\u00a0Verbrennungsmotoren werden weiterhin benutzt.<\/li>\n<\/ul>\n<br \/>\n<b>Szenario B<\/b>:\n\n<ul>\n\t<li>Weltweite Ma\u00dfnahmen zur Begrenzung der Erderw\u00e4rmung auf +2\u00b0C und zur Reduzierung von Ungleichheit.<\/li>\n\t<li>Eine Reduzierung der globalen CO\u2082-Emissionen im Einklang mit den Klimazielen.<\/li>\n\t<li>Besteuerung von Million\u00e4ren zur Finanzierung von W\u00e4rmepumpen, Geb\u00e4uded\u00e4mmung und \u00f6ffentlichem Verkehr.<\/li>\n\t<li>Ab 2045 sind alle Autos elektrisch und kosten so viel wie heutige Benzinautos.<\/li>\n\t<li>Die Preise f\u00fcr Heiz\u00f6l, Flugreisen und Rindfleisch verdoppeln sich allm\u00e4hlich, wodurch der Fleischkonsum und die Flugreisen um 50 % sinken, w\u00e4hrend \u00f6ffentliche Verkehrsmittel h\u00e4ufiger genutzt werden.<\/li>\n\t<li>Eine niedrigere Mehrwertsteuer auf umweltfreundliche Produkte sorgt daf\u00fcr, dass die Kaufkraft insgesamt erhalten bleibt.<\/li>\n<\/ul>\n<br \/>\nAbgesehen von diesen Faktoren sind die beiden Szenarien in anderen Bereichen, wie Arbeitsmarkt und Kriminalit\u00e4tsraten, identisch.<br \/>\n<br \/>\n<b>Welches Szenario bevorzugen Sie?<\/b>","Choices":{"1":{"Display":"Szenario A"},"2":{"Display":"Szenario B"}}},"DE-CH":[],"EN":[],"EN-GB":[],"ES-ES":{"QuestionText":"\u00bfQu\u00e9 escenario prefiere para los pr\u00f3ximos 20 a\u00f1os?<br \/>\n<br \/>\n<b>Escenario A<\/b>:<br \/>\n- Sin pol\u00edticas adicionales para abordar el cambio clim\u00e1tico ni la desigualdad.\u00a0<br \/>\n- Emisiones de carbono estables. Se prev\u00e9 que el calentamiento global alcance los 3 \u00b0C para 2100 y niveles superiores despu\u00e9s de 2100, lo que provocar\u00e1 desastres naturales m\u00e1s graves.<br \/>\n- Las personas mantienen los mismos estilos de vida que en 2025, como conducir coches de gasolina.<br \/>\n<br \/>\n<b>Escenario B<\/b>:<br \/>\n- Pol\u00edticas mundiales para limitar el calentamiento global a<br \/>\n2\u00b0C y reducir la desigualdad.<br \/>\n- Reducci\u00f3n de las emisiones globales de carbono, en l\u00ednea con el objetivo clim\u00e1tico.<br \/>\n- Impuestos a los millonarios que financien bombas de calor, aislamiento de edificios y transporte p\u00fablico.<br \/>\n- Todos los coches el\u00e9ctricos para 2045, con el mismo precio que los coches de gasolina actuales.<br \/>\n- Los precios del combustible para calefacci\u00f3n, los viajes en avi\u00f3n y la carne de vacuno se duplican gradualmente. Como resultado, se reduce el consumo de aviones y carne en un 50 % y se utiliza m\u00e1s el transporte p\u00fablico.<br \/>\n- La reducci\u00f3n de los impuestos sobre las ventas de bienes no contaminantes preserva el poder adquisitivo general.<br \/>\n<br \/>\nAparte de los elementos descritos, ambos escenarios son iguales (por ejemplo, en t\u00e9rminos de desempleo o delincuencia).<br \/>\n<br \/>\n<b>\u00bfCu\u00e1l escenario prefiere?<\/b>","Choices":{"1":{"Display":"Escenario A"},"2":{"Display":"Escenario B"}}},"ES-US":[],"FR":{"QuestionText":"<b>Consid\u00e9rons deux sc\u00e9narios possibles pour le monde pour les 20 prochaines ann\u00e9es.<br \/>\n<br \/>\nSc\u00e9nario A<\/b> :<br \/>\nDepuis 2025, aucune mesure suppl\u00e9mentaire n\u2019est mise en \u0153uvre pour lutter contre le changement climatique ou les in\u00e9galit\u00e9s. Les gens maintiennent le m\u00eame mode de vie qu\u2019en 2025. Par exemple, la plupart des gens continuent de conduire des voitures thermiques. Les \u00e9missions de gaz \u00e0 effet de serre sont stables. Le r\u00e9chauffement climatique devrait atteindre +3\u00b0C d\u2019ici 2100 et des niveaux plus \u00e9lev\u00e9s au-del\u00e0 de cette date. Le changement climatique entra\u00eene des s\u00e9cheresses, des vagues de chaleur, des incendies de for\u00eat et des inondations c\u00f4ti\u00e8res plus fr\u00e9quents et plus graves.<br \/>\n<br \/>\n<b>Sc\u00e9nario B<\/b> :<br \/>\nLa plupart des pays mettent en \u0153uvre des politiques coordonn\u00e9es pour limiter le r\u00e9chauffement climatique \u00e0 +2\u00b0C et r\u00e9duire les in\u00e9galit\u00e9s. Le monde r\u00e9duit consid\u00e9rablement les \u00e9missions de gaz \u00e0 effet de serre et est en bonne voie pour atteindre l'objectif climatique. Des imp\u00f4ts sur les millionnaires financent l\u2019installation de pompes \u00e0 chaleur, l\u2019isolation thermique des b\u00e2timents et l\u2019am\u00e9lioration des transports publics. Les yachts et les jets priv\u00e9s sont progressivement supprim\u00e9s dans le monde entier. Les voitures sont enti\u00e8rement \u00e9lectriques d\u2019ici 2045 et co\u00fbtent \u00e0 peu pr\u00e8s le m\u00eame prix que les voitures thermiques d\u2019aujourd\u2019hui. D\u2019ici 2045, les r\u00e9glementations environnementales multiplient progressivement par deux le prix du b\u0153uf, du fioul ou du gaz de chauffage, et du transport a\u00e9rien. En cons\u00e9quence, les gens prennent l\u2019avion deux fois moins souvent, mangent deux fois moins de viande et utilisent davantage les transports en commun en 2045 qu\u2019en 2025. Malgr\u00e9 des prix plus \u00e9lev\u00e9s pour les biens polluants, le pouvoir d\u2019achat g\u00e9n\u00e9ral est pr\u00e9serv\u00e9, gr\u00e2ce \u00e0 une baisse de la TVA qui r\u00e9duit les prix des biens non polluants.<br \/>\n<br \/>\nHormis les \u00e9l\u00e9ments d\u00e9crits, les deux sc\u00e9narios sont identiques (par exemple en termes de ch\u00f4mage ou de criminalit\u00e9).<br \/>\n<b>Quel sc\u00e9nario pr\u00e9f\u00e9rez-vous pour l\u2019avenir ?<\/b>","Choices":{"1":{"Display":"Sc\u00e9nario\u00a0A"},"2":{"Display":"Sc\u00e9nario B"}}},"FR-CH":[],"IT":{"QuestionText":"Quale scenario preferisci per i prossimi 20 anni?<br><br> <b>Scenario A<\/b> :<br> - Nessuna politica aggiuntiva per affrontare il cambiamento climatico o le disuguaglianze.<br> - Emissioni di carbonio stabili. Si prevede che il riscaldamento globale raggiunger\u00e0 i +3\u00b0C entro il 2100 e livelli ancora pi\u00f9 elevati dopo il 2100, provocando disastri naturali pi\u00f9 gravi.<br> - Le persone mantengono lo stesso stile di vita del 2025, ad esempio guidano auto a benzina.<br><br> <b>Scenario B<\/b> :<br> - Politiche mondiali per limitare il riscaldamento globale a +2\u00b0C e ridurre le disuguaglianze.<br> - Riduzione delle emissioni globali di carbonio, in linea con gli obiettivi climatici.<br> - Tasse sui milionari che finanziano pompe di calore, isolamento degli edifici e trasporti pubblici.<br> - Entro il 2045 tutte le auto saranno elettriche e avranno lo stesso prezzo delle attuali auto a benzina.<br> - I prezzi del combustibile per il riscaldamento, dei viaggi aerei e della carne bovina raddoppiano gradualmente. Di conseguenza, il consumo di voli e di carne sar\u00e0 ridotto del 50%, e l&#39;uso dei trasporti pubblici sar\u00e0 maggiore.<br> - Una riduzione dell&#39;imposta sulle vendite di beni non inquinanti preserva il potere d&#39;acquisto complessivo.<br><br> A parte gli elementi descritti, i due scenari sono identici (ad esempio, in termini di disoccupazione o criminalit\u00e0).<br><br> <b>Quale scenario preferisci?<\/b>","Choices":{"1":{"Display":"Scenario A"},"2":{"Display":"Scenario B"}}},"IT-CH":[],"JA":[],"PL":{"QuestionText":"<strong>Kt\u00f3ra wizja przysz\u0142o\u015bci na najbli\u017csze 20 lat bardziej Panu\/Pani odpowiada?<\/strong><br \/>\n<br \/>\n<strong>Scenariusz A:<\/strong>\n<ul>\n\t<li>Brak nowych inicjatyw w zakresie zmian klimatycznych lub nier\u00f3wno\u015bci spo\u0142ecznych.<\/li>\n\t<li>Stabilny poziom emisji dwutlenku w\u0119gla. Oczekuje si\u0119, \u017ce globalne ocieplenie osi\u0105gnie +3\u00b0C do 2100 r. i wy\u017csze poziomy po 2100 r., co b\u0119dzie powodowa\u0107 nasilenie kl\u0119sk \u017cywio\u0142owych.<\/li>\n\t<li>Ludzie utrzymuj\u0105 ten sam styl \u017cycia, co w 2025 r., na przyk\u0142ad je\u017cd\u017c\u0105 samochodami benzynowymi.<\/li>\n<\/ul>\n<br \/>\n<br \/>\n<strong>Scenariusz B:<\/strong>\n\n<ul>\n\t<li>Wdro\u017cenie og\u00f3lno\u015bwiatowej inicjatywy maj\u0105cej na celu ograniczenie globalnego ocieplenia do +2\u00b0C i zmniejszenie nier\u00f3wno\u015bci spo\u0142ecznych.<\/li>\n\t<li>Zmniejszenie globalnej emisji dwutlenku w\u0119gla, zgodnie z za\u0142o\u017conym celem klimatycznym.<\/li>\n\t<li>Wprowadzenie podatku dla milioner\u00f3w, finansuj\u0105cego pompy ciep\u0142a, izolacj\u0119 budynk\u00f3w i transport publiczny.<\/li>\n\t<li>Ca\u0142kowita elektryfikacja samochod\u00f3w do 2045 r.; pojazdy elektryczne dost\u0119pne po cenach takich, jak dzisiejsze samochody benzynowe.<\/li>\n\t<li>Stopniowe podwojenie cen wo\u0142owiny, paliwa opa\u0142owego i podr\u00f3\u017cy lotniczych. W rezultacie spo\u017cycie mi\u0119sa i liczba lot\u00f3w zmniejszaj\u0105 si\u0119 o 50%; nast\u0119puje zwi\u0119kszenie korzystania z transportu publicznego.<\/li>\n\t<li>Ni\u017cszy podatek od sprzeda\u017cy towar\u00f3w niezanieczyszczaj\u0105cych \u015brodowiska utrzymuje og\u00f3ln\u0105 si\u0142\u0119 nabywcz\u0105 na tym samym poziomie.<\/li>\n<\/ul>\n<br \/>\n<br \/>\nPoza opisanymi elementami oba scenariusze s\u0105 takie same (na przyk\u0142ad pod wzgl\u0119dem bezrobocia lub przest\u0119pczo\u015bci).<br \/>\n<br \/>\n<strong>Kt\u00f3ry scenariusz bardziej Panu\/Pani odpowiada?<\/strong>","Choices":{"1":{"Display":"Scenariusz A"},"2":{"Display":"Scenariusz B"}}},"RU":[]},"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID113"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID114","SecondaryAttribute":"Currently, 2 billion people live in acute poverty, with less than [lcu_250: $250][periodicity: pe...","TertiaryAttribute":null,"Payload":{"QuestionText":"Currently, 2 billion people live in acute poverty, with less than <span class=\"lcu_250\">[lcu_250: $250]<\/span><span class=\"periodicity\">[periodicity: per month]<\/span>.<br><br><b>Poverty reduction could be funded by a global tax on individual income above <span class=\"lcu_120k\">[lcu_120k: $120,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>.&nbsp;<br>The tax rate would be 15% for every <span class=\"currency\">[currency: dollar]<\/span> over <span class=\"lcu_120k\">[lcu_120k: $120,000]<\/span> of income <\/b>after existing taxes.&nbsp;<br><br><b>Do you support or oppose such a global tax on the richest people to finance global poverty reduction?<\/b><br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/\/ Loads CSV and create variables from the column corresponding to Q_Language\n\t$j(document).ready(function($j){\t\n\t\t$j.ajax({\n\t\t\turl:\"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_yuKEs6pwxsAid44\",\n\t\t\tsuccess: function(csv){\n\t\t\t\t\n\t\t\tconst language = Qualtrics.SurveyEngine.getEmbeddedData(\"Q_Language\"); \n\t\t\t\t\n\t\t\tconst rows = csv.split('\\n').map(row => row.split('|'));\n\t\t\tconst headers = rows[0];\n\t\t\tconst col = headers.indexOf(language);\n\n\t\t\tif (col === -1) {\n\t\t\t\tconsole.error(\"Column 'language' not found in the CSV file.\");\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t\/\/ Iterate through the rows and create variables dynamically\n\t\t\tfor (let i = 1; i < rows.length-1; i++) {\n\t\t\t\tconst name = rows[i][0]; \/\/ Assuming the row name is in the first column\n\t\t\t\tconst value = rows[i][col];\n\t\t\t\twindow[name] = value; \n\t\t\t\t$j(\"#\" + name).html(value);\n\t\t\t\t$j(\".\" + name).html(value);\n\t\t\t\tconsole.log(`Variable ${name} created with value: ${value}`);\n\t\t\t}\n\n\t\t\t\t},\n\t\t\terror: function(){ alert('Data could not be loaded');}\n\t\t});\n\t});\n});","DataExportTag":"top1_tax_support_cut","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Currently, 2 billion people live in acute poverty, with less than [lcu_250: $250][periodicity: pe...","Choices":{"1":{"Display":"Strongly oppose"},"2":{"Display":"Somewhat support"},"3":{"Display":"Strongly support"},"4":{"Display":"Somewhat oppose"},"5":{"Display":"Indifferent"}},"DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">variant_radical_redistr<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 0 <\/span>","LeftOperand":"variant_radical_redistr","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"0","Type":"Expression"},"1":{"Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"LeftOpDesc\">long<\/span> <span class=\"OpDesc\">Is Less Than<\/span> <span class=\"RightOpDesc\"> 0.42 <\/span>","LeftOperand":"long","LogicType":"EmbeddedField","Operator":"LessThan","RightOperand":"0.42","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":["1","4","5","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":{"AR":{"QuestionText":"\u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0631\u0627\u0647\u0646\u060c \u064a\u0639\u064a\u0634 \u0642\u0631\u0627\u0628\u0629 \u0627\u0644 2 \u0645\u0644\u064a\u0627\u0631 \u0634\u062e\u0635 \u0641\u064a \u0641\u0642\u0631 \u0645\u062f\u0642\u0639\u060c \u0648\u0644\u0627 \u064a\u062a\u062c\u0627\u0648\u0632 \u062f\u062e\u0644\u0647\u0645 <span class=\"lcu_250\">[lcu_250: $250]<\/span><span class=\"periodicity\">[periodicity: per month]<\/span>.<br \/>\n<br \/>\n<b>\u064a\u0645\u0643\u0646 \u062e\u0641\u0636 \u0645\u0639\u062f\u0644\u0627\u062a \u0627\u0644\u0641\u0642\u0631 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0639\u0646 \u0637\u0631\u064a\u0642 \u062a\u0637\u0628\u064a\u0642 \u0636\u0631\u064a\u0628\u0629 \u0639\u0627\u0644\u0645\u064a\u0629 \u062a\u064f\u0641\u0631\u0636 \u0639\u0644\u0649 \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0630\u064a\u0646 \u064a\u062a\u062c\u0627\u0648\u0632 \u062f\u062e\u0644\u0647\u0645 <span class=\"lcu_120k\">[lcu_120k: $120,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>.\u00a0<br \/>\n\u0633\u062a\u0628\u0644\u063a \u0642\u064a\u0645\u0629 \u0627\u0644\u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0645\u0641\u0631\u0648\u0636\u0629 15% \u0644\u0643\u0644\u00a0<span class=\"currency\">[currency: dollar]<\/span> \u064a\u0632\u064a\u062f \u0639\u0646 \u0627\u0644\u062f\u062e\u0644 \u0627\u0644\u0628\u0627\u0644\u063a\u00a0<span class=\"lcu_120k\">[lcu_120k: $120,000] \u060c \u0648\u0630\u0644\u0643 <\/span><\/b> \u0628\u0639\u062f \u062e\u0635\u0645 \u0627\u0644\u0636\u0631\u0627\u0626\u0628. \u00a0<br \/>\n<br \/>\n<b>\u0647\u0644 \u0623\u0646\u062a \u0645\u0639 \u0623\u0645 \u0636\u062f \u0641\u0631\u0636 \u0636\u0631\u064a\u0628\u0629 \u0639\u0627\u0644\u0645\u064a\u0629 \u0639\u0644\u0649 \u0623\u062b\u0631\u064a\u0627\u0621 \u0627\u0644\u0639\u0627\u0644\u0645 \u0645\u0646 \u0623\u062c\u0644 \u0645\u0643\u0627\u0641\u062d\u0629 \u0627\u0644\u0641\u0642\u0631 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u061f<\/b>","Choices":{"1":{"Display":"\u0623\u0639\u0627\u0631\u0636 \u0628\u0634\u062f\u0629"},"2":{"Display":"\u0623\u0624\u064a\u062f \u0625\u0644\u0649 \u062d\u062f \u0645\u0627\u00a0"},"3":{"Display":"\u0623\u0624\u064a\u062f \u0628\u0634\u062f\u0629"},"4":{"Display":"\u0623\u0639\u0627\u0631\u0636 \u0625\u0644\u0649 \u062d\u062f \u0645\u0627"},"5":{"Display":"\u0644\u0627 \u0623\u0643\u062a\u0631\u062b"}}},"FR":{"QuestionText":"Actuellement, 2 milliards de personnes vivent en situation de pauvret\u00e9 s\u00e9v\u00e8re, avec moins de <span class=\"lcu_250\">[lcu_250\u00a0: 250\u00a0$]<\/span><span class=\"periodicity\">[p\u00e9riodicit\u00e9\u00a0: par mois]<\/span>.<br \/>\nLes Objectifs de d\u00e9veloppement durable, adopt\u00e9s par tous les pays en 2015, visent \u00e0 r\u00e9duire la pauvret\u00e9 et \u00e0 assurer l\u2019acc\u00e8s aux soins, \u00e0 l\u2019\u00e9ducation, \u00e0 l\u2019eau potable et \u00e0 l\u2019assainissement pour tous d\u2019ici 2030. Le monde n\u2019est pas sur la bonne voie pour atteindre ces objectifs de r\u00e9duction de la pauvret\u00e9 en raison du manque de financement.<br \/>\n<br \/>\n<b>La r\u00e9duction de la pauvret\u00e9 pourrait \u00eatre financ\u00e9e par un imp\u00f4t mondial sur les revenus sup\u00e9rieurs \u00e0 <span class=\"lcu_120k\">[lcu_120k\u00a0: 120\u00a0000\u00a0$]<\/span><span class=\"periodicity_tax\">[periodicity_tax\u00a0: par an]<\/span>.<br \/>\nLe taux d\u2019imposition serait de 15 % pour chaque euro au-dessus de <span class=\"lcu_120k\">[lcu_120k\u00a0: 120\u00a0000\u00a0$]<\/span> de revenu apr\u00e8s imp\u00f4ts existants<\/b>.<br \/>\nPar exemple, une personne seule gagnant <span class=\"lcu_130k\">[lcu_130k: 130\u00a0000 $]<\/span><span class=\"periodicity_tax\">[periodicity_tax: par an]<\/span> apr\u00e8s imp\u00f4ts paierait <span id=\"lcu_1500\">[lcu_1500: 1\u00a0500 $]<\/span> d'imp\u00f4ts suppl\u00e9mentaires, soit 15 % de <span id=\"lcu_10k\">[lcu_10k: 10\u00a0000 $]<\/span> = <span class=\"lcu_130k\">[lcu_130k: 130\u00a0000 $]<\/span> - <span class=\"lcu_120k\">[lcu_120k: 120\u00a0000 $]<\/span>. En revanche, un couple mari\u00e9 gagnant <span id=\"lcu_200k\">[lcu_200k\u00a0: 200\u00a0000\u00a0$]<\/span><span class=\"periodicity_tax\">[p\u00e9riodicit\u00e9_taxe\u00a0: par an]<\/span>, <span id=\"lcu_100k\">[lcu_100k\u00a0: 100\u00a0000\u00a0$]<\/span> pour chacun d'eux, ne serait pas impos\u00e9.<br \/>\nCet imp\u00f4t s\u2019appliquerait au 1% le plus riche de la population mondiale. <span id=\"tax_country_name\">[tax_country_name: In the United States]<\/span>, cela affecterait les <span id=\"affected_top1\">[affected_top1: 8]<\/span> % les plus riches et redistribuerait <span id=\"transfer_top1\">[transfer_top1: 3]<\/span> % du PIB vers les pays \u00e0 bas revenus.<br \/>\n<br \/>\n<b>\u00cates-vous favorable ou oppos\u00e9\u22c5e \u00e0 une telle taxe mondiale sur les personnes les plus riches pour financer la r\u00e9duction de la pauvret\u00e9 dans le monde ?<\/b>","Choices":{"1":{"Display":"Tr\u00e8s oppos\u00e9\u22c5e"},"4":{"Display":"Plut\u00f4t oppos\u00e9\u22c5e"},"5":{"Display":"Indiff\u00e9rent\u22c5e ou ne sais pas"},"2":{"Display":"Plut\u00f4t favorable"},"3":{"Display":"Tr\u00e8s favorable"}}},"IT-CH":[],"JA":[],"PL":{"QuestionText":"Obecnie 2 miliardy ludzi \u017cyj\u0105 w skrajnym ub\u00f3stwie, zarabiaj\u0105c mniej ni\u017c <span class=\"lcu_250\">500 PLN<\/span><span class=\"periodicity\"> miesi\u0119cznie<\/span>.<br \/>\n<br \/>\n<b>Zmniejszenie ub\u00f3stwa mog\u0142oby by\u0107 finansowane przez globalny podatek od dochodu indywidualnego przekraczaj\u0105cego <span class=\"lcu_120k\">40 000 PLN<\/span><span class=\"periodicity_tax\"> miesi\u0119cznie<\/span>.<br \/>\nStawka podatku wynios\u0142aby 15% za ka\u017cd\u0105 z\u0142ot\u00f3wk\u0119 powy\u017cej <span class=\"lcu_120k\">40 000 PLN<\/span> dochodu, po odliczeniu istniej\u0105cych podatk\u00f3w.<\/b><br \/>\n<br \/>\n<b>Czy popar\u0142(a)by Pan\/Pani taki globalny podatek dla najbogatszych w celu finansowania redukcji ub\u00f3stwa na \u015bwiecie, czy by\u0142(a)by mu Pan\/Pani przeciwny(-a)?<\/b>","Choices":{"1":{"Display":"Jestem zdecydowanie przeciw"},"4":{"Display":"Jestem raczej przeciw"},"5":{"Display":"Nie mam zdania"},"2":{"Display":"Jestem raczej za"},"3":{"Display":"Jestem zdecydowanie za"}}},"RU":[],"DE":{"QuestionText":"Derzeit leben 2 Milliarden Menschen in extremer Armut mit einem Einkommen unter <span class=\"lcu_250\">[lcu_250: $250]<\/span><span class=\"periodicity\">[periodicity: per month]<\/span>.<br \/>\n<br \/>\n<strong>Eine globale Steuer auf individuelle Einkommen \u00fcber <span class=\"lcu_120k\">[lcu_120k: $120,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span> k\u00f6nnte zur Finanzierung der Armutsbek\u00e4mpfung beitragen.\u00a0<br \/>\nDer Steuersatz l\u00e4ge bei 15 % auf jeden <\/strong><span class=\"currency\"><strong>[currency: dollar]<\/strong>\u00a0nach steurlichen Abgaben.<br \/>\n<!-- nach bereits gezahlten Steuern.\u00a0<br \/--><br \/>\n<strong>Bef\u00fcrworten oder lehnen Sie eine solche globale Steuer auf die reichsten Menschen zur Finanzierung der weltweiten Armutsbek\u00e4mpfung ab? <\/strong><\/span>","Choices":{"1":{"Display":"Sehr dagegen"},"2":{"Display":"Eher daf\u00fcr"},"3":{"Display":"Sehr daf\u00fcr"},"4":{"Display":"Eher dagegen"},"5":{"Display":"Keine Meinung"}}},"EN":[],"DE-CH":[],"FR-CH":[],"ES-ES":{"QuestionText":"Actualmente, 2 mil millones de personas viven en extrema pobreza, con menos de <span class=\"lcu_250\">[lcu_250: $250]<\/span><span class=\"periodicity\">[periodicity: per month]<\/span>.<br \/>\n<br \/>\n<b>La reducci\u00f3n de la pobreza podr\u00eda financiarse mediante un impuesto global sobre los ingresos individuales superiores a <span class=\"lcu_120k\">[lcu_120k: $120,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>.\u00a0<br \/>\nLa tasa impositiva ser\u00eda del 15% por cada <span class=\"currency\">[currency: dollar]<\/span> que supere los <span class=\"lcu_120k\">[lcu_120k: $120,000]<\/span> de ingreso <\/b>despu\u00e9s de los impuestos vigentes.\u00a0<br \/>\n<br \/>\n<b>\u00bfEst\u00e1 a favor o en contra de un impuesto global de este tipo sobre las personas m\u00e1s ricas para financiar la reducci\u00f3n de la pobreza global?<\/b>","Choices":{"1":{"Display":"Totalmente en contra"},"2":{"Display":"Levemente a favor"},"3":{"Display":"Totalmente a favor"},"4":{"Display":"Levemente en contra"},"5":{"Display":"Indiferente o no sabe"}}},"ES-US":[],"IT":{"QuestionText":"Attualmente, 2 miliardi di persone vivono in condizioni di povert\u00e0 acuta, con meno di <span class=\"lcu_250\">[lcu_250: $250]<\/span><span class=\"periodicity\">[periodicity: per month]<\/span>.<br \/>\n<br \/>\n<b>La riduzione della povert\u00e0 potrebbe essere finanziata tramite una tassa a livello globale sui redditi individuali superiori a <span class=\"lcu_120k\">[lcu_120k: $120,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>.\u00a0<br \/>\nL'aliquota fiscale sarebbe del 15% per ogni <span class=\"currency\">[currency: dollar]<\/span> superiore a <span class=\"lcu_120k\">[lcu_120k: $120,000]<\/span> di reddito <\/b>al netto delle tasse esistenti.\u00a0<br \/>\n<br \/>\n<b>Sei a favore o contrario a questa tassa globale sugli individui pi\u00f9 ricchi per finanziare la riduzione della povert\u00e0 nel mondo?<\/b>","Choices":{"1":{"Display":"Fortemente in disaccordo"},"4":{"Display":"Leggermente in disaccordo"},"5":{"Display":"Indifferente"},"2":{"Display":"Leggermente d'accordo"},"3":{"Display":"Fortemente d'accordo"}}},"EN-GB":[]},"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID114"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID115","SecondaryAttribute":"Currently, 3 billion people live in deep poverty, with less than [lcu_400: $400][periodicity: per...","TertiaryAttribute":null,"Payload":{"QuestionText":"Currently, 3 billion people live in deep poverty, with less than <span class=\"lcu_400\">[lcu_400: $400]<\/span><span class=\"periodicity\">[periodicity: per month]<\/span>.<br><br><b>Poverty reduction could be funded by a global tax on individual income above <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>.&nbsp;<br>The tax rate would be 15% for every <span class=\"currency\">[currency: dollar]<\/span> over <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span> of income<\/b> after existing taxes, <b>30% over <span id=\"lcu_120k\">[lcu_120k: $120,000]<\/span>, and 45% over <span id=\"lcu_1M\">[lcu_1M: $1 million]<\/span>.&nbsp;<\/b><br>For example, a single person earning <span class=\"lcu_90k\">[lcu_90k: $90,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span> after taxes would pay <span id=\"lcu_1500_top3\">[lcu_1500_top3: $1,500]<\/span> in additional taxes, or 15% of <span id=\"lcu_10k_top3\">[lcu_10k_top3: $10,000]<\/span> = <span class=\"lcu_90k\">[lcu_90k: $90,000]<\/span> - <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span>. Meanwhile, a married couple earning <span id=\"lcu_150k\">[lcu_150k: $150,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>, <span id=\"lcu_75k\">[lcu_75k: $75,000]<\/span> for each of them, would go untaxed.<br><br><b>Do you support or oppose such a global tax on the richest people to finance global poverty reduction?<\/b><br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/\/ Loads CSV and create variables from the column corresponding to Q_Language\n\t$j(document).ready(function($j){\t\n\t\t$j.ajax({\n\t\t\turl:\"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_yuKEs6pwxsAid44\",\n\t\t\tsuccess: function(csv){\n\t\t\t\t\n\t\t\tconst language = Qualtrics.SurveyEngine.getEmbeddedData(\"Q_Language\"); \n\t\t\t\t\n\t\t\tconst rows = csv.split('\\n').map(row => row.split('|'));\n\t\t\tconst headers = rows[0];\n\t\t\tconst col = headers.indexOf(language);\n\n\t\t\tif (col === -1) {\n\t\t\t\tconsole.error(\"Column 'language' not found in the CSV file.\");\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t\/\/ Iterate through the rows and create variables dynamically\n\t\t\tfor (let i = 1; i < rows.length-1; i++) {\n\t\t\t\tconst name = rows[i][0]; \/\/ Assuming the row name is in the first column\n\t\t\t\tconst value = rows[i][col];\n\t\t\t\twindow[name] = value; \n\t\t\t\t$j(\"#\" + name).html(value);\n\t\t\t\t$j(\".\" + name).html(value);\n\t\t\t\tconsole.log(`Variable ${name} created with value: ${value}`);\n\t\t\t}\n\n\t\t\t\t},\n\t\t\terror: function(){ alert('Data could not be loaded');}\n\t\t});\n\t});\n});","DataExportTag":"top3_tax_support_cut","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Currently, 3 billion people live in deep poverty, with less than [lcu_400: $400][periodicity: per...","Choices":{"1":{"Display":"Strongly oppose"},"2":{"Display":"Somewhat support"},"3":{"Display":"Strongly support"},"4":{"Display":"Somewhat oppose"},"5":{"Display":"Indifferent"}},"DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">variant_radical_redistr<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"variant_radical_redistr","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"1":{"Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"LeftOpDesc\">long<\/span> <span class=\"OpDesc\">Is Less Than<\/span> <span class=\"RightOpDesc\"> 0.42 <\/span>","LeftOperand":"long","LogicType":"EmbeddedField","Operator":"LessThan","RightOperand":"0.42","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":["1","4","5","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":{"AR":{"QuestionText":"\u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0631\u0627\u0647\u0646\u060c \u064a\u0639\u064a\u0634 \u0642\u0631\u0627\u0628\u0629 \u0627\u0644 3 \u0645\u0644\u064a\u0627\u0631 \u0634\u062e\u0635 \u0641\u064a \u0641\u0642\u0631 \u0645\u062f\u0642\u0639\u060c \u0648\u0644\u0627 \u064a\u062a\u062c\u0627\u0648\u0632 \u062f\u062e\u0644 \u0643\u0644 \u0645\u0646\u0647\u0645 <span class=\"lcu_400\">[lcu_400: $400]<\/span><span class=\"periodicity\">[periodicity: per month]<\/span>.<br \/>\n<br \/>\n<b>\u064a\u0645\u0643\u0646 \u062e\u0641\u0636 \u0645\u0639\u062f\u0644\u0627\u062a \u0627\u0644\u0641\u0642\u0631 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0639\u0646 \u0637\u0631\u064a\u0642 \u062a\u0637\u0628\u064a\u0642 \u0636\u0631\u064a\u0628\u0629 \u0639\u0627\u0644\u0645\u064a\u0629 \u062a\u064f\u0641\u0631\u0636 \u0639\u0644\u0649 \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0630\u064a\u0646 \u064a\u062a\u062c\u0627\u0648\u0632 \u062f\u062e\u0644\u0647\u0645 <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>.\u00a0<br \/>\n\u0633\u062a\u0628\u0644\u063a \u0642\u064a\u0645\u0629 \u0627\u0644\u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0645\u0641\u0631\u0648\u0636\u0629 15% \u0644\u0643\u0644\u00a0<span class=\"currency\">[currency: dollar]<\/span> \u064a\u0632\u064a\u062f \u0639\u0646 \u0627\u0644\u062f\u062e\u0644 \u0627\u0644\u0628\u0627\u0644\u063a\u00a0<span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span><\/b>\u060c \u0648\u0630\u0644\u0643 \u0628\u0639\u062f \u062e\u0635\u0645 \u0627\u0644\u0636\u0631\u0627\u0626\u0628.\u00a0<b>\u0648\u062a\u0635\u0644 \u062a\u0644\u0643 \u0627\u0644\u0646\u0633\u0628\u0629 \u0625\u0644\u0649 30% \u0644\u0645\u0646 \u064a\u062a\u062c\u0627\u0648\u0632 \u062f\u062e\u0644\u0647 <span id=\"lcu_120k\">[lcu_120k: $120,000]<\/span>\u060c \u0628\u064a\u0646\u0645\u0627 \u062a\u0635\u0644 \u0625\u0644\u0649 \u0646\u0633\u0628\u0629 45% \u0644\u0643\u0644 \u0645\u0646 \u064a\u062a\u062c\u0627\u0648\u0632 \u062f\u062e\u0644\u0647 <span id=\"lcu_1M\">[lcu_1M: $1 million]<\/span>.\u00a0<\/b><br \/>\n\u0641\u0625\u0630\u0627 \u0643\u0627\u0646 \u0647\u0646\u0627\u0643 \u0634\u062e\u0635 \u0645\u0627 \u064a\u0628\u0644\u063a \u062f\u062e\u0644\u0647 <span class=\"lcu_90k\">[lcu_90k: $90,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span> \u0633\u064a\u062a\u0645 \u0628\u0639\u062f \u062e\u0635\u0645 \u0627\u0644\u0636\u0631\u0627\u0626\u0628 \u0627\u0642\u062a\u0637\u0627\u0639 \u0645\u0628\u0644\u063a <span id=\"lcu_1500_top3\">[lcu_1500_top3: $1,500]<\/span>\u00a0\u0648\u0630\u0644\u0643 \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0636\u0631\u0627\u0626\u0628\u060c \u0623\u0648 \u0645\u0627 \u064a\u064f\u0639\u0627\u062f\u0644 15% \u0648\u0630\u0644\u0643 \u0648\u0641\u0642\u064b\u0627 \u0644\u0644\u0645\u0639\u0627\u062f\u0644\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629: <span class=\"lcu_90k\">[lcu_90k: $90,000]<\/span> - <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span> = <span id=\"lcu_10k_top3\">[lcu_10k_top3: $10,000]<\/span>. \u0628\u064a\u0646\u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0647\u0646\u0627\u0643 \u0632\u0648\u062c\u0627\u0646 \u064a\u0628\u0644\u063a \u0645\u062c\u0645\u0648\u0639 \u062f\u062e\u0644\u0647\u0645\u0627 <span id=\"lcu_150k\">[lcu_150k: $150,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>\u060c \u0648\u0628\u0648\u0627\u0642\u0639 <span id=\"lcu_75k\">[lcu_75k: $75,000]<\/span> \u0644\u0643\u0644 \u0645\u0646\u0647\u0645\u0627\u060c \u0644\u0646 \u064a\u062a\u0645 \u0641\u0631\u0636 \u0636\u0631\u0627\u0626\u0628 \u0639\u0644\u0649 \u0623\u064a \u0645\u0646\u0647\u0645\u0627.<br \/>\n<br \/>\n<b>\u0647\u0644 \u0623\u0646\u062a \u0645\u0639 \u0623\u0645 \u0636\u062f \u0641\u0631\u0636 \u0636\u0631\u064a\u0628\u0629 \u0639\u0627\u0644\u0645\u064a\u0629 \u0639\u0644\u0649 \u0623\u062b\u0631\u064a\u0627\u0621 \u0627\u0644\u0639\u0627\u0644\u0645 \u0645\u0646 \u0623\u062c\u0644 \u0645\u0643\u0627\u0641\u062d\u0629 \u0627\u0644\u0641\u0642\u0631 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u061f<\/b>","Choices":{"1":{"Display":"\u0623\u0639\u0627\u0631\u0636 \u0628\u0634\u062f\u0629"},"2":{"Display":"\u0623\u0624\u064a\u062f \u0625\u0644\u0649 \u062d\u062f \u0645\u0627"},"3":{"Display":"\u0623\u0624\u064a\u062f \u0628\u0634\u062f\u0629"},"4":{"Display":"\u0623\u0639\u0627\u0631\u0636 \u0625\u0644\u0649 \u062d\u062f \u0645\u0627\u00a0"},"5":{"Display":"\u0644\u0627 \u0623\u0643\u062a\u0631\u062b"}}},"FR":{"QuestionText":"Actuellement, 3 milliards de personnes vivent en situation de pauvret\u00e9 profonde, avec moins de <span class=\"lcu_400\">[lcu_400\u00a0: 400\u00a0$]<\/span> <span class=\"periodicity\">[p\u00e9riodicit\u00e9\u00a0: par mois]<\/span>.<br \/>\nLes Objectifs de d\u00e9veloppement durable, adopt\u00e9s par tous les pays en 2015, visent \u00e0 r\u00e9duire la pauvret\u00e9 et \u00e0 assurer l\u2019acc\u00e8s aux soins, \u00e0 l\u2019\u00e9ducation, \u00e0 l\u2019eau potable et \u00e0 l\u2019assainissement pour tous d\u2019ici 2030. Le monde n\u2019est pas sur la bonne voie pour atteindre ces objectifs de r\u00e9duction de la pauvret\u00e9 en raison du manque de financement.<br \/>\n<br \/>\n<b>La r\u00e9duction de la pauvret\u00e9 pourrait \u00eatre financ\u00e9e par un imp\u00f4t mondial sur les revenus sup\u00e9rieurs \u00e0 <span class=\"lcu_80k\">[lcu_80k\u00a0: 80\u00a0000\u00a0$]<\/span><span class=\"periodicity_tax\">[periodicity_tax\u00a0: par an]<\/span>.<br \/>\nLe taux d'imposition serait de 15 % pour chaque dollar au-dessus de <span class=\"lcu_80k\">[lcu_80k: 80 000 $]<\/span> de revenu apr\u00e8s imp\u00f4ts existants, de 30 % au-dessus de <span id=\"lcu_120k\">[lcu_120k: 120 000 $]<\/span> et de 45 % au-dessus de <span id=\"lcu_1M\">[lcu_1M: 1 million $]<\/span>.<\/b><br \/>\nPar exemple, une personne seule gagnant <span class=\"lcu_90k\">[lcu_90k: 90\u00a0000 $]<\/span><span class=\"periodicity_tax\">[periodicity_tax: par an]<\/span> apr\u00e8s imp\u00f4ts paierait <span id=\"lcu_1500_top3\">[lcu_1500_top3: 1\u00a0500 $]<\/span> d'imp\u00f4ts suppl\u00e9mentaires, soit 15 % de <span id=\"lcu_10k_top3\">[lcu_10k_top3: 10\u00a0000 $]<\/span> = <span class=\"lcu_90k\">[lcu_90k: 90\u00a0000 $]<\/span> - <span class=\"lcu_80k\">[lcu_80k: 80\u00a0000 $]<\/span>. En revanche, un couple mari\u00e9 gagnant <span id=\"lcu_150k\">[lcu_150k\u00a0: 150\u00a0000\u00a0$]<\/span><span class=\"periodicity_tax\">[periodicity_tax\u00a0: par an]<\/span>, <span id=\"lcu_75k\">[lcu_75k\u00a0: 75\u00a0000\u00a0$]<\/span> pour chacun d'eux, ne serait pas impos\u00e9.<br \/>\nCet imp\u00f4t s\u2019appliquerait aux 3 % les plus riches de la population mondiale. <span id=\"tax_country_name\">[tax_country_name: Aux \u00c9tats-Unis]<\/span>, cela affecterait les <span id=\"affected_top3\">[affected_top3: 18]<\/span> % les plus riches et redistribuerait <span id=\"transfer_top3\">[transfer_top3: 8]<\/span> % du PIB aux pays \u00e0 bas revenus.<br \/>\n<br \/>\n<b>\u00cates-vous favorable ou oppos\u00e9\u22c5e \u00e0 une telle taxe mondiale sur les personnes les plus riches pour financer la r\u00e9duction de la pauvret\u00e9 dans le monde ?<\/b>","Choices":{"1":{"Display":"Tr\u00e8s oppos\u00e9\u22c5e"},"4":{"Display":"Plut\u00f4t oppos\u00e9\u22c5e"},"5":{"Display":"Indiff\u00e9rent\u22c5e ou ne sais pas"},"2":{"Display":"Plut\u00f4t favorable"},"3":{"Display":"Tr\u00e8s favorable"}}},"IT-CH":[],"JA":[],"PL":{"QuestionText":"Obecnie 3 miliardy ludzi \u017cyj\u0105 w skrajnym ub\u00f3stwie, zarabiaj\u0105c mniej ni\u017c <span class=\"lcu_400\">800 PLN<\/span><span class=\"periodicity\"> miesi\u0119cznie<\/span>.<br \/>\n<br \/>\n<b>Zmniejszenie ub\u00f3stwa mog\u0142oby by\u0107 finansowane przez globalny podatek od dochodu indywidualnego przekraczaj\u0105cego <span class=\"lcu_80k\">13 000 PLN<\/span><span class=\"periodicity_tax\"> miesi\u0119cznie<\/span>.<br \/>\nStawka podatku wynios\u0142aby 15% za ka\u017cd\u0105 <span id=\"currency\">z\u0142ot\u00f3wk\u0119<\/span> powy\u017cej <span class=\"lcu_80k\">13 000 PLN<\/span> dochodu, po odliczeniu istniej\u0105cych podatk\u00f3w, 30% powy\u017cej <span id=\"lcu_120k\">20 000 PLN<\/span> i 45% powy\u017cej <span id=\"lcu_1M\">150 000 PLN<\/span>.<\/b><br \/>\nNa przyk\u0142ad, jedna osoba zarabiaj\u0105ca <span class=\"lcu_90k\">14 000 PLN<\/span><span class=\"periodicity_tax\"> miesi\u0119cznie<\/span>, po opodatkowaniu zap\u0142aci\u0142aby <span id=\"lcu_1500_top3\">150 PLN<\/span> dodatkowego podatku, czyli 15% z <span id=\"lcu_10k_top3\">1 000 PLN<\/span> = <span class=\"lcu_90k\">14 000 \u2013<\/span> <span class=\"lcu_80k\">13 000 PLN<\/span>.<br \/>\n<br \/>\n<b>Czy popar\u0142(a)by Pan\/Pani taki globalny podatek dla najbogatszych w celu finansowania redukcji ub\u00f3stwa na \u015bwiecie, czy by\u0142(a)by mu Pan\/Pani przeciwny(-a)?<\/b>","Choices":{"1":{"Display":"Jestem zdecydowanie przeciw"},"4":{"Display":"Jestem raczej przeciw"},"5":{"Display":"Nie mam zdania"},"2":{"Display":"Jestem raczej za"},"3":{"Display":"Jestem zdecydowanie za"}}},"RU":[],"DE":{"QuestionText":"Derzeit leben 3 Milliarden Menschen in schwerer Armut mit einem Einkommen unter <span class=\"lcu_400\">[lcu_400: $400]<\/span><span class=\"periodicity\">[periodicity: per month]<\/span>.<br \/>\n<br \/>\n<strong>Eine globale Steuer auf individuelle Einkommen \u00fcber <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>k\u00f6nnte zur Finanzierung der Armutsbek\u00e4mpfung beitragen.\u00a0<\/strong><br \/>\n<strong>Der Steuersatz l\u00e4ge bei 15 % auf jeden <span class=\"currency\">[currency: dollar]<\/span> oberhalb von <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span> <\/strong>nach steuerlichen Abgaben,\u00a0<strong>30% auf \u00fcber\u00a0<span id=\"lcu_120k\">[lcu_120k: $120,000]<\/span>, und 45% auf \u00fcber\u00a0<span id=\"lcu_1M\">[lcu_1M: $1 million]<\/span>.\u00a0<\/strong><br \/>\n<br \/>\nZum Beispiel: Eine Einzelperson mit einem Einkommen von <span class=\"lcu_90k\">[lcu_90k: $90,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span> nach steuerlichen Abgaben, w\u00fcrde zus\u00e4tzlich <span id=\"lcu_1500_top3\">[lcu_1500_top3: $1,500]<\/span> an Steuern zahlen, also 15 % von <span id=\"lcu_10k_top3\">[lcu_10k_top3: $10,000]<\/span> = <span class=\"lcu_90k\">[lcu_90k: $90,000]<\/span> - <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span>. Ein verheiratetes Paar mit einem gemeinsamen Einkommen von <span id=\"lcu_150k\">[lcu_150k: $150,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>, (also jeweils <span id=\"lcu_75k\">[lcu_75k: $75,000]<\/span> pro Person) w\u00fcrde jedoch nicht besteuert.<br \/>\n<br \/>\n<strong>Bef\u00fcrworten oder lehnen Sie eine solche globale Steuer auf die reichsten Menschen zur Finanzierung der weltweiten Armutsbek\u00e4mpfung ab?<\/strong>","Choices":{"1":{"Display":"Sehr dagegen"},"2":{"Display":"Eher daf\u00fcr"},"3":{"Display":"Sehr daf\u00fcr"},"4":{"Display":"Eher dagegen"},"5":{"Display":"Keine Meinung"}}},"EN":[],"DE-CH":[],"FR-CH":[],"ES-ES":{"QuestionText":"Actualmente, 3 mil millones de personas viven en extrema pobreza, con menos de <span class=\"lcu_400\">[lcu_400: $400]<\/span><span class=\"periodicity\">[periodicity: per month]<\/span>.<br \/>\n<br \/>\n<b>La reducci\u00f3n de la pobreza podr\u00eda financiarse mediante un impuesto global sobre los ingresos individuales superiores a <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>.\u00a0<br \/>\nLa tasa impositiva ser\u00eda del 15% por cada <span class=\"currency\">[currency: dollar]<\/span> que supere los <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span> de ingreso<\/b> despu\u00e9s de impuestos existentes, <b>30% over <span id=\"lcu_120k\">[lcu_120k: $120,000]<\/span>, y 45% sobre <span id=\"lcu_1M\">[lcu_1M: $1 million]<\/span>.\u00a0<\/b><br \/>\nPor ejemplo, una persona soltera que gana <span class=\"lcu_90k\">[lcu_90k: $90,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span> despu\u00e9s de impuestos pagar\u00eda <span id=\"lcu_1500_top3\">[lcu_1500_top3: $1,500]<\/span> en impuestos adicionales, o el 15% de <span id=\"lcu_10k_top3\">[lcu_10k_top3: $10,000]<\/span> = <span class=\"lcu_90k\">[lcu_90k: $90,000]<\/span> - <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span>. Mientras tanto, una pareja casada que gana <span id=\"lcu_150k\">[lcu_150k: $150,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>, <span id=\"lcu_75k\">[lcu_75k: $75,000]<\/span> para cada uno, no pagar\u00eda impuestos.<br \/>\n<br \/>\n<b>\u00bfEst\u00e1 a favor o en contra de un impuesto global de este tipo para los m\u00e1s ricos para financiar la reducci\u00f3n de la pobreza global?<\/b>","Choices":{"1":{"Display":"Totalmente en contra"},"2":{"Display":"Levemente a favor"},"3":{"Display":"Totalmente a favor"},"4":{"Display":"Levemente en contra"},"5":{"Display":"Indiferente o no sabe"}}},"ES-US":[],"IT":{"QuestionText":"Attualmente, 3 miliardi di persone vivono in condizioni di profonda povert\u00e0, con meno di <span class=\"lcu_400\">[lcu_400: $400]<\/span><span class=\"periodicity\">[periodicity: per month]<\/span>.<br \/>\n<br \/>\n<b>La riduzione della povert\u00e0 potrebbe essere finanziata attraverso una tassa globale sui redditi individuali superiori a <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>.\u00a0<br \/>\nL'aliquota fiscale sarebbe del 15% per ogni <span class=\"currency\">[currency: dollar]<\/span> superiore a <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span> di reddito<\/b> al netto delle tasse esistenti, del <b>30% per ogni euro superiore a <span id=\"lcu_120k\">[lcu_120k: $120,000]<\/span>, e del 45% per ogni euro superiore a <span id=\"lcu_1M\">[lcu_1M: $1 million]<\/span>.\u00a0<\/b><br \/>\nAd esempio, un individuo che guadagna <span class=\"lcu_90k\">[lcu_90k: $90,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span> al netto delle tasse pagherebbe <span id=\"lcu_1500_top3\">[lcu_1500_top3: $1,500]<\/span> in tasse aggiuntive, o il 15% di <span id=\"lcu_10k_top3\">[lcu_10k_top3: $10,000]<\/span> = <span class=\"lcu_90k\">[lcu_90k: $90,000]<\/span> - <span class=\"lcu_80k\">[lcu_80k: $80,000]<\/span>. Intanto, una coppia sposata che guadagna <span id=\"lcu_150k\">[lcu_150k: $150,000]<\/span><span class=\"periodicity_tax\">[periodicity_tax: per year]<\/span>, <span id=\"lcu_75k\">[lcu_75k: $75,000]<\/span> ciascuno, non sarebbe tassata.<br \/>\n<br \/>\n<b>Sei a favore o contrario a questa tassa globale sulle persone pi\u00f9 ricche per finanziare la riduzione della povert\u00e0 nel mondo?<\/b>","Choices":{"1":{"Display":"Fortemente in disaccordo"},"2":{"Display":"Leggermente d'accordo"},"3":{"Display":"Fortemente d'accordo"},"4":{"Display":"Leggermente in disaccordo"},"5":{"Display":"Indifferente"}}},"EN-GB":[]},"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID115"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID116","SecondaryAttribute":"Do you support or oppose the following policies? [developed_note_long: (As some items refer to \"d...","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you support or oppose the following policies?<br><br><span id=\"developed_note_long\">[developed_note_long: (As some items refer to \"developed countries\", note that we consider Saudi Arabia to be a developed country in this question.)]<\/span>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/\/ Loads CSV and create variables from the column corresponding to Q_Language\n\t$j(document).ready(function($j){\t\n\t\t$j.ajax({\n\t\t\turl:\"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_yuKEs6pwxsAid44\",\n\t\t\tsuccess: function(csv){\n\t\t\t\t\n\t\t\tconst language = Qualtrics.SurveyEngine.getEmbeddedData(\"Q_Language\"); \n\t\t\t\t\n\t\t\tconst rows = csv.split('\\n').map(row => row.split('|'));\n\t\t\tconst headers = rows[0];\n\t\t\tconst col = headers.indexOf(language);\n\n\t\t\tif (col === -1) {\n\t\t\t\tconsole.error(\"Column 'language' not found in the CSV file.\");\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t\/\/ Iterate through the rows and create variables dynamically\n\t\t\tfor (let i = 1; i < rows.length-1; i++) {\n\t\t\t\tconst name = rows[i][0]; \/\/ Assuming the row name is in the first column\n\t\t\t\tconst value = rows[i][col];\n\t\t\t\twindow[name] = value; \n\t\t\t\t$j(\"#\" + name).html(value);\n\t\t\t\tconsole.log(`Variable ${name} created with value: ${value}`);\n\t\t\t}\n\n\t\t\t\t},\n\t\t\terror: function(){ alert('Data could not be loaded');}\n\t\t});\n\t});\n});","DefaultChoices":false,"DataExportTag":"solidarity_support_c","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","NumColumns":1,"TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"both","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Do you support or oppose the following policies? [developed_note_long: (As some items refer to \"d...","Choices":{"1":{"Display":"Institutions like the World Bank investing in many more sustainable projects in lower-income countries, and offering lower interest rates (the Bridgetown initiative)"},"4":{"Display":"Expanding the UN Security Council (in charge of peacekeeping) to new permanent members such as India, Brazil, and the African Union, and restricting the use of the veto"},"5":{"Display":"Raising the globally agreed minimum tax rate on profits of multinational firms from 15% to 35%, closing loopholes and allocating revenues to countries where sales are made"},"10":{"Display":"Developed countries contributing at least 0.7% of their GDP in foreign aid and development assistance"},"11":{"Display":"A minimum tax of 2% on the wealth of billionaires, in voluntary countries"}},"ChoiceOrder":["11",5,4,10,1],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":{"AR":{"QuestionText":"\u0647\u0644 \u062a\u062f\u0639\u0645 \u0623\u0645 \u062a\u0639\u0627\u0631\u0636 \u0627\u0644\u0633\u064a\u0627\u0633\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u061f<br \/>\n<br \/>\n<span id=\"developed_note_long\">[developed_note_long: (As some items refer to \"developed countries\", note that we consider Saudi Arabia to be a developed country in this question.)]<\/span>","Choices":{"1":{"Display":"\u0627\u0633\u062a\u062b\u0645\u0627\u0631 \u0645\u0624\u0633\u0633\u0627\u062a \u0645\u062b\u0644 \u0627\u0644\u0628\u0646\u0643 \u0627\u0644\u062f\u0648\u0644\u064a \u0641\u064a \u0639\u062f\u062f \u0623\u0643\u0628\u0631 \u0645\u0646 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0623\u0643\u062b\u0631 \u0627\u0633\u062a\u062f\u0627\u0645\u0629 \u0641\u064a \u0627\u0644\u0628\u0644\u062f\u0627\u0646 \u0630\u0627\u062a \u0627\u0644\u062f\u062e\u0644 \u0627\u0644\u0645\u0646\u062e\u0641\u0636\u060c \u0648\u062a\u0642\u062f\u064a\u0645 \u0623\u0633\u0639\u0627\u0631 \u0641\u0627\u0626\u062f\u0629 \u0645\u0646\u062e\u0641\u0636\u0629 (\u0645\u0628\u0627\u062f\u0631\u0629 \u0628\u0631\u064a\u062f\u062c \u062a\u0627\u0648\u0646)"},"4":{"Display":"\u0632\u064a\u0627\u062f\u0629 \u0639\u062f\u062f \u0623\u0639\u0636\u0627\u0621 \u0645\u062c\u0644\u0633 \u0627\u0644\u0623\u0645\u0646 \u0627\u0644\u062a\u0627\u0628\u0639 \u0644\u0644\u0623\u0645\u0645 \u0627\u0644\u0645\u062a\u062d\u062f\u0629 (\u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0639\u0646 \u062d\u0641\u0638 \u0627\u0644\u0633\u0644\u0627\u0645) \u0644\u064a\u0634\u0645\u0644 \u0623\u0639\u0636\u0627\u0621 \u062c\u062f\u062f \u0643\u0627\u0644\u0647\u0646\u062f \u0648\u0627\u0644\u0628\u0631\u0627\u0632\u064a\u0644 \u0648\u0627\u0644\u0627\u062a\u062d\u0627\u062f \u0627\u0644\u0627\u0641\u0631\u064a\u0642\u064a\u060c \u0648\u062a\u0642\u064a\u064a\u062f \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062d\u0642 \u0627\u0644\u0646\u0642\u0636 \u0627\u0644\u0641\u064a\u062a\u0648 \u0645\u0646 \u0642\u0650\u0628\u0644 \u0623\u0639\u0636\u0627\u0626\u0647"},"5":{"Display":"\u0631\u0641\u0639 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0627\u0644\u0645\u062a\u0641\u0642 \u0639\u0644\u064a\u0647 \u0639\u0627\u0644\u0645\u064a\u064b\u0627 \u0644\u0636\u0631\u064a\u0628\u0629 \u0623\u0631\u0628\u0627\u062d \u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u062c\u0646\u0633\u064a\u0627\u062a \u0645\u0646 15% \u0625\u0644\u0649 35%\u060c \u0648\u0633\u062f \u0627\u0644\u062b\u063a\u0631\u0627\u062a \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0648\u062a\u0648\u0632\u064a\u0639 \u0627\u0644\u0639\u0627\u0626\u062f\u0627\u062a \u0628\u0634\u0643\u0644 \u0639\u0627\u062f\u0644 \u0628\u064a\u0646 \u0627\u0644\u0628\u0644\u062f\u0627\u0646"},"10":{"Display":"\u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u062f\u0648\u0644 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0644\u0646\u0633\u0628\u0629 0.7% \u0645\u0646 \u0625\u062c\u0645\u0627\u0644\u064a \u0646\u0627\u062a\u062c\u0647\u0627 \u0627\u0644\u0642\u0648\u0645\u064a \u0644\u0644\u0645\u0633\u0627\u0647\u0645\u0629 \u0641\u064a \u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0627\u062a \u0648\u0627\u0644\u062a\u0646\u0645\u064a\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629"},"11":{"Display":"\u0641\u0631\u0636 \u0636\u0631\u064a\u0628\u0629 \u0644\u0627 \u062a\u0642\u0644 \u0639\u0646 2% \u0639\u0644\u0649 \u062b\u0631\u0648\u0627\u062a \u0627\u0644\u0645\u0644\u064a\u0627\u0631\u062f\u064a\u0631\u0627\u062a \u0641\u064a \u0627\u0644\u062f\u0648\u0644 \u0627\u0644\u062a\u064a \u062a\u0642\u0628\u0644 \u062a\u0637\u0628\u064a\u0642\u0647\u0627 \u0637\u0648\u0639\u064a\u064b\u0627"}},"Answers":{"1":{"Display":"\u0623\u0639\u0627\u0631\u0636 \u0628\u0634\u062f\u0629"},"2":{"Display":"\u0623\u0639\u0627\u0631\u0636 \u0625\u0644\u0649 \u062d\u062f \u0645\u0627"},"3":{"Display":"\u0644\u0627 \u0623\u0643\u062a\u0631\u062b \u0644\u0647\u0630\u0647 \u0627\u0644\u0633\u064a\u0627\u0633\u0629"},"4":{"Display":"\u0623\u062f\u0639\u0645 \u0625\u0644\u0649 \u062d\u062f \u0645\u0627"},"5":{"Display":"\u0623\u062f\u0639\u0645 \u0628\u0634\u062f\u0629"}}},"DE":{"QuestionText":"Bef\u00fcrworten oder lehnen Sie die folgenden Ma\u00dfnahmen ab?\n<div><br \/>\n<span id=\"developed_note_long\">[developed_note_long: (As some items refer to \"developed countries\", note that we consider Saudi Arabia to be a developed country in this question.)]<\/span><\/div>\n","Choices":{"1":{"Display":"<div>Institutionen wie die Weltbank investieren verst\u00e4rkt in nachhaltige Projekte in einkommensschwachen L\u00e4ndern und bieten niedrigere Zinss\u00e4tze an (Bridgetown-Initiative)<\/div>\n"},"4":{"Display":"Ausweitung des UN-Sicherheitsrats (zust\u00e4ndig f\u00fcr Friedenssicherung) um neue st\u00e4ndige Mitglieder wie Indien, Brasilien und die Afrikanische Union, sowie eine Begrenzung des Vetorechts der Mitglieder"},"5":{"Display":"<meta charset=\"UTF-8\" \/>Anhebung des global vereinbarten Mindeststeuersatzes auf Unternehmensgewinne multinationaler Konzerne von 15 % auf 35 %, so dass Steuerschlupfl\u00f6cher geschlossen und Einnahmen an die L\u00e4nder gehen, in denen die Verk\u00e4ufe get\u00e4tigt werden."},"10":{"Display":"Entwickelte L\u00e4nder stellen mindestens 0,7 % ihres BIP f\u00fcr Auslandshilfe und Entwicklungszusammenarbeit bereit"},"11":{"Display":"Eine 2% Mindestverm\u00f6gensteuer f\u00fcr Milliard\u00e4ren in freiwillig teilnehmenden L\u00e4ndern"}},"Answers":{"1":{"Display":"Sehr dagegen"},"2":{"Display":"Eher dagegen"},"3":{"Display":"Keine Meinung"},"4":{"Display":"Eher daf\u00fcr"},"5":{"Display":"Sehr daf\u00fcr"}}},"DE-CH":[],"EN":[],"EN-GB":[],"ES-ES":{"QuestionText":"\u00bfEst\u00e1 a favor o en contra de las siguientes pol\u00edticas?<br \/>\n<br \/>\n<span id=\"developed_note_long\">[developed_note_long: (As some items refer to \"developed countries\", note that we consider Saudi Arabia to be a developed country in this question.)]<\/span>","Choices":{"1":{"Display":"Instituciones como el Banco Mundial invierten en muchos m\u00e1s proyectos sostenibles en pa\u00edses de bajos ingresos y ofrecen tasas de inter\u00e9s m\u00e1s bajas (la iniciativa de Bridgetown)"},"4":{"Display":"Ampliar el Consejo de Seguridad de la ONU (encargado del mantenimiento de la paz) a nuevos miembros como India, Brasil y la Uni\u00f3n Africana, y restringir el uso del veto por parte de sus miembros."},"5":{"Display":"Aumentar el impuesto m\u00ednimo acordado en todo el mundo sobre los beneficios de las empresas multinacionales del 15% al 35%, cerrando las brechas y asignando los ingresos a los pa\u00edses donde se realizan las ventas."},"10":{"Display":"Pa\u00edses desarrollados que aportan al menos el 0,7% de su PIB en ayuda exterior y asistencia para el desarrollo."},"11":{"Display":"Un impuesto m\u00ednimo del 2% sobre la riqueza de los multimillonarios, en los pa\u00edses voluntarios."}},"Answers":{"1":{"Display":"Totalmente en contra"},"2":{"Display":"Levemente en contra"},"3":{"Display":"Indiferente o no sabe"},"4":{"Display":"Levemente a favor"},"5":{"Display":"Totalmente a favor"}}},"ES-US":[],"FR":{"QuestionText":"\u00cates-vous favorable ou oppos\u00e9\u22c5e aux mesures politiques suivantes\u00a0?","Choices":{"1":{"Display":"Des investissements d'institutions comme la Banque mondiale dans bien plus de projets de d\u00e9veloppement durables dans les pays \u00e0 bas revenus et \u00e0 des taux d'int\u00e9r\u00eat plus bas (l'initiative de Bridgetown)"},"4":{"Display":"\u00c9largir le Conseil de s\u00e9curit\u00e9 de l'ONU (charg\u00e9 du maintien de la paix) \u00e0 de nouveaux membres tels que l'Inde, le Br\u00e9sil et l'Union africaine, et restreindre l'usage du veto par ses membres"},"5":{"Display":"Augmenter de 15% \u00e0 35% le taux minimum d'imposition des profits des multinationales adopt\u00e9 au niveau mondial, \u00e9liminer les lacunes juridiques et partager \u00e9quitablement les recettes entre les pays."},"10":{"Display":"Que les pays d\u00e9velopp\u00e9s contribuent au moins 0,7% de leur PIB \u00e0 l\u2019aide au d\u00e9veloppement des pays \u00e0 bas revenus"},"11":{"Display":"Un imp\u00f4t minimum de 2% sur la fortune des milliardaires, dans les pays volontaires"}},"Answers":{"1":{"Display":"Tr\u00e8s oppos\u00e9\u22c5e"},"2":{"Display":"Plut\u00f4t oppos\u00e9"},"3":{"Display":"Indiff\u00e9rent\u22c5e ou ne sais pas"},"4":{"Display":"Plut\u00f4t favorable"},"5":{"Display":"Tr\u00e8s favorable"}}},"FR-CH":[],"IT":{"QuestionText":"Sei a favore o ti opponi alle seguenti politiche?<br \/>\n<br \/>\n<span id=\"developed_note_long\">[developed_note_long: (Poich\u00e9 alcune voci fanno riferimento ai \"paesi sviluppati\", si noti che in questa domanda consideriamo l'Arabia Saudita un paese sviluppato.)]<\/span>","Choices":{"1":{"Display":"Istituzioni come la Banca Mondiale che investano in molti pi\u00f9 progetti sostenibili nei paesi a basso reddito e offrano tassi di interesse pi\u00f9 bassi (l'iniziativa Bridgetown)"},"4":{"Display":"Ampliare il Consiglio di Sicurezza delle Nazioni Unite (responsabile del mantenimento della pace) a nuovi membri come India, Brasile e Unione Africana, e limitare l'uso del diritto di veto da parte dei suoi membri"},"5":{"Display":"Aumentare l\u2019aliquota minima concordata a livello globale sugli utili delle multinazionali dal 15% al \u200b\u200b35%, chiudere le scappatoie fiscali e ripartire equamente i ricavi tra i paesi"},"10":{"Display":"Un contributo da parte dei Paesi sviluppati con almeno lo 0,7% del loro PIL da destinare agli aiuti esteri e all'assistenza allo sviluppo"},"11":{"Display":"Un&#39;imposta minima del 2% sulla ricchezza dei miliardari, nei paesi volontari"}},"Answers":{"1":{"Display":"Fortemente contrario"},"2":{"Display":"Leggermente contrario"},"3":{"Display":"Indifferente"},"4":{"Display":"Leggermente d'accordo"},"5":{"Display":"Fortemente d'accordo"}}},"IT-CH":[],"JA":[],"PL":{"QuestionText":"Czy popiera Pan\/Pani nast\u0119puj\u0105ce inicjatywy, czy te\u017c jest Pan\/Pani im przeciwny(-a)?<br \/>\n<br \/>\n<span id=\"developed_note_long\">(Poniewa\u017c niekt\u00f3re pozycje odnosz\u0105 si\u0119 do \u201ekraj\u00f3w rozwini\u0119tych\u201d, prosz\u0119 wzi\u0105\u0107 pod uwag\u0119, \u017ce Polska nale\u017cy do kraj\u00f3w rozwini\u0119tych)<\/span>.","Choices":{"1":{"Display":"Globalne instytucje finansowe inwestuj\u0105ce w wiele bardziej zr\u00f3wnowa\u017conych projekt\u00f3w w krajach o ni\u017cszych dochodach i oferuj\u0105ce ni\u017csze stopy procentowe (inicjatywa Bridgetown)"},"4":{"Display":"Rozszerzenie Rady Bezpiecze\u0144stwa ONZ na nowych cz\u0142onk\u00f3w, takich jak Indie, Brazylia i Unia Afryka\u0144ska, a tak\u017ce ograniczenie stosowania weta przez jej cz\u0142onk\u00f3w, aby bardziej efektywnie utrzymywa\u0107 pok\u00f3j"},"5":{"Display":"Podniesienie uzgodnionej na ca\u0142ym \u015bwiecie minimalnej stawki podatku od os\u0