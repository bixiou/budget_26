es dynamically\n\t\t\tfor (let i = 1; i < rows.length-1; i++) {\n\t\t\t\tconst name = rows[i][0]; \/\/ Assuming the row name is in the first column\n\t\t\t\tconst value = rows[i][col];\n\t\t\t\twindow[name] = value; \n\t\t\t\t$j(\"#\" + name).html(value);\n\t\t\t\t$j(\".\" + name).html(value);\n\t\t\t\tconsole.log(`Variable ${name} created with value: ${value}`);\n\t\t\t}\n\n\t\t\t\t},\n\t\t\terror: function(){ alert('Data could not be loaded');}\n\t\t});\n\t});\n});"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Imaginez une taxe solidaire sur les millionnaires. Seule la fortune au-del\u00e0 de 1 million d'euros...","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Imaginez une taxe solidaire sur les millionnaires.<\/b><br>\nSeule la fortune au-del\u00e0 de 1 million d'euros serait tax\u00e9e, au taux de 2&nbsp;%. L'\u00c9tat fran\u00e7ais conserverait 70&nbsp;% des revenus collect\u00e9s, tandis que 30&nbsp;% servirait \u00e0 financer les services publics des pays \u00e0 bas revenus (notamment l\u2019acc\u00e8s \u00e0 l\u2019eau potable, la sant\u00e9 et l\u2019\u00e9ducation en Afrique).<br>\n<br><b>\nSoutenez-vous cette taxe sur les millionnaires ?<\/b>","DefaultChoices":false,"DataExportTag":"solidary_tax_support","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Imaginez une taxe solidaire sur les millionnaires. Seule la fortune au-del\u00e0 de 1 million d'euros...","Choices":{"1":{"Display":"Oui"},"2":{"Display":"Non"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":{"FR":{"Choices":{"1":{"Display":"Oui"},"2":{"Display":"Non"}}}},"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID8","QuestionText_Unsafe":"<b>Imagine an international tax on individuals with net worth above <span class=\"wealth_threshold\">[wealth_threshold: $1 million]<\/span>.&nbsp;<\/b><br>Only wealth above <span class=\"wealth_threshold\">[wealth_threshold: $1 million]<\/span> would be taxed, at a rate of 2%. Each country would retain 70% of the revenues it collects, while 30% would be pooled at the global level to finance public services in low-income countries (in particular, access to drinking water, healthcare, and education in Africa). <br><br>Say we are in 2030. <b>Imagine that all other countries in the world adopt this policy. <br>Do you support <span id=\"country_name\">[country_name: the United States]<\/span> adopting this international tax on millionaires?<\/b><br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\tQualtrics.SurveyEngine.setEmbeddedData(\"time_gcs\", Date.now()\/1000);\n\tconst time_before = Qualtrics.SurveyEngine.getEmbeddedData(\"time_wtp\");\n\tQualtrics.SurveyEngine.setEmbeddedData(\"duration_gcs\", Date.now()\/1000 - time_before);\n\t\n\t\/\/ Loads CSV and create variables from the column corresponding to Q_Language\n\t$j(document).ready(function($j){\t\n\t\t$j.ajax({\n\t\t\turl:\"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_yuKEs6pwxsAid44\",\n\t\t\tsuccess: function(csv){\n\t\t\t\t\n\t\t\tconst language = Qualtrics.SurveyEngine.getEmbeddedData(\"Q_Language\"); \n\t\t\t\t\n\t\t\tconst rows = csv.split('\\n').map(row => row.split('|'));\n\t\t\tconst headers = rows[0];\n\t\t\tconst col = headers.indexOf(language);\n\n\t\t\tif (col === -1) {\n\t\t\t\tconsole.error(\"Column 'language' not found in the CSV file.\");\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t\/\/ Iterate through the rows and create variables dynamically\n\t\t\tfor (let i = 1; i < rows.length-1; i++) {\n\t\t\t\tconst name = rows[i][0]; \/\/ Assuming the row name is in the first column\n\t\t\t\tconst value = rows[i][col];\n\t\t\t\twindow[name] = value; \n\t\t\t\t$j(\"#\" + name).html(value);\n\t\t\t\t$j(\".\" + name).html(value);\n\t\t\t\tconsole.log(`Variable ${name} created with value: ${value}`);\n\t\t\t}\n\n\t\t\t\t},\n\t\t\terror: function(){ alert('Data could not be loaded');}\n\t\t});\n\t});\n});"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID80","SecondaryAttribute":"Est-ce probable ou pas que vous deveniez un jour millionnaire ? ","TertiaryAttribute":null,"Payload":{"QuestionText":"Est-ce probable ou pas que vous deveniez un jour millionnaire ?&nbsp;","DataExportTag":"millionaire","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Est-ce probable ou pas que vous deveniez un jour millionnaire ? ","Choices":{"1":{"Display":"Tr\u00e8s peu probable"},"2":{"Display":"Peu probable"},"3":{"Display":"Probable"},"4":{"Display":"Tr\u00e8s probable"},"5":{"Display":"Je suis d\u00e9j\u00e0 millionnaire"}},"ChoiceOrder":["1","2","3","4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":{"FR":{"QuestionText":"Est-ce probable ou pas que vous deveniez un jour millionnaire ?\u00a0","Choices":{"1":{"Display":"Tr\u00e8s peu probable"},"2":{"Display":"Peu probable"},"3":{"Display":"Probable"},"4":{"Display":"Tr\u00e8s probable"},"5":{"Display":"Je suis d\u00e9j\u00e0 millionnaire"}}}},"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID80","QuestionText_Unsafe":"How likely are you to become a millionaire at some point in your life?<span id=\"urbanity\"> <\/span>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t \t\t\t\/\/ URBANITY (also REGION below)\n\t\tconst country = Qualtrics.SurveyEngine.getEmbeddedData(\"country\");\n\t\tvar nb_digits = 5;\n\t\tif (country == \"FR\") {\n\t\t\tvar csv_urba = \"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_sgeRionmpQvME6A\";\n\t\t} else if (country == \"DE\") {\n\t\t\tvar csv_urba = \"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_uxFR5512uAFqYzj\";\n\t\t} else if (country == \"IT\") {\n\t\t\tvar csv_urba = \"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_hM9mXNm2q6goqqL\";\n\t\t} else if (country == \"PL\") {\n\t\t\tvar csv_urba = \"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_Z85BflUrhyaRwRQ\";\n\t\t} else if (country == \"ES\") {\n\t\t\tvar csv_urba = \"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_sHuFpvqSPy8aIqK\";\n\t\t} else if (country == \"GB\") {\n\t\t\tvar csv_urba = \"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_TnyYqOhx5l3ByWV\";\n\t\t\tnb_digits = 0;\n\t\t} else if (country == \"CH\") {\n\t\t\tvar csv_urba = \"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_ArWXRqJkwotjYKJ\";\n\t\t\tnb_digits = 4;\n\t\t} else if (country == \"JP\") {\n\t\t\tvar csv_urba = \"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_mBgp77TRTm4DFHF\";\n\t\t\tnb_digits = 7;\n\t\t} else if (country == \"RU\") {\n\t\t\tvar csv_urba = \"\";\n\t\t\tnb_digits = 6;\n\t\t} else if (country == \"SA\") {\n\t\t\tvar csv_urba = \"\";\n\t\t} else if (country == \"US\") {\n\t\t\tvar csv_urba = \"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_IQgx02GEO8fNMtm\";\n\t\t} else {\n\t\t\tvar csv_urba = \"\";\n\t\t}\n\t\n\t\tif (csv_urba == \"\") {\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"urbanity\", \"\");\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"region\", \"\");\n\t\t} else {\t\t\t\n\t\t\t$j.ajax({\n\t\t\t\turl: csv_urba,\n\t\t\t\tsuccess: function(data){\n\t\t\t\t\tvar postcode = \"${q:\/\/QID99\/ChoiceTextEntryValue}\"; \/\/ \"02001\" is stored as 2001.\n\t\t\t\t\tvar zipcode = postcode.toString().replaceAll(\"-\",\"\").toUpperCase();\n\t\t\t\t\tif (country != \"GB\") {\n\t\t\t\t\t\tzipcode = Number(zipcode); \/\/ probably useless\n\t\t\t\t\t\t\/*while (zipcode.length < nb_digits) { \n\t\t\t\t\t\t\tzipcode = '0' + zipcode; \n\t\t\t\t\t\t}*\/\n\t\t\t\t\t}\n\t\t\t\t\tvar i= 0, zip_urba = data.split('\\n'), found = false, urbanity = 0, region = 0;\n\t\t\t\t\tvar n = zip_urba.length;\n\t\t\t\t\twhile(i < n & !found) {\n\t\t\t\t\t\tvar zip_urba_i = zip_urba[i].split(',');\n\t\t\t\t\t\tvar zipcode_i = zip_urba_i[0];\n\t\t\t\t\t\tif (country != \"GB\") { zipcode_i = Number(zipcode_i); }\n\t\t\t\t\t\tif (zipcode_i == zipcode) { \n\t\t\t\t\t\t\turbanity = zip_urba_i[1];\n\t\t\t\t\t\t\tregion = zip_urba_i[2];\n\t\t\t\t\t\t\tfound = true;\n\t\t\t\t\t\t}\n\t\t\t\t\t\ti++;\n\t\t\t\t\t}\n\t\t\t\t\t\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"urbanity\", urbanity);\t\n\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"region\", region);\t\n\t\t\t\t\t\/\/$j('#urbanity').html(urbanity);\n\t\t\t\t\t\n\t\t\t\t\t\/\/ REGION\n\t\t\t\t\tif (country == \"US\") {\n\t\t\t\t\t\tvar state = zipcode.substr(0,1); \/\/ https:\/\/benfry.com\/zipdecode\/\n\t\t\t\t\t\tvar state2 = zipcode.substr(0,2); \/\/ https:\/\/en.wikipedia.org\/wiki\/List_of_ZIP_Code_prefixes\n\t\t\t\t\t\tvar West = ['8', '9'];\n\t\t\t\t\t\tvar South = ['2', '3', '7'];\n\t\t\t\t\t\tvar Northeast = ['0', '1' ];\n\t\t\t\t\t\tvar Midwest = ['4', '5', '6'];\n\t\t\t\t\t\tvar KY = ['40', '41', '42'];\n\t\t\t\t\t\tif (West.includes(state) || state2 == '59') {\n\t\t\t\t\t\t\tvar region = 'West';\n\t\t\t\t\t\t} else if (Northeast.includes(state)) {\n\t\t\t\t\t\t\tvar region = 'Northeast';\n\t\t\t\t\t\t} else if (South.includes(state) || KY.includes(state2)) {\n\t\t\t\t\t\t\tvar region = 'South';\n\t\t\t\t\t\t} else if (Midwest.includes(state) && state2 != '59' && (! KY.includes(state2))) {\n\t\t\t\t\t\t\tvar region = 'Midwest';\n\t\t\t\t\t\t}\n\t\t\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"region\", region);\n\t\t\t\t\t}\n\t\t\t\t},\n\t\t\t\terror: function(){ \n\t\t\t\t\talert('Fail of data loading');\n\t\t\t\t}\n\t\t\t});\n\t\t}\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID81","SecondaryAttribute":"Imagine if the two favorite candidates in your constituency in the next general election campaign...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2","4"],"Choices":{"1":{"Display":"Candidate A"},"2":{"Display":"Candidate B"},"4":{"Display":"None of them"}},"Configuration":{"LabelPosition":"BELOW","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q284","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":{"DE":{"Choices":{"1":{"Display":"Kandidat:in A"},"2":{"Display":"Kandidat:in B"},"4":{"Display":"Keine:n bon beiden"}},"QuestionText":"Stellen Sie sich vor, die beiden aussichtsreichsten Kandidat:innen in Ihrem Wahlkreis w\u00fcrden bei den n\u00e4chsten Bundestagswahlen mit den folgenden Politikma\u00dfnahmen f\u00fcr ihre jeweilige Partei antreten.<br \/>\n<br \/>\nWelchen dieser Kandidat:innen w\u00fcrden Sie w\u00e4hlen?\n<div>\n<table class=\"UserTable\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>Kandidat:in A<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\"><strong>Kandidat:in B<\/strong><\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\">Die Verm\u00f6gensteuer wieder in Kraft setzen<\/td>\n\t\t\t<td style=\"text-align: center;\">Unternehmenssteuerlast auf 25 Prozent senken<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\">Einen Fonds f\u00fcr gerechte Klimainvestitionen einsetzen<\/td>\n\t\t\t<td style=\"text-align: center;\">Klimaneutrale Industrie f\u00f6rdern<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\">Mehr finanzielle Unterst\u00fctzung f\u00fcr berufst\u00e4tige Eltern<\/td>\n\t\t\t<td style=\"text-align: center;\">Schuldenquote auf unter 60% reduzieren<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\">Nationales Umverteilungsprogramm<\/td>\n\t\t\t<td style=\"text-align: center;\">Investitionen f\u00fcr Gigabit-Netzwerke bereitstellen.<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n"},"EN-GB":{"Choices":{"1":{"Display":"Candidate A"},"2":{"Display":"Candidate B"},"4":{"Display":"None of them"}},"QuestionText":"Imagine if the two favorite candidates in your constituency in the next general election campaigned with the following policies in their party's platforms.<br \/>\n<br \/>\nWhich of these candidates would you vote for?\n<div>\u00a0\n<table class=\"UserTable\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>Candidate A<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\"><strong>Candidate B<\/strong><\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\">Increase taxes on capital income (rents and dividends)<\/td>\n\t\t\t<td style=\"text-align: center;\">Cut the burden of tax on business<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\">Ban the sale of new combustion-engine cars by 2030<\/td>\n\t\t\t<td style=\"text-align: center;\">\u00a3100 billion for infrastructures like road and rail<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\">\u00a3150 billion to upgrade schools, hospitals, care homes and council houses<\/td>\n\t\t\t<td style=\"text-align: center;\">Tougher sentencing for the worst offenders and 10,000 more prison places<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\">National redistribution scheme<\/td>\n\t\t\t<td style=\"text-align: center;\">Strict enforcement of immigration and border legislation<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n"},"ES-ES":{"Choices":{"1":{"Display":"Candidato A"},"2":{"Display":"Candidato B"},"4":{"Display":"Ninguno de ellos"}},"QuestionText":"Imagine que los dos candidatos favoritos de su distrito en las pr\u00f3ximas elecciones generales hicieran campa\u00f1a con las siguientes pol\u00edticas en sus programas de partido.<br \/>\n<br \/>\n\u00bfA cu\u00e1l de estos candidatos votar\u00eda?\n<div>\n<table class=\"UserTable\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>Candidato A<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\"><strong>Candidato B<\/strong><\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\">M\u00e1s necesidades sanitarias dentro del sistema p\u00fablico (cuidado dental, gafas, salud mental)<\/td>\n\t\t\t<td style=\"text-align: center;\">Rebaja del IRPF para todos los contribuyentes<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\">100% de electricidad producida con energ\u00edas renovables en 2040<\/td>\n\t\t\t<td style=\"text-align: center;\">Supresi\u00f3n del impuesto sobre el patrimonio y el impuesto de sucesiones<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\">Inversi\u00f3n en el sistema educativo y universalizaci\u00f3n de la educaci\u00f3n preescolar<\/td>\n\t\t\t<td style=\"text-align: center;\">Luchar firmemente contra el independentismo<\/td>\n\t\t<\/tr>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\">Plan de redistribuci\u00f3n nacional<\/td>\n\t\t\t<td style=\"text-align: center;\">Desgravar la vivienda en los impuestos e impulsar el campo<\/td>\n\t\t<\/tr>\n\t<\/tbody>\n<\/table>\n<\/div>\n"},"FR":{"Choices":{"1":{"Display":"Candidat A"},"2":{"Display":"Candidat B"},"4":{"Display":"Aucun des deux"}},"QuestionText":"Imaginez que les deux candidats du second tour \u00e0 la prochaine \u00e9lection pr\u00e9sidentielle fassent campagne avec les mesures suivantes dans leurs programmes.<br \/>\n<br \/>\nPour lequel de ces candidats voteriez-vous\u00a0?\n<div>\n<table class=\"UserTable\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"text-align: center;\"><strong>Candidat A<\/strong><\/td>\n\t\t\t<td style=\"text-align: center;\"><strong>Candidat B<\/stro