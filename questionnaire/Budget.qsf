veyEngine.setEmbeddedData(\"time_field\", Date.now()\/1000);\n\tconst time_before = Qualtrics.SurveyEngine.getEmbeddedData(\"time_consent\");\n\tQualtrics.SurveyEngine.setEmbeddedData(\"duration_socios_demos\", Date.now()\/1000 - time_before);\n\t\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID62","SecondaryAttribute":"Imagine a wealth tax applying on households with net worth above [tax_threshold: $5 million], ena...","TertiaryAttribute":null,"Payload":{"QuestionText":"Imagine a wealth tax applying on households with net worth above <span id=\"tax_threshold\">[tax_threshold: $5 million]<\/span>, enacted in all countries around the world.\n<br><br><span id=\"tax_country_name\">[tax_country_name: In the U.S.]<\/span>, the tax revenues collected would be <span id=\"tax_revenue\">[tax_revenue: $514 billion]<\/span> per year (that is, <span id=\"tax_revenue_gdp\">[tax_revenue_gdp: 2]<\/span>% of U.S. GDP), while it would be <span id=\"LIC_revenue\">[LIC_revenue: $1 billion]<\/span> in all low-income countries taken together (700 million people live in a low-income country, most of them in Africa).\nEach country would retain part of the revenues it collects and use it for different domestic purposes. The remaining part would be pooled at the global level to finance sustainable development.\n<br><br>What percentage of the global wealth tax revenue should be allocated to each category?&nbsp;The total must be 100%.<br><br>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n\tQualtrics.SurveyEngine.setEmbeddedData(\"time_conjoint\", Date.now()\/1000);\n\tconst time_before = Qualtrics.SurveyEngine.getEmbeddedData(\"time_field\");\n\tQualtrics.SurveyEngine.setEmbeddedData(\"dur