 bg: '#1a9641', text: '#ffffff' },\n        { bg: '#a6d96a', text: '#333333' },\n        { bg: '#eeeeee', text: '#333333' },\n        { bg: '#fdae61', text: '#333333' },\n        { bg: '#d7191c', text: '#ffffff' }\n    ].reverse();\n\n    var COLORS_6 = [\n        { bg: '#1a9641', text: '#ffffff' },\n        { bg: '#74c476', text: '#333333' },\n        { bg: '#c7e9b4', text: '#333333' },\n        { bg: '#fee08b', text: '#333333' },\n        { bg: '#f46d43', text: '#ffffff' },\n        { bg: '#d73027', text: '#ffffff' }\n    ].reverse();\n\n    \/* ================================================================\n       D\u00c9TECTION MOBILE\n    ================================================================ *\/\n    var isMobile = window.innerWidth < 768;\n\n    \/* ================================================================\n       R\u00c9CUP\u00c9RATION DE LA TABLE\n    ================================================================ *\/\n    var qid       = this.questionId;\n    var container = document.getElementById(qid);\n    var table     = container ? container.querySelector('table') : null;\n\n    if (!table) {\n        console.warn('[QMatrix Color] Table non trouv\u00e9e pour ' + qid);\n        return;\n    }\n\n    var rows = table.querySelectorAll('tr');\n    if (!rows.length) return;\n\n    \/* ================================================================\n       D\u00c9TECTION DU NOMBRE DE COLONNES\n    ================================================================ *\/\n    var firstRow    = rows[0];\n    var allCells    = firstRow.querySelectorAll('td, th');\n    var numColTotal = allCells.length;\n    var numAnswers  = numColTotal - 1;\n\n    var palette = null;\n    if      (numAnswers === 4) { palette = COLORS_4; }\n    else if (numAnswers === 5) { palette = COLORS_5; }\n    else if (numAnswers === 6) { palette = COLORS_6; }\n    else {\n        console.warn('[QMatrix Color] Nombre de colonnes non support\u00e9 : ' + numAnswers);\n        return;\n    }\n\n    \/* ================================================================\n       WRAPPER SCROLLABLE SUR MOBILE\n       Entoure la table d'un div scrollable horizontalement\n       si l'\u00e9cran est trop \u00e9troit\n    ================================================================ *\/\n    if (isMobile) {\n        var wrapper = document.createElement('div');\n        wrapper.style.overflowX  = 'auto';\n        wrapper.style.webkitOverflowScrolling = 'touch'; \/\/ scroll inertiel iOS\n        wrapper.style.width      = '100%';\n        wrapper.style.display    = 'block';\n        table.parentNode.insertBefore(wrapper, table);\n        wrapper.appendChild(table);\n\n        \/\/ Largeur minimale pour que les colonnes restent lisibles\n        var minColPx = 52; \/\/ px par colonne r\u00e9ponse\n        var minLabelPx = 110;\n        table.style.minWidth = (minLabelPx + numAnswers * minColPx) + 'px';\n    }\n\n    \/* ================================================================\n       APPLICATION DES COULEURS\n    ================================================================ *\/\n    rows.forEach(function (row) {\n        var cells = row.querySelectorAll('td, th');\n        cells.forEach(function (cell, idx) {\n            if (idx === 0) return;\n            var colorIdx = idx - 1;\n            if (colorIdx < palette.length) {\n                cell.style.backgroundColor = palette[colorIdx].bg;\n                cell.style.color           = palette[colorIdx].text;\n                cell.style.transition      = 'background-color 0.2s ease';\n            }\n        });\n    });\n\n    \/* ================================================================\n       LARGEURS ET MISE EN PAGE ADAPTATIVES\n    ================================================================ *\/\n    table.style.width       = isMobile ? 'auto' : '100%';\n    table.style.tableLayout = isMobile ? 'auto' : 'fixed';  \/\/ 'auto' sur mobile = plus flexible\n    table.style.fontSize    = isMobile ? '0.78em' : '0.88em';\n    table.style.borderCollapse = 'collapse';\n\n    var labelWidth  = isMobile ? 28 : 22; \/\/ % \u2014 libell\u00e9 plus large sur mobile\n    var answerWidth = Math.floor((100 - labelWidth) \/ numAnswers);\n\n    rows.forEach(function (row) {\n        var cells = row.querySelectorAll('td, th');\n        cells.forEach(function (cell, idx) {\n            if (idx === 0) {\n                cell.style.width    = isMobile ? 'auto' : labelWidth + '%';\n                cell.style.minWidth = isMobile ? '100px' : 'auto';\n                cell.style.padding  = isMobile ? '6px 6px' : '6px 8px';\n            } else {\n                cell.style.width     = isMobile ? 'auto' : answerWidth + '%';\n                cell.style.minWidth  = isMobile ? '48px' : 'auto';\n                cell.style.textAlign = 'center';\n                cell.style.wordBreak = 'break-word';\n                cell.style.padding   = isMobile ? '6px 2px' : '6px 4px';\n                cell.style.lineHeight = '1.2';\n            }\n        });\n    });\n\n    \/* ================================================================\n       EN-T\u00caTE\n    ================================================================ *\/\n    var headerRow = table.querySelector('tr:first-child');\n    if (headerRow) {\n        headerRow.querySelectorAll('td, th').forEach(function (cell, idx) {\n            if (idx > 0) {\n                cell.style.fontWeight   = 'bold';\n                cell.style.borderRadius = '4px 4px 0 0';\n                if (isMobile) {\n                    cell.style.fontSize  = '0.75em';\n                    cell.style.hyphens   = 'auto'; \/\/ coupe les mots longs\n                }\n            }\n        });\n    }\n\n    \/* ================================================================\n       RECALCUL AU REDIMENSIONNEMENT (rotation \u00e9cran, etc.)\n    ================================================================ *\/\n    window.addEventListener('resize', function () {\n        var nowMobile = window.innerWidth < 768;\n        table.style.fontSize = nowMobile ? '0.78em' : '0.88em';\n    });\n});"}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"S\u2019il existait un mouvement mondial pour lutter contre le changement climatique, taxer les million.","TertiaryAttribute":null,"Payload":{"QuestionText":"S\u2019il existait un mouvement mondial pour lutter contre le changement climatique, taxer les millionnaires et financer la r\u00e9duction de la pauvret\u00e9 dans les pays \u00e0 bas revenus, dans quelle mesure seriez-vous pr\u00eat\u22c5e \u00e0 faire partie de ce mouvement ? (R\u00e9ponses multiples possible)","DataExportTag":"global_movement","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"S\u2019il existait un mouvement mondial pour lutter contre le changement climatique, taxer les million...","Choices":{"1":{"Display":"Je ne soutiendrais pas un tel mouvement.","ExclusiveAnswer":true},"2":{"Display":"Je pourrais signer une p\u00e9tition et diffuser des id\u00e9es."},"3":{"Display":"Je pourrais faire un don de 100 \u20ac \u00e0 une caisse de gr\u00e8ve."},"4":{"Display":"Je pourrais participer \u00e0 une manifestation."},"6":{"Display":"Je pourrais faire gr\u00e8ve."}},"ChoiceOrder":["1","2","4","6","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":{"FR":{"QuestionText":"S\u2019il existait un mouvement mondial en faveur d\u2019un programme mondial visant \u00e0 lutter contre le changement climatique, \u00e0 taxer les millionnaires et \u00e0 financer la r\u00e9duction de la pauvret\u00e9 dans les pays \u00e0 bas revenus, dans quelle mesure seriez-vous pr\u00eat \u00e0 faire partie de ce mouvement ? (Plusieurs r\u00e9ponses possibles)","Choices":