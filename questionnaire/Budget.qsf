lass=\"unit_before\">$<\/span><span class=\"d3\">30<\/span>0<span class=\"unit_after\"> <\/span>"},"21":{"Display":"Entre\u00a0<span class=\"unit_before\">$<\/span><span class=\"d7\">70<\/span>1<span class=\"unit_after\"> <\/span>et\u00a0<span class=\"unit_before\">$<\/span><span class=\"q3\">75<\/span>0<span class=\"unit_after\"> <\/span>"},"23":{"Display":"Je pr\u00e9f\u00e8re ne pas r\u00e9pondre"}}}},"NextAnswerId":1,"NextChoiceId":24,"QuestionDescription":"Quel est le revenu [periodicity_text: mensuel] [income_type: brut] de votre m\u00e9nage [income_type_l...","QuestionID":"QID38","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function()\n{\n\n\t\t$j.ajax({\n\t\turl:\"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_erXidl42h25YBkS\",\n\t\tsuccess: function(data){\n\t\t\tconst language = Qualtrics.SurveyEngine.getEmbeddedData(\"Q_Language\");\n\t\t\tif (!language) {\n\t\t\t\tconsole.error(\"Embedded variable 'country' not found.\");\n\t\t\t\treturn;\n\t\t\t}\n\t\t\t\/\/var country = \"${q:\/\/QID33\/ChoiceGroup\/SelectedChoices}\"\n\t\t\tvar nb_pers = \"${q:\/\/QID35\/SelectedChoicesRecode}\";\n\t\t\tvar nb_children = \"${q:\/\/QID36\/SelectedChoicesRecode}\";\n\t\t\tvar nb_pers = parseInt(nb_pers[0]);\n\t\t\tvar nb_children = parseInt(nb_children[0]);\n\t\t\tvar uc = 0.5 + 0.5 * Math.max(nb_pers - nb_children, 0) + 0.3 * nb_children;\n\t\t\tif (language == \"US\" || language == \"ES-US\" || language == \"EN\") uc = 1;\n\n\t\t\tfunction customizeNumber(number, uc, round_at, periodicity, character) {\n\t\t\t  var custom = Math.round((number\/periodicity)  * uc \/ round_at) * round_at;\n\t\t\t  var numberString = custom.toString();\n\t\t\t  var numberStringWithCharacter = '';\n\t\t\t  var character = character.replaceAll('\"', '');\n\t\t\t  for (var i = 0; i < numberString.length; i++) {\n\t\t\t\tnumberStringWithCharacter = numberString[numberString.length-1-i] + numberStringWithCharacter;\n\t\t\t\tif (i % 3 == 2 && i != numberString.length - 1) {\n\t\t\t\t  numberStringWithCharacter = character + numberStringWithCharacter;\n\t\t\t\t}\n\t\t\t  }\n\t\t\t  return numberStringWithCharacter.slice(0, -1).replace(\/\\B(?=(\\d{2})+(?!\\d))\/g, \"\");\n\t\t\t}\n\n\t\t\t\/\/ Parse CSV into rows and columns\n\t\t\tconst rows = data.split(\"\\n\").map(row => row.split(\"|\"));\n\n\t\t\t\/\/ Step 3: Extract data from rows corresponding to the \"country\" column\n\t\t\tconst headers = rows[0]; \/\/ First row as headers\n\t\t\tconst countryIndex = headers.indexOf(language);\n\n\t\t\tif (countryIndex === -1) {\n\t\t\t\tconsole.error(`Column for country \"${language}\" not found.`);\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t\/\/ Fetch knowing row names\n\t\t\tconst rowNames = rows.slice(1).map(row => row[0]); \/\/ First column as row names\n\t\t\tconst values = rows.slice(1).map(row => row[countryIndex]); \/\/ Extract country-specific column values\t\t\n\t\t\tconst round_at = values[rowNames.indexOf(\"round_at\")] || null\n\t\t\tconst periodicity = values[rowNames.indexOf(\"periodicity\")] || null\n\t\t\tconst separator = values[rowNames.indexOf(\"separator\")] || null\n\t\t\tconst income_type_long = values[rowNames.indexOf(\"income_type_long\")] || null\n\t\t\tconst income_type = values[rowNames.indexOf(\"income_type\")] || null\n\t\t\tconst periodicity_text = values[rowNames.indexOf(\"periodicity_text\")] || null\n\t\t\tconst unit_before = values[rowNames.indexOf(\"unit_before\")] || null\n\t\t\tconst unit_after = values[rowNames.indexOf(\"unit_after\")] || null\n\n\t\t\t\/\/ Step 4: Assign values based on row names in the CSV\n\t\t\tconst variables = {\n\t\t\t\td1: values[rowNames.indexOf(\"d1\")] || null,\n\t\t\t\td2: values[rowNames.indexOf(\"d2\")] || null,\n\t\t\t\tq1: values[rowNames.indexOf(\"q1\")] || null,\n\t\t\t\td3: values[rowNames.indexOf(\"d3\")] || null,\n\t\t\t\td4: values[rowNames.indexOf(\"d4\")] || null,\n\t\t\t\td5: values[rowNames.indexOf(\"d5\")] || null,\n\t\t\t\td6: values[rowNames.indexOf(\"d6\")] || null,\n\t\t\t\td7: values[rowNames.indexOf(\"d7\")] || null,\n\t\t\t\tq3: values[rowNames.indexOf(\"q3\")] || null,\n\t\t\t\td8: values[rowNames.indexOf(\"d8\")] || null,\n\t\t\t\td9: values[rowNames.indexOf(\"d9\")] || null\n\t\t\t};\n\t\t\t\t\t\n\t\t\t\/* \/\/ With row numbers instead of row names\n\t\t\tconst table = rows.slice(1); \/\/ Skip headers\n\t\t\tconst values = table.map(row => row[countryIndex]); \/\/ Extract country-specific column values\n\n\t\t\t\/\/ Step 4: Assign values based on row order in the CSV\n\t\t\tconst variables = {\n\t\t\t\td1: values[0] || null,\n\t\t\t\td2: values[1] || null,\n\t\t\t\tq1: values[2] || null,\n\t\t\t\td3: values[3] || null,\n\t\t\t\td4: values[4] || null,\n\t\t\t\td5: values[5] || null,\n\t\t\t\td6: values[6] || null,\n\t\t\t\td7: values[7] || null,\n\t\t\t\tq3: values[8] || null,\n\t\t\t\td8: values[9] || null,\n\t\t\t\td9: values[10] || null\n\t\t\t};\n\t\t\t*\/\n\t\t\t\/\/ Customize and assign the variables using the \"customizeNumber\" function\n\t\t\tfor (const [key, value] of Object.entries(variables)) {\n\t\t\t\twindow[key] = customizeNumber(value, uc, round_at, periodicity, separator);\n\t\t\t}\n\n\t\t\t\/\/ Debugging output\n\t\t\tconsole.log(\"Customized data:\", variables);\n\t\t\t\n\t\t\tjQuery('.d1').html(d1);\n\t\t\tjQuery('.d2').html(d2);\n\t\t\tjQuery('.d3').html(d3);\n\t\t\tjQuery('.d4').html(d4);\n\t\t\tjQuery('.d5').html(d5);\n\t\t\tjQuery('.d6').html(d6);\n\t\t\tjQuery('.d7').html(d7);\n\t\t\tjQuery('.d8').html(d8);\n\t\t\tjQuery('.d9').html(d9);\n\t\t\tjQuery('.q1').html(q1);\n\t\t\tjQuery('.q3').html(q3);\t\n\t\t\tjQuery('#periodicity_text').html(periodicity_text);\t\n\t\t\tjQuery('#income_type').html(income_type);\t\n\t\t\tjQuery('#income_type_long').html(income_type_long);\t\n\t\t\tjQuery('.periodicity_text').html(periodicity_text);\t\n\t\t\tjQuery('.income_type').html(income_type);\t\n\t\t\tjQuery('.income_type_long').html(income_type_long);\t\n\t\t\tjQuery('.unit_after').html(unit_after);\t\n\t\t\tjQuery('.unit_before').html(unit_before);\t\t\n\t\t},\n\t\terror: function(){ alert('Data could not be loaded');}\n\t});\n\n\n});","QuestionText":"Quel est le revenu <u><strong><span class=\"periodicity_text\">[periodicity_text: mensuel]<\/span> <span class=\"income_type\">[income_type: brut]<\/span><\/strong><\/u> de votre <u><strong>m&eacute;nage<\/strong><\/u> <span class=\"income_type_long\">[income_type_long: apr&egrave;s imp&ocirc;ts et prestations sociales]<\/span>&nbsp;?<br \/>\nSont inclus ici&nbsp;tous les revenus&nbsp;: salaires, pensions, allocations, revenus fonciers, etc.","QuestionText_Unsafe":"<div>What is the <b><em><span id=\"periodicity_text\">[periodicity_text: monthly]<\/span><\/em> <span id=\"income_type\">[income_type: gross]<\/span> income of your household<\/b>, <span id=\"income_type_long\">[income_type_long: after taxes and transfers]<\/span>?<\/div>\n\n<div>This includes all sources of income: wages, pensions, welfare payments, property income, dividends, self-employment earnings, Social Security benefits, and income from other sources.<\/div>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID39","SecondaryAttribute":"Quel est votre plus haut niveau de dipl\u00f4me ?","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["9",1,2,4,3,5,6,7],"Choices":{"1":{"Display":"<span id=\"educ_2\">2 Medium school<\/span>"},"2":{"Display":"<span id=\"educ_3\">2 Some high school<\/span>"},"3":{"Display":"<span id=\"educ_4\">3 High school diploma<\/span>"},"4":{"Display":"<span id=\"educ_5\">3-4 Vocational training<\/span>"},"5":{"Display":"<span id=\"educ_6\">5 Short-cycle tertiary<\/span>"},"6":{"Display":"<span id=\"educ_7\">6 Bachelor's<\/span>"},"7":{"Display":"<span id=\"educ_8\">7-8 Master's or higher<\/span>"},"9":{"Display":"<span id=\"educ_1\">0-1 Primary or less<\/span>"}},"Configuration":{"NumColumns":2,"QuestionDescriptionOption":"UseText"},"DataExportTag":"education","DataVisibility":{"Hidden":false,"Private":false},"Language":{"FR":{"QuestionText":"Quel est votre plus haut niveau de qualification ?"}},"NextAnswerId":1,"NextChoiceId":12,"QuestionDescription":"Quel est votre plus haut niveau de dipl\u00f4me ?","QuestionID":"QID39","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/\/ Loads CSV and create variables from the column corresponding to Q_Language\n\t$j(document).ready(function($j){\t\n\t\t$j.ajax({\n\t\t\turl:\"https:\/\/wumarketing.eu.qualtrics.com\/ControlPanel\/File.php?F=F_yuKEs6pwxsAid44\",\n\t\t\tsuccess: function(csv){\n\t\t\t\t\n\t\t\tconst language = Qualtrics.SurveyEngine.getEmbeddedData(\"Q_Language\");\n\t\t\t\t\n\t\t\tconst rows = csv.split('\\n').map(row => row.split('|'));\n\t\t\tconst headers = rows[0];\n\t\t\tconst col = headers.indexOf(language);\n\n\t\t\tif (col === -1) {\n\t\t\t\tconsole.error(\"Column 'language' not found in the CSV file.\");\n\t\t\t\treturn;\n\t\t\t}\n\n\t\t\t\/\/ Iterate through the rows and create variables dynamically\n\t\t\tfor (let i = 1; i < rows.length-1; i++) {\n\t\t\t\tconst name = rows[i][0]; \/\/ Assuming the row name is in the first column\n\t\t\t\tconst value = rows[i][col];\n\t\t\t\twindow[name] = value; \n\t\t\t\t$j(\"#\" + name).html(value);\n\t\t\t\tconsole.log(`Variable ${name} created with value: ${value}`);\n\t\t\t}\n\n\t\t\t\t},\n\t\t\terror: function(){ alert('Data could not be loaded');}\n\t\t});\n\t});\n});","QuestionText":"Quel est votre plus haut niveau de dipl\u00f4me ?","QuestionText_Unsafe":"What is your highest completed education level?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_abLGdxn76dMdkCq","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"Control","TertiaryAttribute":null,"Payload":{"QuestionText":"Con