t 130 000$"},"16":{"Display":"entre 145 001$ et 165 000$"},"20":{"Display":"entre 42 001$ et 50 000$"},"21":{"Display":"entre 130 001$ et 145 000$"}}},"PL":{"QuestionText":"<div>Jaki jest <em>roczny<\/em> doch\u00f3d brutto Twojego gospodarstwa domowego (przed opodatkowaniem)?<\/div><div> Obejmuje to wszystkie dochody: pensje, zarobki z tytu\u0142u samozatrudnienia, \u015bwiadczenia z Ubezpiecze\u0144 Spo\u0142ecznych, emerytury, dochody z inwestycji, \u015bwiadczenia socjalne i dochody z innych \u017ar\u00f3de\u0142.<\/div>","Choices":{"5":{"Display":"nieca\u0142e 20 000 dolar\u00f3w"},"6":{"Display":"od 20 001 do 35 000 dolar\u00f3w"},"8":{"Display":"od 165 001 do 250 000 dolar\u00f3w"},"9":{"Display":"ponad 250 000 dolar\u00f3w"},"11":{"Display":"od 35 001 do 42 000 dolar\u00f3w"},"12":{"Display":"od 50 001 do 65 000 dolar\u00f3w"},"13":{"Display":"od 65 001 do 82 000 dolar\u00f3w"},"14":{"Display":"od 82 001 do 103 000 dolar\u00f3w"},"15":{"Display":"od 103 001 do 130 000 dolar\u00f3w"},"16":{"Display":"od 145 001 do 165 000 dolar\u00f3w"},"20":{"Display":"od 42 001 do 50 000 dolar\u00f3w"},"21":{"Display":"od 130 001 do 145 000 dolar\u00f3w"}}},"RU":{"QuestionText":"<div>\u041a\u0430\u043a\u043e\u0432 <em>\u0433\u043e\u0434\u043e\u0432\u043e\u0439<\/em> \u0432\u0430\u043b\u043e\u0432\u043e\u0439 \u0434\u043e\u0445\u043e\u0434 \u0432\u0430\u0448\u0435\u0439 \u0441\u0435\u043c\u044c\u0438 (\u0434\u043e \u0432\u044b\u0447\u0435\u0442\u0430 \u043d\u0430\u043b\u043e\u0433\u043e\u0432)?<\/div><div> \u0421\u044e\u0434\u0430 \u0432\u0445\u043e\u0434\u044f\u0442 \u0432\u0441\u0435 \u0434\u043e\u0445\u043e\u0434\u044b: \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u043d\u0430\u044f \u043f\u043b\u0430\u0442\u0430, \u0434\u043e\u0445\u043e\u0434\u044b \u043e\u0442 \u0441\u0430\u043c\u043e\u0437\u0430\u043d\u044f\u0442\u043e\u0441\u0442\u0438, \u043f\u043e\u0441\u043e\u0431\u0438\u044f \u043f\u043e \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u044e, \u043f\u0435\u043d\u0441\u0438\u0438, \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0434\u043e\u0445\u043e\u0434, \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0432\u044b\u043f\u043b\u0430\u0442\u044b \u0438 \u0434\u043e\u0445\u043e\u0434\u044b \u0438\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u0432.<\/div>","Choices":{"5":{"Display":"\u043c\u0435\u043d\u0435\u0435 20 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"},"6":{"Display":"\u043e\u0442 20 001 \u0434\u043e 35 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410"},"8":{"Display":"\u043e\u0442 165 001 \u0434\u043e 250 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410"},"9":{"Display":"\u0431\u043e\u043b\u0435\u0435 250 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432"},"11":{"Display":"\u043e\u0442 35 001 \u0434\u043e 42 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410"},"12":{"Display":"\u043e\u0442 50 001 \u0434\u043e 65 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410"},"13":{"Display":"\u043e\u0442 65 001 \u0434\u043e 82 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410"},"14":{"Display":"\u043e\u0442 82 001 \u0434\u043e 103 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410"},"15":{"Display":"\u043e\u0442 103 001 \u0434\u043e 130 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410"},"16":{"Display":"\u043e\u0442 145 001 \u0434\u043e 165 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410"},"20":{"Display":"\u043e\u0442 42 001 \u0434\u043e 50 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410"},"21":{"Display":"\u043e\u0442 130 001 \u0434\u043e 145 000 \u0434\u043e\u043b\u043b\u0430\u0440\u043e\u0432 \u0421\u0428\u0410"}}},"IT-CH":[],"JA":[]},